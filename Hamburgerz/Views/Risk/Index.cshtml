@{
    ViewData["Title"] = "Perdegimo rizikos rezultatas";
}

<style>
body{
    font-family: Arial, sans-serif;
    background:#f4f6f8;
    margin:0;
    padding-bottom:40px;
}

.container-custom{
    max-width:900px;
    margin:auto;
    background:white;
    padding:40px;
    border-radius:16px;
    box-shadow:0 10px 25px rgba(0,0,0,0.08);
}

h1{
    margin-top:0;
}

.subtitle{
    color:#666;
    margin-bottom:30px;
}

.box{
    border:2px solid #e5e5e5;
    border-radius:12px;
    padding:25px;
    background:#fafafa;
    margin-bottom:25px;
}

.field{
    margin-top:15px;
}

.label{
    font-weight:bold;
    margin-bottom:6px;
}

.placeholder{
    height:45px;
    border:2px dashed #cfcfcf;
    border-radius:10px;
    background:white;
}

.placeholder-large{
    height:140px;
    border:2px dashed #cfcfcf;
    border-radius:10px;
    background:white;
}

.section{
    margin-top:30px;
}
</style>

<div class="container-custom">

    <h1>Perdegimo rizikos rezultatas</h1>
    <p class="subtitle">
        Lango struktūra su vieta būsimam turiniui: rezultatams, infografikui, išvadoms ir rekomendacijoms.
    </p>

    <div class="box">

        <div class="field">
            <div class="label">Rizikos lygis</div>
            <div class="placeholder"></div>
        </div>

        <div class="field">
            <div class="label">Rizikos balas</div>
            <div class="placeholder"></div>
        </div>

        <div class="field">
            <div class="label">Būsena / išvada</div>
            <div class="placeholder"></div>
        </div>

        <div class="field">
            <div class="label">Infografikas / vizualizacija</div>
            <div class="placeholder-large"></div>
        </div>

    </div>

    <div class="section">
        <h2>Rekomendacijos</h2>
        <div class="placeholder-large"></div>
    </div>

    <div class="section">
        <h2>Galimi požymiai</h2>
        <div class="placeholder-large"></div>
    </div>

</div>