@model Hamburgerz.Models.RiskMeasurement

@{
    ViewData["Title"] = "Perdegimo rizikos rezultatas";
}

<style>
    .risk-result-wrapper {
        max-width: 900px;
        margin: 0 auto;
    }

    body {
        font-family: Arial, sans-serif;
        background: #f4f6f8;
        margin: 0;
        padding-bottom: 40px;
    }

    .risk-result-card {
        padding: 2.5rem;
    }

    .risk-result-subtitle {
        color: var(--color-text-muted);
        margin-bottom: 2rem;
    }

    .risk-section {
        margin-top: 2rem;
    }

    .risk-block {
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .risk-field + .risk-field {
        margin-top: 1rem;
    }

    .risk-label {
        font-weight: 600;
        color: var(--color-text);
        margin-bottom: 0.4rem;
    }

    .risk-value-box {
        min-height: 45px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface);
        display: flex;
        align-items: center;
        padding: 0 14px;
        font-weight: 600;
        color: #111827;
    }

    .risk-placeholder-large {
        min-height: 140px;
        border: 2px dashed var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface);
    }

    .risk-section-title {
        margin-bottom: 1rem;
    }

    .risk-meta {
        margin-top: 1rem;
        color: #6b7280;
        font-size: 14px;
    }

    @@media (max-width: 768px) {
        .risk-result-card {
            padding: 1.5rem;
        }
    }
</style>

<div class="container py-4 py-md-5">
    <div class="risk-result-wrapper">
        <div class="app-surface risk-result-card">

            <h1 class="page-title mb-3">Perdegimo rizikos rezultatas</h1>
            <p class="risk-result-subtitle">
                Lango struktūra su vieta būsimam turiniui: rezultatams, infografikui, išvadoms ir rekomendacijoms.
            </p>

            <div class="risk-block">
                <div class="risk-field">
                    <div class="risk-label">Rizikos lygis</div>
                    <div class="risk-value-box">@Model.RiskText</div>
                </div>

                <div class="risk-field">
                    <div class="risk-label">Rizikos balas</div>
                    <div class="risk-value-box">@Model.BurnoutPercent%</div>
                </div>

                <div class="risk-field">
                    <div class="risk-label">Būsena / išvada</div>
                    <div class="risk-value-box">@Model.QuickSummary</div>
                </div>

                <div class="risk-field">
                    <div class="risk-label">Infografikas / vizualizacija</div>
                    <div class="risk-placeholder-large"></div>
                </div>

                <div class="risk-meta">
                    Measurement ID: @Model.ID |
                    Date: @Model.TimeStamp.ToString("yyyy-MM-dd HH:mm") |
                    Job Role: @Model.JobRole
                </div>
            </div>

            <div class="risk-section">
                <h2 class="risk-section-title">Rekomendacijos</h2>
                <div class="risk-placeholder-large">hello naxuui</div>
            </div>

            <div class="risk-section">
                <h2 class="risk-section-title">Galimi požymiai</h2>
                <div class="risk-placeholder-large"></div>
            </div>

        </div>
    </div>
</div>