@model Hamburgerz.Models.RegisterViewModel
@{
    ViewData["Title"] = "Registracija";
    var minPasswordLength = Hamburgerz.Models.PasswordRules.MinLength;
    var hasCountries = Model.Countries.Count > 0;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="app-surface p-4 p-md-5">
                <h1 class="page-title h2 mb-4">Registracijos forma</h1>

                <form asp-action="Index" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Elektroninis pastas</label>
                        <input asp-for="Email" class="form-control" placeholder="Elektroninis pastas" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Slapyvardis</label>
                        <input asp-for="Username" class="form-control" placeholder="Slapyvardis" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Slaptazodis</label>
                        <div class="password-field">
                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="Slaptazodis"
                                   autocomplete="new-password" />
                            <button type="button"
                                    class="password-toggle"
                                    data-password-toggle="Password"
                                    aria-label="Rodyti slaptazodi"
                                    aria-pressed="false">
                                <span class="password-toggle-icon" aria-hidden="true">
                                    <svg class="password-toggle-svg password-toggle-svg-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M2.5 12s3.6-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.6 6.5-9.5 6.5S2.5 12 2.5 12Z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                    <svg class="password-toggle-svg password-toggle-svg-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 3l18 18" />
                                        <path d="M10.58 10.58A2 2 0 0 0 12 14a2 2 0 0 0 1.42-.58" />
                                        <path d="M6.71 6.72C4.47 8.23 3 10.68 2.5 12c.83 2.2 4.1 6.5 9.5 6.5 2.24 0 4.18-.74 5.76-1.76" />
                                        <path d="M9.88 4.68A10.7 10.7 0 0 1 12 4.5c5.9 0 9.5 6.5 9.5 6.5a15.3 15.3 0 0 1-2.17 3.19" />
                                    </svg>
                                </span>
                                <span class="visually-hidden password-toggle-label">Rodyti</span>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <div class="password-inline-feedback" data-password-summary aria-live="polite"></div>

                        <div class="password-guidance" data-password-guidance aria-live="polite">
                            <div class="password-strength">
                                <div class="password-strength-bar">
                                    <div class="password-strength-fill" data-password-strength-fill></div>
                                </div>
                                <div class="password-strength-text" data-password-strength-text>
                                    Slaptazodzio stiprumas pasimatys rasant.
                                </div>
                            </div>

                            <div class="password-rule-list">
                                <div class="password-rule" data-password-rule="length">Bent @minPasswordLength simboliai</div>
                                <div class="password-rule" data-password-rule="letters">Bent viena mazoji ir viena didzioji raide</div>
                                <div class="password-rule" data-password-rule="digit">Bent vienas skaicius</div>
                                <div class="password-rule" data-password-rule="symbol">Bent vienas specialus simbolis</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PasswordRepeat" class="form-label">Pakartoti slaptazodi</label>
                        <div class="password-field">
                            <input asp-for="PasswordRepeat"
                                   class="form-control"
                                   placeholder="Pakartoti slaptazodi"
                                   autocomplete="new-password" />
                            <button type="button"
                                    class="password-toggle"
                                    data-password-toggle="PasswordRepeat"
                                    aria-label="Rodyti slaptazodi"
                                    aria-pressed="false">
                                <span class="password-toggle-icon" aria-hidden="true">
                                    <svg class="password-toggle-svg password-toggle-svg-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M2.5 12s3.6-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.6 6.5-9.5 6.5S2.5 12 2.5 12Z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                    <svg class="password-toggle-svg password-toggle-svg-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 3l18 18" />
                                        <path d="M10.58 10.58A2 2 0 0 0 12 14a2 2 0 0 0 1.42-.58" />
                                        <path d="M6.71 6.72C4.47 8.23 3 10.68 2.5 12c.83 2.2 4.1 6.5 9.5 6.5 2.24 0 4.18-.74 5.76-1.76" />
                                        <path d="M9.88 4.68A10.7 10.7 0 0 1 12 4.5c5.9 0 9.5 6.5 9.5 6.5a15.3 15.3 0 0 1-2.17 3.19" />
                                    </svg>
                                </span>
                                <span class="visually-hidden password-toggle-label">Rodyti</span>
                            </button>
                        </div>
                        <span asp-validation-for="PasswordRepeat" class="text-danger"></span>
                        <div class="password-inline-feedback" data-repeat-summary aria-live="polite"></div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Gender" class="form-label">Lytis</label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">Pasirinkite lyti</option>
                            <option value="male">Vyras</option>
                            <option value="female">Moteris</option>
                            <option value="other">Kita</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CountryID" class="form-label">Salis</label>
                        <div class="country-picker">
                            <input type="text"
                                   class="form-control country-search"
                                   data-country-search
                                   placeholder="Ieskoti salies"
                                   autocomplete="off"
                                   aria-expanded="true" />
                            <select asp-for="CountryID"
                                    asp-items="Model.Countries"
                                    class="form-select country-select"
                                    data-country-select
                                    size="8">
                            </select>
                        </div>
                        <span asp-validation-for="CountryID" class="text-danger"></span>

                        @if (!hasCountries)
                        {
                            <div class="country-empty-note">
                                Saliu sarasas tuscias. Reikes uzpildyti countries lentele, kad sis laukas veiktu pilnai.
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-3">
                        <button type="submit" class="btn btn-secondary btn-lg">
                            Registruotis
                        </button>

                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-lg">
                            Atgal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .password-guidance {
        margin-top: 0;
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transform: translateY(-6px);
        padding: 0 16px;
        border-radius: 16px;
        border: 1px solid rgba(var(--color-secondary-rgb), 0.22);
        background: linear-gradient(135deg, rgba(var(--color-primary-rgb), 0.12), rgba(var(--color-secondary-rgb), 0.05));
        transition: max-height 0.22s ease, opacity 0.18s ease, transform 0.18s ease, padding 0.18s ease, margin-top 0.18s ease;
        pointer-events: none;
    }

    .password-guidance.is-visible {
        margin-top: 12px;
        max-height: 320px;
        opacity: 1;
        transform: translateY(0);
        padding: 14px 16px;
        pointer-events: auto;
    }

    .password-strength {
        display: grid;
        gap: 8px;
        margin-bottom: 12px;
    }

    .password-strength-bar {
        height: 8px;
        border-radius: 999px;
        overflow: hidden;
        background: rgba(var(--color-secondary-rgb), 0.15);
    }

    .password-strength-fill {
        height: 100%;
        width: 0;
        border-radius: inherit;
        background: #dc3545;
        transition: width 0.18s ease, background 0.18s ease;
    }

    .password-strength-text {
        font-size: 12px;
        font-weight: 700;
        color: var(--color-text-muted);
    }

    .password-rule-list {
        display: grid;
        gap: 7px;
    }

    .password-rule {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--color-text-muted);
        font-size: 13px;
        font-weight: 600;
    }

    .password-rule::before {
        content: "";
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 1px solid var(--color-border);
        background: transparent;
        flex-shrink: 0;
        transition: background 0.15s ease, transform 0.15s ease, border-color 0.15s ease, color 0.15s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 900;
        color: transparent;
    }

    .password-rule.is-met {
        color: var(--color-text);
    }

    .password-rule.is-met::before {
        content: "\2713";
        background: var(--color-button-secondary-bg);
        border-color: var(--color-button-secondary-bg);
        color: var(--color-button-secondary-text);
        transform: scale(1.05);
    }

    .password-inline-feedback {
        min-height: 18px;
        margin-top: 6px;
        color: #b45309;
        font-size: 12px;
        font-weight: 700;
    }

    .password-inline-feedback.is-valid {
        color: #15803d;
    }

    .password-field {
        position: relative;
    }

    .password-field .form-control {
        padding-right: 3.25rem;
    }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 0.45rem;
        transform: translateY(-50%);
        width: 2.4rem;
        height: 2.4rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: var(--color-text-muted);
        transition: transform 0.18s ease, color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

    .password-toggle:hover {
        background: rgba(var(--color-secondary-rgb), 0.08);
        color: var(--color-text);
    }

    .password-toggle:active {
        background: rgba(var(--color-secondary-rgb), 0.12);
        transform: translateY(-50%) scale(0.92);
    }

    .password-toggle:focus-visible {
        background: rgba(var(--color-secondary-rgb), 0.08);
        box-shadow: 0 0 0 0.2rem rgba(var(--color-secondary-rgb), 0.18);
    }

    .password-toggle-icon {
        position: relative;
        width: 1.15rem;
        height: 1.15rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .password-toggle-svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transition: opacity 0.22s ease, transform 0.22s ease;
    }

    .password-toggle-svg-open {
        opacity: 1;
        transform: scale(1);
    }

    .password-toggle-svg-closed {
        opacity: 0;
        transform: scale(0.8);
    }

    .password-toggle.is-active {
        color: var(--color-primary);
    }

    .password-toggle.is-active .password-toggle-svg-open {
        opacity: 0;
        transform: scale(0.82);
    }

    .password-toggle.is-active .password-toggle-svg-closed {
        opacity: 1;
        transform: scale(1);
    }

    .password-toggle.is-animating .password-toggle-icon {
        animation: password-toggle-wobble 0.34s ease;
    }

    @@keyframes password-toggle-wobble {
        0% { transform: scale(1) rotate(0deg); }
        40% { transform: scale(0.86) rotate(-10deg); }
        100% { transform: scale(1) rotate(0deg); }
    }

    .country-picker {
        display: grid;
        gap: 10px;
    }

    .country-search {
        border-radius: 14px;
    }

    .country-select.is-collapsed {
        display: none;
    }

    .country-empty-note {
        margin-top: 8px;
        color: #b45309;
        font-size: 12px;
        font-weight: 700;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const passwordInput = document.getElementById("Password");
            const repeatInput = document.getElementById("PasswordRepeat");
            const guidance = document.querySelector("[data-password-guidance]");
            const passwordSummary = document.querySelector("[data-password-summary]");
            const repeatSummary = document.querySelector("[data-repeat-summary]");
            const strengthFill = document.querySelector("[data-password-strength-fill]");
            const strengthText = document.querySelector("[data-password-strength-text]");
            const toggleButtons = document.querySelectorAll("[data-password-toggle]");
            const countrySearch = document.querySelector("[data-country-search]");
            const countrySelect = document.getElementById("CountryID");
            let suppressGuidanceChanges = false;
            let guidanceWasVisibleBeforeToggle = false;

            if (countrySearch && countrySelect) {
                const countryPicker = countrySelect.closest(".country-picker");
                const originalCountryOptions = Array.from(countrySelect.options).map(function (option) {
                    return {
                        value: option.value,
                        text: option.textContent || ""
                    };
                });

                const getCountryText = function (value) {
                    const option = originalCountryOptions.find(function (countryOption) {
                        return countryOption.value === value;
                    });

                    return option ? option.text : "";
                };

                const setCountryListOpen = function (isOpen) {
                    countrySelect.classList.toggle("is-collapsed", !isOpen);
                    countrySearch.setAttribute("aria-expanded", isOpen ? "true" : "false");
                };

                const renderCountryOptions = function (query, selectedValue) {
                    const normalizedQuery = (query || "").trim().toLowerCase();
                    const matchingOptions = originalCountryOptions.filter(function (option) {
                        const matchesQuery = option.text.toLowerCase().includes(normalizedQuery);
                        return normalizedQuery.length === 0 || matchesQuery;
                    });

                    countrySelect.innerHTML = "";

                    matchingOptions.forEach(function (optionData) {
                        const option = document.createElement("option");
                        option.value = optionData.value;
                        option.textContent = optionData.text;
                        option.selected = optionData.value === selectedValue;
                        countrySelect.appendChild(option);
                    });

                    if (selectedValue) {
                        countrySelect.value = selectedValue;
                    } else {
                        countrySelect.selectedIndex = -1;
                    }
                };

                countrySearch.addEventListener("input", function () {
                    const normalizedQuery = countrySearch.value.trim().toLowerCase();
                    const exactMatch = originalCountryOptions.find(function (option) {
                        return option.value !== "" && option.text.toLowerCase() === normalizedQuery;
                    });

                    renderCountryOptions(countrySearch.value, exactMatch ? exactMatch.value : "");
                    setCountryListOpen(true);
                });

                countrySearch.addEventListener("focus", function () {
                    renderCountryOptions(countrySearch.value, countrySelect.value);
                    setCountryListOpen(true);
                });

                countrySearch.addEventListener("keydown", function (event) {
                    if (event.key === "ArrowDown") {
                        event.preventDefault();
                        setCountryListOpen(true);
                        countrySelect.focus();
                    }

                    if (event.key === "Escape" && countrySelect.value) {
                        event.preventDefault();
                        countrySearch.value = getCountryText(countrySelect.value);
                        renderCountryOptions(countrySearch.value, countrySelect.value);
                        setCountryListOpen(false);
                    }
                });

                countrySelect.addEventListener("change", function () {
                    const selectedText = getCountryText(countrySelect.value);
                    countrySearch.value = countrySelect.value ? selectedText : "";
                    renderCountryOptions(countrySearch.value, countrySelect.value);
                    setCountryListOpen(!countrySelect.value);
                });

                document.addEventListener("click", function (event) {
                    if (!countryPicker || countryPicker.contains(event.target)) {
                        return;
                    }

                    if (countrySelect.value) {
                        countrySearch.value = getCountryText(countrySelect.value);
                        renderCountryOptions(countrySearch.value, countrySelect.value);
                        setCountryListOpen(false);
                    }
                });

                if (countrySelect.value) {
                    countrySearch.value = getCountryText(countrySelect.value);
                    renderCountryOptions(countrySearch.value, countrySelect.value);
                    setCountryListOpen(false);
                } else {
                    renderCountryOptions("", "");
                    setCountryListOpen(true);
                }
            }

            if (!passwordInput || !repeatInput) {
                return;
            }

            const ruleElements = {
                length: document.querySelector('[data-password-rule="length"]'),
                letters: document.querySelector('[data-password-rule="letters"]'),
                digit: document.querySelector('[data-password-rule="digit"]'),
                symbol: document.querySelector('[data-password-rule="symbol"]')
            };

            const updateRule = function (element, isMet) {
                if (!element) {
                    return;
                }

                element.classList.toggle("is-met", isMet);
            };

            const getPasswordState = function () {
                const password = passwordInput.value || "";
                const repeat = repeatInput.value || "";

                return {
                    password,
                    repeat,
                    hasMinLength: password.length >= @minPasswordLength,
                    hasLowercase: /[a-z]/.test(password),
                    hasUppercase: /[A-Z]/.test(password),
                    hasDigit: /\d/.test(password),
                    hasSymbol: /[^A-Za-z0-9]/.test(password)
                };
            };

            const getStrengthDetails = function (state) {
                if (state.password.length === 0) {
                    return {
                        width: "0%",
                        color: "#dc3545",
                        label: "Slaptazodzio stiprumas pasimatys rasant."
                    };
                }

                const score = [
                    state.hasMinLength,
                    state.hasLowercase,
                    state.hasUppercase,
                    state.hasDigit,
                    state.hasSymbol
                ].filter(Boolean).length;

                const strengthMap = {
                    1: { color: "#dc3545", label: "Labai silpnas slaptazodis" },
                    2: { color: "#f59e0b", label: "Silpnas slaptazodis" },
                    3: { color: "#0ea5e9", label: "Vidutinis slaptazodis" },
                    4: { color: "#2563eb", label: "Stiprus slaptazodis" },
                    5: { color: "#15803d", label: "Labai stiprus slaptazodis" }
                };

                const details = strengthMap[score] || strengthMap[1];
                return {
                    width: ((score / 5) * 100) + "%",
                    color: details.color,
                    label: details.label
                };
            };

            const updatePasswordRules = function () {
                const state = getPasswordState();

                updateRule(ruleElements.length, state.hasMinLength);
                updateRule(ruleElements.letters, state.hasLowercase && state.hasUppercase);
                updateRule(ruleElements.digit, state.hasDigit);
                updateRule(ruleElements.symbol, state.hasSymbol);
            };

            const updateStrength = function () {
                if (!strengthFill || !strengthText) {
                    return;
                }

                const details = getStrengthDetails(getPasswordState());
                strengthFill.style.width = details.width;
                strengthFill.style.background = details.color;
                strengthText.textContent = details.label;
            };

            const showGuidance = function () {
                if (suppressGuidanceChanges) {
                    return;
                }

                if (guidance) {
                    guidance.classList.add("is-visible");
                }

                if (passwordSummary) {
                    passwordSummary.textContent = "";
                }
            };

            const hideGuidanceIfNeeded = function () {
                if (suppressGuidanceChanges) {
                    return;
                }

                window.setTimeout(function () {
                    const activeElement = document.activeElement;
                    const stillEditing = activeElement === passwordInput || activeElement === repeatInput;

                    if (stillEditing) {
                        return;
                    }

                    if (guidance) {
                        guidance.classList.remove("is-visible");
                    }

                    const state = getPasswordState();
                    const passwordIsValid =
                        state.password.length === 0
                            || (state.hasMinLength && state.hasLowercase && state.hasUppercase && state.hasDigit && state.hasSymbol);

                    if (passwordSummary) {
                        passwordSummary.textContent =
                            !passwordIsValid && state.password.length > 0
                                ? "Neispildyti slaptazodzio reikalavimai."
                                : "";
                    }

                    if (repeatSummary) {
                        repeatSummary.textContent =
                            state.repeat.length > 0 && state.password !== state.repeat
                                ? "Slaptazodziai nesutampa."
                                : "";
                    }
                }, 0);
            };

            const updateRepeatSummary = function () {
                const state = getPasswordState();

                if (repeatSummary) {
                    const passwordsMatch = state.repeat.length > 0 && state.password === state.repeat;
                    const passwordsDiffer = state.repeat.length > 0 && state.password !== state.repeat;

                    repeatSummary.textContent = passwordsMatch
                        ? "Slaptazodziai sutampa."
                        : passwordsDiffer
                            ? "Slaptazodziai nesutampa."
                            : "";

                    repeatSummary.classList.toggle("is-valid", passwordsMatch);
                }
            };

            toggleButtons.forEach(function (button) {
                const prepareToggleInteraction = function () {
                    suppressGuidanceChanges = true;
                    guidanceWasVisibleBeforeToggle = guidance ? guidance.classList.contains("is-visible") : false;
                };

                button.addEventListener("pointerdown", function () {
                    prepareToggleInteraction();
                });

                button.addEventListener("mousedown", function (event) {
                    event.preventDefault();
                    prepareToggleInteraction();
                });

                button.addEventListener("click", function () {
                    const targetId = button.getAttribute("data-password-toggle");
                    const input = targetId ? document.getElementById(targetId) : null;
                    const label = button.querySelector(".password-toggle-label");

                    if (!input) {
                        return;
                    }

                    const isHidden = input.type === "password";
                    input.type = isHidden ? "text" : "password";
                    if (label) {
                        label.textContent = isHidden ? "Slepti" : "Rodyti";
                    }

                    button.classList.toggle("is-active", isHidden);
                    button.setAttribute("aria-pressed", isHidden ? "true" : "false");
                    button.setAttribute("aria-label", isHidden ? "Slepti slaptazodi" : "Rodyti slaptazodi");
                    button.classList.remove("is-animating");
                    void button.offsetWidth;
                    button.classList.add("is-animating");

                    if (guidance) {
                        guidance.classList.toggle("is-visible", guidanceWasVisibleBeforeToggle);
                    }

                    window.setTimeout(function () {
                        suppressGuidanceChanges = false;
                    }, 0);
                });

                button.addEventListener("blur", function () {
                    window.setTimeout(function () {
                        suppressGuidanceChanges = false;
                    }, 0);
                });
            });

            passwordInput.addEventListener("focus", showGuidance);
            repeatInput.addEventListener("focus", showGuidance);
            passwordInput.addEventListener("blur", hideGuidanceIfNeeded);
            repeatInput.addEventListener("blur", hideGuidanceIfNeeded);

            passwordInput.addEventListener("input", function () {
                showGuidance();
                updatePasswordRules();
                updateStrength();
                updateRepeatSummary();
            });

            repeatInput.addEventListener("input", function () {
                showGuidance();
                updateRepeatSummary();
            });

            if (passwordInput.value.length > 0 || repeatInput.value.length > 0) {
                showGuidance();
            }

            updatePasswordRules();
            updateStrength();
            updateRepeatSummary();
        });
    </script>
}
