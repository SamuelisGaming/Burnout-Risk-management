    .password-rule::before {
        content: "";
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 1px solid var(--color-border);
        background: transparent;
        flex-shrink: 0;
        transition: background 0.15s ease, transform 0.15s ease, border-color 0.15s ease, color 0.15s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 900;
        color: transparent;
    }

    .password-rule.is-met {
        color: var(--color-text);
    }

    .password-rule.is-met::before {
        content: "\2713";
        background: var(--color-button-secondary-bg);
        border-color: var(--color-button-secondary-bg);
        color: var(--color-button-secondary-text);
        transform: scale(1.05);
    }

    .password-rule-note {
        color: var(--color-text-muted);
        font-style: italic;
    }

    .password-rule-note::before {
        display: none;
    }

    .password-inline-feedback {
        min-height: 18px;
        margin-top: 6px;
        color: #b45309;
        font-size: 12px;
        font-weight: 700;
    }

    .password-inline-feedback.is-valid {
        color: #15803d;
    }

    .password-field {
        position: relative;
    }

    .password-field .form-control {
        padding-right: 3.25rem;
    }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 0.45rem;
        transform: translateY(-50%);
        width: 2.4rem;
        height: 2.4rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: var(--color-text-muted);
        transition: transform 0.18s ease, color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

    .password-toggle:hover {
        background: rgba(var(--color-secondary-rgb), 0.08);
        color: var(--color-text);
    }

    .password-toggle:active {
        background: rgba(var(--color-secondary-rgb), 0.12);
        transform: translateY(-50%) scale(0.92);
    }

    .password-toggle:focus-visible {
        background: rgba(var(--color-secondary-rgb), 0.08);
        box-shadow: 0 0 0 0.2rem rgba(var(--color-secondary-rgb), 0.18);
    }

    .password-toggle-icon {
        position: relative;
        width: 1.15rem;
        height: 1.15rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .password-toggle-svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transition: opacity 0.22s ease, transform 0.22s ease;
    }

    .password-toggle-svg-open {
        opacity: 1;
        transform: scale(1);
    }

    .password-toggle-svg-closed {
        opacity: 0;
        transform: scale(0.8);
    }

    .password-toggle.is-active {
        color: var(--color-primary);
    }

    .password-toggle.is-active .password-toggle-svg-open {
        opacity: 0;
        transform: scale(0.82);
    }

    .password-toggle.is-active .password-toggle-svg-closed {
        opacity: 1;
        transform: scale(1);
    }

    .password-toggle.is-animating .password-toggle-icon {
        animation: password-toggle-wobble 0.34s ease;
    }

    @@keyframes password-toggle-wobble {
        0% { transform: scale(1) rotate(0deg); }
        40% { transform: scale(0.86) rotate(-10deg); }
        100% { transform: scale(1) rotate(0deg); }
    }

    .country-picker {
        display: grid;
        gap: 10px;
    }

    .country-search {
        border-radius: 18px;
    }

    .country-select {
        min-height: 220px;
        padding: 10px;
    }

    .country-select.is-collapsed {
        display: none;
    }

    .country-empty-note {
        margin-top: 8px;
        color: var(--color-warning);
        font-size: 12px;
        font-weight: 700;
    }

    .register-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 24px;
        padding-top: 22px;
        border-top: 1px solid rgba(var(--color-secondary-rgb), 0.12);
    }

    .register-actions .btn {
        min-width: 150px;
        border-radius: 16px;
        font-weight: 800;
    }

    [data-theme="dark"] .register-card {
        background:
            radial-gradient(circle at top right, rgba(var(--color-secondary-rgb), 0.12), transparent 24%),
            linear-gradient(180deg, rgba(var(--color-surface-rgb), 0.98) 0%, rgba(var(--color-surface-2-rgb), 0.94) 100%);
    }

    [data-theme="dark"] .register-back-link {
        background: rgba(var(--color-surface-rgb), 0.78);
        border-color: rgba(var(--color-border-rgb), 0.88);
    }

    [data-theme="dark"] .register-step-panel {
        background: rgba(var(--color-surface-rgb), 0.86);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    }

    [data-theme="dark"] .register-field .form-control,
    [data-theme="dark"] .register-field .form-select {
        background: rgba(var(--color-surface-2-rgb), 0.94);
        border-color: rgba(var(--color-border-rgb), 0.92);
    }

    [data-theme="dark"] .choice-card {
        background:
            linear-gradient(180deg, rgba(var(--color-surface-rgb), 0.98), rgba(var(--color-surface-2-rgb), 0.94));
    }

    [data-theme="dark"] .choice-input:checked + .choice-card {
        background:
            radial-gradient(circle at top right, rgba(var(--color-secondary-rgb), 0.14), transparent 36%),
            linear-gradient(180deg, rgba(var(--color-surface-rgb), 0.98), rgba(var(--color-secondary-rgb), 0.10));
    }

    [data-theme="dark"] .password-guidance {
        background: linear-gradient(135deg, rgba(var(--color-primary-rgb), 0.18), rgba(var(--color-secondary-rgb), 0.08));
    }

    @@media (max-width: 1100px) {
        .register-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .register-shell {
            padding-top: 10px;
        }

        .register-story-panel,
        .register-card {
            border-radius: 24px;
        }

        .register-story-panel,
        .register-card-top,
        .register-wizard {
            padding-left: 18px;
            padding-right: 18px;
        }

        .register-card-top {
            padding-top: 22px;
        }

        .register-step-panel {
            padding: 18px;
        }

        .register-field-grid,
        .choice-grid-three {
            grid-template-columns: 1fr;
        }

        .register-card-top,
        .register-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .register-actions .btn,
        .register-back-link {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.querySelector("[data-register-wizard]");
            const passwordInput = document.getElementById("Password");
            const repeatInput = document.getElementById("PasswordRepeat");
            const guidance = document.querySelector("[data-password-guidance]");
            const passwordSummary = document.querySelector("[data-password-summary]");
            const repeatSummary = document.querySelector("[data-repeat-summary]");
            const strengthFill = document.querySelector("[data-password-strength-fill]");
            const strengthText = document.querySelector("[data-password-strength-text]");
            const toggleButtons = document.querySelectorAll("[data-password-toggle]");
            const countrySearch = document.querySelector("[data-country-search]");
            const countrySelect = document.getElementById("CountryID");
            const stepPanels = Array.from(document.querySelectorAll("[data-step-panel]"));
            const stepMarkers = Array.from(document.querySelectorAll("[data-step-marker]"));
            const nextButtons = Array.from(document.querySelectorAll("[data-step-next]"));
            const prevButtons = Array.from(document.querySelectorAll("[data-step-prev]"));
            const progressFill = document.querySelector("[data-progress-fill]");
            const stepCaption = document.querySelector("[data-step-caption]");
            const stepTitle = document.querySelector("[data-step-title]");
            let suppressGuidanceChanges = false;
            let guidanceWasVisibleBeforeToggle = false;
            let currentStep = 0;

            if (form) {
                form.classList.add("is-enhanced");
            }

            const updateStepMeta = function () {
                if (!stepCaption || !stepTitle || !progressFill || !stepPanels.length) {
                    return;
                }

                const currentPanel = stepPanels[currentStep];
                const stepName = currentPanel && currentPanel.dataset.stepName
                    ? currentPanel.dataset.stepName
                    : "Registracija";

                stepCaption.textContent = (currentStep + 1) + " / " + stepPanels.length + " · " + stepName;

                const titles = [
                    "Sukurk paskyrą",
                    "Papasakok apie save",
                    "Papasakok apie savo darbą"
                ];

                stepTitle.textContent = titles[currentStep] || "Registracija";
                progressFill.style.width = (((currentStep + 1) / stepPanels.length) * 100) + "%";
            };

            const goToStep = function (stepIndex) {
                if (!stepPanels.length) {
                    return;
                }

                currentStep = Math.max(0, Math.min(stepIndex, stepPanels.length - 1));

                stepPanels.forEach(function (panel, index) {
                    panel.classList.toggle("is-active", index === currentStep);
                });

                stepMarkers.forEach(function (marker, index) {
                    marker.classList.toggle("is-active", index === currentStep);
                });

                updateStepMeta();
            };

            const getPasswordState = function () {
                const password = passwordInput ? passwordInput.value || "" : "";
                const repeat = repeatInput ? repeatInput.value || "" : "";

                return {
                    password,
                    repeat,
                    hasMinLength: password.length >= @minPasswordLength,
                    hasLowercase: /[a-z]/.test(password),
                    hasUppercase: /[A-Z]/.test(password),
                    hasDigit: /\d/.test(password),
                    hasSymbol: /[^A-Za-z0-9]/.test(password)
                };
            };

            const getPasswordScore = function (state) {
                return [
                    state.hasMinLength,
                    state.hasLowercase,
                    state.hasUppercase,
                    state.hasDigit,
                    state.hasSymbol
                ].filter(Boolean).length;
            };

            const isPasswordStrongEnough = function (state) {
                return state.password.length > 0
                    && state.hasMinLength
                    && getPasswordScore(state) >= @minimumAcceptedScore;
            };

            const refreshPasswordCustomValidity = function () {
                if (!passwordInput || !repeatInput) {
                    return;
                }

                const state = getPasswordState();
                const passwordIsStrongEnough = isPasswordStrongEnough(state);
                let passwordError = "";

                if (state.password.length > 0 && !state.hasMinLength) {
                    passwordError = "Slaptazodis turi buti bent @minPasswordLength simboliu.";
                } else if (state.password.length > 0 && !passwordIsStrongEnough) {
                    passwordError = "Slaptazodis turi buti bent vidutinio stiprumo.";
                }

                passwordInput.setCustomValidity(passwordError);

                repeatInput.setCustomValidity(
                    state.repeat.length > 0 && state.password !== state.repeat
                        ? "Slaptazodziai nesutampa."
                        : ""
                );
            };

            const validateStep = function (stepIndex) {
                if (!stepPanels[stepIndex]) {
                    return true;
                }

                refreshPasswordCustomValidity();

                const fields = Array.from(stepPanels[stepIndex].querySelectorAll("input, select, textarea"));

                for (const field of fields) {
                    if (!(field instanceof HTMLElement)) {
                        continue;
                    }

                    if (field.hasAttribute("disabled") || field.getAttribute("type") === "hidden") {
                        continue;
                    }

                    if (typeof field.checkValidity === "function" && !field.checkValidity()) {
                        if (typeof field.reportValidity === "function") {
                            field.reportValidity();
                        }

                        return false;
                    }
                }

                return true;
            };

            const getFirstInvalidStepIndex = function () {
                for (let index = 0; index < stepPanels.length; index += 1) {
                    if (!validateStep(index)) {
                        return index;
                    }
                }

                return -1;
            };

            const getServerErrorStepIndex = function () {
                if (!form) {
                    return 0;
                }

                const invalidField = form.querySelector(".input-validation-error, [aria-invalid='true']");
                if (invalidField) {
                    const panel = invalidField.closest("[data-step-panel]");
                    if (panel && panel instanceof HTMLElement && panel.dataset.stepPanel) {
                        return parseInt(panel.dataset.stepPanel, 10) || 0;
                    }
                }

                const errorMessage = Array.from(form.querySelectorAll(".field-validation-error, .validation-summary-errors"))
                    .find(function (element) {
                        return !!(element.textContent || "").trim();
                    });

                if (errorMessage) {
                    const panel = errorMessage.closest("[data-step-panel]");
                    if (panel && panel instanceof HTMLElement && panel.dataset.stepPanel) {
                        return parseInt(panel.dataset.stepPanel, 10) || 0;
                    }
                }

                return 0;
            };

            nextButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    if (validateStep(currentStep)) {
                        goToStep(currentStep + 1);
                    }
                });
            });

            prevButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    goToStep(currentStep - 1);
                });
            });

            if (form) {
                form.addEventListener("submit", function (event) {
                    const invalidStepIndex = getFirstInvalidStepIndex();

                    if (invalidStepIndex >= 0) {
                        event.preventDefault();
                        goToStep(invalidStepIndex);
                        window.setTimeout(function () {
                            validateStep(invalidStepIndex);
                        }, 0);
                    }
                });
            }

            if (countrySearch && countrySelect) {
                const countryPicker = countrySelect.closest(".country-picker");
                const originalCountryOptions = Array.from(countrySelect.options).map(function (option) {
                    return {
                        value: option.value,
                        text: option.textContent || ""
                    };
                });

                const getCountryText = function (value) {
                    const option = originalCountryOptions.find(function (countryOption) {
                        return countryOption.value === value;
                    });

                    return option ? option.text : "";
                };

                const setCountryListOpen = function (isOpen) {
                    countrySelect.classList.toggle("is-collapsed", !isOpen);
                    countrySearch.setAttribute("aria-expanded", isOpen ? "true" : "false");
                };

                const renderCountryOptions = function (query, selectedValue) {
                    const normalizedQuery = (query || "").trim().toLowerCase();
                    const matchingOptions = originalCountryOptions.filter(function (option) {
                        const matchesQuery = option.text.toLowerCase().includes(normalizedQuery);
                        return normalizedQuery.length === 0 || matchesQuery;
                    });

                    countrySelect.innerHTML = "";

                    matchingOptions.forEach(function (optionData) {
                        const option = document.createElement("option");
                        option.value = optionData.value;
                        option.textContent = optionData.text;
                        option.selected = optionData.value === selectedValue;
                        countrySelect.appendChild(option);
                    });

                    if (selectedValue) {
                        countrySelect.value = selectedValue;
                    } else {
                        countrySelect.selectedIndex = -1;
                    }
                };

                countrySearch.addEventListener("input", function () {
                    const normalizedQuery = countrySearch.value.trim().toLowerCase();
                    const exactMatch = originalCountryOptions.find(function (option) {
                        return option.value !== "" && option.text.toLowerCase() === normalizedQuery;
                    });

                    renderCountryOptions(countrySearch.value, exactMatch ? exactMatch.value : "");
                    setCountryListOpen(true);
                });

                countrySearch.addEventListener("focus", function () {
                    renderCountryOptions(countrySearch.value, countrySelect.value);
                    setCountryListOpen(true);
                });

                countrySearch.addEventListener("keydown", function (event) {
                    if (event.key === "ArrowDown") {
                        event.preventDefault();
                        setCountryListOpen(true);
                        countrySelect.focus();
                    }

                    if (event.key === "Escape" && countrySelect.value) {
                        event.preventDefault();
                        countrySearch.value = getCountryText(countrySelect.value);
                        renderCountryOptions(countrySearch.value, countrySelect.value);
                        setCountryListOpen(false);
                    }
                });

                countrySelect.addEventListener("change", function () {
                    const selectedText = getCountryText(countrySelect.value);
                    countrySearch.value = countrySelect.value ? selectedText : "";
                    renderCountryOptions(countrySearch.value, countrySelect.value);
                    setCountryListOpen(!countrySelect.value);
                });

                document.addEventListener("click", function (event) {
                    if (!countryPicker || countryPicker.contains(event.target)) {
                        return;
                    }

                    if (countrySelect.value) {
                        countrySearch.value = getCountryText(countrySelect.value);
                        renderCountryOptions(countrySearch.value, countrySelect.value);
                        setCountryListOpen(false);
                    }
                });

                if (countrySelect.value) {
                    countrySearch.value = getCountryText(countrySelect.value);
                    renderCountryOptions(countrySearch.value, countrySelect.value);
                    setCountryListOpen(false);
                } else {
                    renderCountryOptions("", "");
                    setCountryListOpen(true);
                }
            }

            if (passwordInput && repeatInput) {
                const ruleElements = {
                    length: document.querySelector('[data-password-rule="length"]'),
                    lowercase: document.querySelector('[data-password-rule="lowercase"]'),
                    uppercase: document.querySelector('[data-password-rule="uppercase"]'),
                    digit: document.querySelector('[data-password-rule="digit"]'),
                    symbol: document.querySelector('[data-password-rule="symbol"]')
                };

                const updateRule = function (element, isMet) {
                    if (!element) {
                        return;
                    }

                    element.classList.toggle("is-met", isMet);
                };

                const getStrengthDetails = function (state) {
                    if (state.password.length === 0) {
                        return {
                            width: "0%",
                            color: "#dc3545",
                            label: "Slaptažodžio stiprumas pasimatys rašant."
                        };
                    }

                    const score = getPasswordScore(state);

                    if (!state.hasMinLength) {
                        return {
                            width: ((Math.max(score, 1) / 5) * 100) + "%",
                            color: "#f59e0b",
                            label: "Per trumpas slaptažodis"
                        };
                    }

                    const strengthMap = {
                        1: { color: "#dc3545", label: "Labai silpnas slaptažodis" },
                        2: { color: "#f59e0b", label: "Silpnas slaptažodis" },
                        3: { color: "#0ea5e9", label: "Vidutinis slaptažodis, pakanka registracijai" },
                        4: { color: "#2563eb", label: "Stiprus slaptažodis" },
                        5: { color: "#15803d", label: "Labai stiprus slaptažodis" }
                    };

                    const details = strengthMap[score] || strengthMap[1];
                    return {
                        width: ((score / 5) * 100) + "%",
                        color: details.color,
                        label: details.label
                    };
                };

                const updatePasswordRules = function () {
                    const state = getPasswordState();

                    updateRule(ruleElements.length, state.hasMinLength);
                    updateRule(ruleElements.lowercase, state.hasLowercase);
                    updateRule(ruleElements.uppercase, state.hasUppercase);
                    updateRule(ruleElements.digit, state.hasDigit);
                    updateRule(ruleElements.symbol, state.hasSymbol);
                };

                const updateStrength = function () {
                    if (!strengthFill || !strengthText) {
                        return;
                    }

                    const details = getStrengthDetails(getPasswordState());
                    strengthFill.style.width = details.width;
                    strengthFill.style.background = details.color;
                    strengthText.textContent = details.label;
                };

                const showGuidance = function () {
                    if (suppressGuidanceChanges) {
                        return;
                    }

                    if (guidance) {
                        guidance.classList.add("is-visible");
                    }

                    if (passwordSummary) {
                        passwordSummary.textContent = "";
                    }
                };

                const hideGuidanceIfNeeded = function () {
                    if (suppressGuidanceChanges) {
                        return;
                    }

                    window.setTimeout(function () {
                        const activeElement = document.activeElement;
                        const stillEditing = activeElement === passwordInput || activeElement === repeatInput;

                        if (stillEditing) {
                            return;
                        }

                        if (guidance) {
                            guidance.classList.remove("is-visible");
                        }

                        const state = getPasswordState();
                        const passwordIsValid =
                            state.password.length === 0
                                || isPasswordStrongEnough(state);

                        if (passwordSummary) {
                            passwordSummary.textContent =
                                state.password.length > 0 && !state.hasMinLength
                                    ? "Slaptažodis per trumpas."
                                    : !passwordIsValid && state.password.length > 0
                                        ? "Slaptažodis per silpnas registracijai."
                                    : "";
                        }

                        if (repeatSummary) {
                            repeatSummary.textContent =
                                state.repeat.length > 0 && state.password !== state.repeat
                                    ? "Slaptažodžiai nesutampa."
                                    : "";
                        }
                    }, 0);
                };

                const updateRepeatSummary = function () {
                    const state = getPasswordState();

                    if (repeatSummary) {
                        const passwordsMatch = state.repeat.length > 0 && state.password === state.repeat;
                        const passwordsDiffer = state.repeat.length > 0 && state.password !== state.repeat;

                        repeatSummary.textContent = passwordsMatch
                            ? "Slaptažodžiai sutampa."
                            : passwordsDiffer
                                ? "Slaptažodžiai nesutampa."
                                : "";

                        repeatSummary.classList.toggle("is-valid", passwordsMatch);
                    }
                };

                toggleButtons.forEach(function (button) {
                    const prepareToggleInteraction = function () {
                        suppressGuidanceChanges = true;
                        guidanceWasVisibleBeforeToggle = guidance ? guidance.classList.contains("is-visible") : false;
                    };

                    button.addEventListener("pointerdown", function () {
                        prepareToggleInteraction();
                    });

                    button.addEventListener("mousedown", function (event) {
                        event.preventDefault();
                        prepareToggleInteraction();
                    });

                    button.addEventListener("click", function () {
                        const targetId = button.getAttribute("data-password-toggle");
                        const input = targetId ? document.getElementById(targetId) : null;
                        const label = button.querySelector(".password-toggle-label");

                        if (!input) {
                            return;
                        }

                        const isHidden = input.type === "password";
                        input.type = isHidden ? "text" : "password";
                        if (label) {
                            label.textContent = isHidden ? "Slėpti" : "Rodyti";
                        }

                        button.classList.toggle("is-active", isHidden);
                        button.setAttribute("aria-pressed", isHidden ? "true" : "false");
                        button.setAttribute("aria-label", isHidden ? "Slėpti slaptažodį" : "Rodyti slaptažodį");
                        button.classList.remove("is-animating");
                        void button.offsetWidth;
                        button.classList.add("is-animating");

                        if (guidance) {
                            guidance.classList.toggle("is-visible", guidanceWasVisibleBeforeToggle);
                        }

                        window.setTimeout(function () {
                            suppressGuidanceChanges = false;
                        }, 0);
                    });

                    button.addEventListener("blur", function () {
                        window.setTimeout(function () {
                            suppressGuidanceChanges = false;
                        }, 0);
                    });
                });

                passwordInput.addEventListener("focus", showGuidance);
                repeatInput.addEventListener("focus", showGuidance);
                passwordInput.addEventListener("blur", hideGuidanceIfNeeded);
                repeatInput.addEventListener("blur", hideGuidanceIfNeeded);

                passwordInput.addEventListener("input", function () {
                    showGuidance();
                    updatePasswordRules();
                    updateStrength();
                    updateRepeatSummary();
                    refreshPasswordCustomValidity();
                });

                repeatInput.addEventListener("input", function () {
                    showGuidance();
                    updateRepeatSummary();
                    refreshPasswordCustomValidity();
                });

                if (passwordInput.value.length > 0 || repeatInput.value.length > 0) {
                    showGuidance();
                }

                updatePasswordRules();
                updateStrength();
                updateRepeatSummary();
                refreshPasswordCustomValidity();
            }

            goToStep(getServerErrorStepIndex());
        });
    </script>
}
