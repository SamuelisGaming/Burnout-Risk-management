@model LoginViewModel
@{
    ViewData["Title"] = "Registracija";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="app-surface p-4 p-md-5">
                <h1 class="page-title h2 mb-4">Registracijos forma</h1>

                <form method="post">
                    <div class="mb-3">
                        <label for="elpastas" class="form-label">Elektroninis paštas</label>
                        <input id="elpastas" name="elpastas" class="form-control" placeholder="Elektroninis paštas" required />
                    </div>

                    <div class="mb-3">
                        <label for="username" class="form-label">Slapyvardis</label>
                        <input id="username" name="username" class="form-control" placeholder="Slapyvardis" required />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Slaptažodis</label>
                        <input id="password" type="password" name="password" class="form-control" placeholder="Slaptažodis" required />
                    </div>

                    <div class="mb-3">
                        <label for="passwordRepeat" class="form-label">Pakartoti slaptažodį</label>
                        <input id="passwordRepeat" type="password" name="passwordRepeat" class="form-control" placeholder="Pakartoti slaptažodį" required />
                    </div>

                    <div class="mb-4">
                        <label for="gender_id" class="form-label">Lytis</label>
                        <select name="gender" id="gender_id" class="form-select" required>
                            <option value="">Pasirinkite lytį</option>
                            <option value="male">Lytis</option>
                            <option value="female">Lytienė</option>
                            <option value="unknown">Lytniukas</option>
                        </select>
                    </div>

                    <div class="d-flex flex-wrap gap-3">
                        <button type="submit" class="btn btn-secondary btn-lg">
                            Registruotis
                        </button>

                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-lg">
                            Atgal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>