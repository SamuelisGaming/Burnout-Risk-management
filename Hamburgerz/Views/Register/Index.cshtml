@model Hamburgerz.Models.RegisterViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = @Localizer["title1"];
    var minPasswordLength = Hamburgerz.Models.PasswordRules.MinLength;
    var minimumAcceptedScore = Hamburgerz.Models.PasswordRules.MinimumAcceptedScore;
    var hasCountries = Model.Countries.Count > 0;
    var minBirthDate = DateTime.Today.AddYears(-100).ToString("yyyy-MM-dd");
    var maxBirthDate = DateTime.Today.AddYears(-14).ToString("yyyy-MM-dd");
}

<div class="register-shell">
    <div class="register-layout">
        <aside class="register-story">
            <div class="register-story-panel">
                <div class="register-kicker">@Localizer["title1"]</div>
                <h1 class="register-title">@Localizer["titledescr1"]</h1>
                <p class="register-copy">
                    @Localizer["titledescr2"]
                </p>

                <div class="register-journey" data-step-markers>
                    <div class="journey-step is-active" data-step-marker="0">
                        <div class="journey-step-index">1</div>
                        <div>
                            <div class="journey-step-title">@Localizer["account"]</div>
                            <div class="journey-step-copy">@Localizer["accountdescr"]</div>
                        </div>
                    </div>

                    <div class="journey-step" data-step-marker="1">
                        <div class="journey-step-index">2</div>
                        <div>
                            <div class="journey-step-title">@Localizer["about"]</div>
                            <div class="journey-step-copy">@Localizer["aboutdescr"]</div>
                        </div>
                    </div>

                    <div class="journey-step" data-step-marker="2">
                        <div class="journey-step-index">3</div>
                        <div>
                            <div class="journey-step-title">@Localizer["aboutwork"]</div>
                            <div class="journey-step-copy">@Localizer["aboutworkdescr"]</div>
                        </div>
                    </div>
                </div>

                <div class="register-note-card">
                    <div class="register-note-label">@Localizer["why"]</div>
                    <p class="register-note-text">
                        @Localizer["whydescr"]
                    </p>
                </div>
            </div>
        </aside>

        <section class="register-form-zone">
            <div class="register-card">
                <div class="register-progress">
                    <div class="register-progress-bar" data-progress-fill></div>
                </div>

                <div class="register-card-top">
                    <div>
                        <div class="register-step-label" data-step-caption>@Localizer["account13"]</div>
                        <h2 class="register-card-title" data-step-title>@Localizer["titledescr1"]</h2>
                    </div>

                    <a asp-controller="Login" asp-action="Index" class="register-back-link">
                        @Localizer["back"]
                    </a>
                </div>

                <form asp-action="Index" method="post" class="register-wizard" data-register-wizard>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger register-summary"></div>

                    <div class="register-stage" data-step-stage>
                        <section class="register-step-panel is-active" data-step-panel="0" data-step-name="Paskyra">
                            <div class="step-section-header">
                                <div class="step-kicker">@Localizer["step1"]</div>
                                <h3 class="step-title">@Localizer["step1descr1"]</h3>
                                <p class="step-copy">@Localizer["step1descr2"]</p>
                            </div>

                            <div class="register-field-grid">
                                <label class="register-field register-field-wide">
                                    <span class="register-field-label">@Localizer["email"]</span>
                                    <input asp-for="Email"
                                           class="form-control form-control-lg"
                                           placeholder="vardas@pastas.lt"
                                           autocomplete="email"
                                           required />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </label>

                                <label class="register-field register-field-wide">
                                    <span class="register-field-label">@Localizer["user"]</span>
                                    <input asp-for="Username"
                                           class="form-control form-control-lg"
                                           placeholder=@Localizer["usertemp"]
                                           autocomplete="username"
                                           required />
                                    <span asp-validation-for="Username" class="text-danger"></span>
                                </label>

                                <div class="register-field register-field-wide">
                                    <label asp-for="Password" class="register-field-label">@Localizer["pass"]</label>
                                    <div class="password-field">
                                        <input asp-for="Password"
                                               class="form-control form-control-lg"
                                               placeholder=@Localizer["passtemp"]
                                               autocomplete="new-password"
                                               required />
                                        <button type="button"
                                                class="password-toggle"
                                                data-password-toggle="Password"
                                                aria-label=@Localizer["passshow"]
                                                aria-pressed="false">
                                            <span class="password-toggle-icon" aria-hidden="true">
                                                <svg class="password-toggle-svg password-toggle-svg-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M2.5 12s3.6-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.6 6.5-9.5 6.5S2.5 12 2.5 12Z" />
                                                    <circle cx="12" cy="12" r="3" />
                                                </svg>
                                                <svg class="password-toggle-svg password-toggle-svg-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M3 3l18 18" />
                                                    <path d="M10.58 10.58A2 2 0 0 0 12 14a2 2 0 0 0 1.42-.58" />
                                                    <path d="M6.71 6.72C4.47 8.23 3 10.68 2.5 12c.83 2.2 4.1 6.5 9.5 6.5 2.24 0 4.18-.74 5.76-1.76" />
                                                    <path d="M9.88 4.68A10.7 10.7 0 0 1 12 4.5c5.9 0 9.5 6.5 9.5 6.5a15.3 15.3 0 0 1-2.17 3.19" />
                                                </svg>
                                            </span>
                                            <span class="visually-hidden password-toggle-label">@Localizer["show"]</span>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                    <div class="password-inline-feedback" data-password-summary aria-live="polite"></div>

                                    <div class="password-guidance" data-password-guidance aria-live="polite">
                                        <div class="password-strength">
                                            <div class="password-strength-bar">
                                                <div class="password-strength-fill" data-password-strength-fill></div>
                                            </div>
                                            <div class="password-strength-text" data-password-strength-text>
                                                @Localizer["strength"]
                                            </div>
                                        </div>

                                        <div class="password-rule-list">
                                            <div class="password-rule" data-password-rule="length">@Localizer["atleast"] @minPasswordLength @Localizer["symbols"]</div>
                                            <div class="password-rule" data-password-rule="lowercase">@Localizer["strengthlower"]</div>
                                            <div class="password-rule" data-password-rule="uppercase">@Localizer["strengthupper"]</div>
                                            <div class="password-rule" data-password-rule="digit">@Localizer["strengthnum"]</div>
                                            <div class="password-rule" data-password-rule="symbol">@Localizer["strengthspecial"]</div>
                                            <div class="password-rule password-rule-note is-note">@Localizer["strengthoption"]</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="register-field register-field-wide">
                                    <label asp-for="PasswordRepeat" class="register-field-label">@Localizer["passrepeat"]</label>
                                    <div class="password-field">
                                        <input asp-for="PasswordRepeat"
                                               class="form-control form-control-lg"
                                               placeholder=@Localizer["passrepeat2"]
                                               autocomplete="new-password"
                                               required />
                                        <button type="button"
                                                class="password-toggle"
                                                data-password-toggle="PasswordRepeat"
                                                aria-label=@Localizer["passshow"]
                                                aria-pressed="false">
                                            <span class="password-toggle-icon" aria-hidden="true">
                                                <svg class="password-toggle-svg password-toggle-svg-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M2.5 12s3.6-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.6 6.5-9.5 6.5S2.5 12 2.5 12Z" />
                                                    <circle cx="12" cy="12" r="3" />
                                                </svg>
                                                <svg class="password-toggle-svg password-toggle-svg-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M3 3l18 18" />
                                                    <path d="M10.58 10.58A2 2 0 0 0 12 14a2 2 0 0 0 1.42-.58" />
                                                    <path d="M6.71 6.72C4.47 8.23 3 10.68 2.5 12c.83 2.2 4.1 6.5 9.5 6.5 2.24 0 4.18-.74 5.76-1.76" />
                                                    <path d="M9.88 4.68A10.7 10.7 0 0 1 12 4.5c5.9 0 9.5 6.5 9.5 6.5a15.3 15.3 0 0 1-2.17 3.19" />
                                                </svg>
                                            </span>
                                            <span class="visually-hidden password-toggle-label">@Localizer["show"]</span>
                                        </button>
                                    </div>
                                    <span asp-validation-for="PasswordRepeat" class="text-danger"></span>
                                    <div class="password-inline-feedback" data-repeat-summary aria-live="polite"></div>
                                </div>
                            </div>

                            <div class="register-actions">
                                <span></span>
                                <button type="button" class="btn btn-primary btn-lg register-next" data-step-next>
                                    @Localizer["next"]
                                </button>
                            </div>
                        </section>

                        <section class="register-step-panel" data-step-panel="1" data-step-name="Apie tave">
                            <div class="step-section-header">
                                <div class="step-kicker">@Localizer["step2"]</div>
                                <h3 class="step-title">@Localizer["step2descr1"]</h3>
                                <p class="step-copy">@Localizer["step2descr2"]</p>
                            </div>

                            <div class="register-field-grid">
                                <div class="register-field register-field-wide">
                                    <span class="register-field-label">@Localizer["gender"]</span>
                                    <div class="choice-grid choice-grid-three">
                                        <input asp-for="Gender" type="radio" value="male" id="GenderMale" class="choice-input" required />
                                        <label for="GenderMale" class="choice-card">
                                            <span class="choice-title">@Localizer["gender1"]</span>
                                            <span class="choice-copy">@Localizer["gender1descr"]</span>
                                        </label>

                                        <input asp-for="Gender" type="radio" value="female" id="GenderFemale" class="choice-input" required />
                                        <label for="GenderFemale" class="choice-card">
                                            <span class="choice-title">@Localizer["gender2"]</span>
                                            <span class="choice-copy">@Localizer["gender2descr"]</span>
                                        </label>

                                        <input asp-for="Gender" type="radio" value="other" id="GenderOther" class="choice-input" required />
                                        <label for="GenderOther" class="choice-card">
                                            <span class="choice-title">Kita</span>
                                            <span class="choice-copy">Pasirinkimas profilio informacijai.</span>
                                        </label>
                                    </div>
                                    <span asp-validation-for="Gender" class="text-danger"></span>
                                </div>

                                <label class="register-field">
                                    <span class="register-field-label">Gimimo data</span>
                                    <input asp-for="BirthDate"
                                           class="form-control form-control-lg"
                                           type="date"
                                           min="@minBirthDate"
                                           max="@maxBirthDate"
                                           required />
                                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                                </label>

                                <div class="register-field register-field-wide">
                                    <label asp-for="CountryID" class="register-field-label">Šalis</label>
                                    <div class="country-picker">
                                        <input type="text"
                                               class="form-control form-control-lg country-search"
                                               data-country-search
                                               placeholder="Ieškoti šalies"
                                               autocomplete="off"
                                               aria-expanded="true" />
                                        <select asp-for="CountryID"
                                                asp-items="Model.Countries"
                                                class="form-select country-select"
                                                data-country-select
                                                size="8"
                                                required>
                                            <option value="">Pasirinkite šalį</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="CountryID" class="text-danger"></span>

                                    @if (!hasCountries)
                                    {
                                        <div class="country-empty-note">
                                            Šalių sąrašas tuščias. Reikės užpildyti `countries` lentelę, kad šis laukas veiktų pilnai.
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="register-actions">
                                <button type="button" class="btn btn-outline-primary btn-lg" data-step-prev>
                                    Atgal
                                </button>
                                <button type="button" class="btn btn-primary btn-lg register-next" data-step-next>
                                    Toliau
                                </button>
                            </div>
                        </section>

                        <section class="register-step-panel" data-step-panel="2" data-step-name="Darbas">
                            <div class="step-section-header">
                                <div class="step-kicker">3 žingsnis</div>
                                <h3 class="step-title">Darbo informacija</h3>
                                <p class="step-copy">Kuo tiksliau užpildysi informaciją apie darbą, tuo naudingesnė bus analizė.</p>
                            </div>

                            <div class="register-field-grid">
                                <label class="register-field register-field-wide">
                                    <span class="register-field-label">Darbo pozicija</span>
                                    <div class="job-role-field"
                                         data-job-role-field
                                         data-job-role-endpoint="@Url.Content("~/api/job-roles")">
                                        <input asp-for="JobRole"
                                               class="form-control form-control-lg"
                                               placeholder="Pvz. dev, qa, projektu vadovas..."
                                               maxlength="80"
                                               autocomplete="off"
                                               spellcheck="false"
                                               aria-autocomplete="list"
                                               data-job-role-input
                                               required />
                                        <div class="job-role-suggestions" data-job-role-suggestions hidden></div>
                                    </div>
                                    <span asp-validation-for="JobRole" class="text-danger"></span>
                                </label>

                                <label class="register-field">
                                    <span class="register-field-label">Patirties metai</span>
                                    <input asp-for="ExperienceYears"
                                           class="form-control form-control-lg"
                                           type="number"
                                           placeholder="3"
                                           min="0"
                                           max="80"
                                           required />
                                    <span asp-validation-for="ExperienceYears" class="text-danger"></span>
                                </label>

                                <div class="register-field register-field-wide">
                                    <span class="register-field-label">Kompanijos dydis</span>
                                    <div class="choice-grid choice-grid-three">
                                        <input asp-for="CompanySize" type="radio" value="Maža" id="CompanySmall" class="choice-input" required />
                                        <label for="CompanySmall" class="choice-card">
                                            <span class="choice-title">Maža</span>
                                            <span class="choice-copy">1–50 žmonių komanda.</span>
                                        </label>

                                        <input asp-for="CompanySize" type="radio" value="Vidutinė" id="CompanyMedium" class="choice-input" required />
                                        <label for="CompanyMedium" class="choice-card">
                                            <span class="choice-title">Vidutinė</span>
                                            <span class="choice-copy">51–250 žmonių komanda.</span>
                                        </label>

                                        <input asp-for="CompanySize" type="radio" value="Didelė" id="CompanyLarge" class="choice-input" required />
                                        <label for="CompanyLarge" class="choice-card">
                                            <span class="choice-title">Didelė</span>
                                            <span class="choice-copy">250+ žmonių organizacija.</span>
                                        </label>
                                    </div>
                                    <span asp-validation-for="CompanySize" class="text-danger"></span>
                                </div>

                                <div class="register-field register-field-wide">
                                    <span class="register-field-label">Darbo pobūdis</span>
                                    <div class="choice-grid choice-grid-three">
                                        <input asp-for="WorkEnvironment" type="radio" value="Nuotolinis" id="WorkRemote" class="choice-input" required />
                                        <label for="WorkRemote" class="choice-card">
                                            <span class="choice-title">Nuotolinis</span>
                                            <span class="choice-copy">Kasdienis darbas daugiausia internetu.</span>
                                        </label>

                                        <input asp-for="WorkEnvironment" type="radio" value="Ofisinis" id="WorkOffice" class="choice-input" required />
                                        <label for="WorkOffice" class="choice-card">
                                            <span class="choice-title">Ofisinis</span>
                                            <span class="choice-copy">Pagrindinė vieta yra ofisas.</span>
                                        </label>

                                        <input asp-for="WorkEnvironment" type="radio" value="Hibridinis" id="WorkHybrid" class="choice-input" required />
                                        <label for="WorkHybrid" class="choice-card">
                                            <span class="choice-title">Hibridinis</span>
                                            <span class="choice-copy">Mišrus ritmas tarp namų ir ofiso.</span>
                                        </label>
                                    </div>
                                    <span asp-validation-for="WorkEnvironment" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="register-actions">
                                <button type="button" class="btn btn-outline-primary btn-lg" data-step-prev>
                                    Atgal
                                </button>
                                <button type="submit" class="btn btn-secondary btn-lg">
                                    Užbaigti registraciją
                                </button>
                            </div>
                        </section>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

<style>
    .register-shell {
        max-width: 1260px;
        margin: 0 auto;
        padding: 24px 0 52px;
    }

    .register-layout {
        display: grid;
        grid-template-columns: minmax(320px, 0.95fr) minmax(0, 1.1fr);
        gap: 22px;
        align-items: stretch;
    }

    .register-story-panel,
    .register-card {
        border: 1px solid var(--color-border);
        border-radius: 28px;
        box-shadow: var(--shadow-md);
        overflow: hidden;
    }

    .register-card {
        overflow: visible;
    }

    .register-story-panel {
        height: 100%;
        padding: 30px;
        color: #f8fafc;
        background:
            radial-gradient(circle at 18% 16%, rgba(255, 255, 255, 0.16), transparent 24%),
            radial-gradient(circle at 82% 20%, rgba(255, 255, 255, 0.12), transparent 18%),
            linear-gradient(150deg, #0f172a 0%, #12233d 48%, #183b5b 100%);
    }

    .register-kicker,
    .step-kicker {
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 800;
    }

    .register-kicker {
        color: rgba(255, 255, 255, 0.74);
        margin-bottom: 12px;
    }

    .register-title {
        margin: 0;
        font-size: clamp(36px, 5vw, 56px);
        line-height: 0.98;
        font-weight: 900;
        letter-spacing: -0.04em;
        color: #fff;
    }

    .register-copy {
        margin: 18px 0 0;
        font-size: 16px;
        line-height: 1.75;
        color: rgba(241, 245, 249, 0.82);
        max-width: 34rem;
    }

    .register-journey {
        display: grid;
        gap: 12px;
        margin-top: 28px;
    }

    .journey-step {
        display: grid;
        grid-template-columns: 44px 1fr;
        gap: 14px;
        align-items: start;
        padding: 16px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: transform 0.22s ease, border-color 0.22s ease, background 0.22s ease;
    }

    .journey-step.is-active {
        transform: translateX(4px);
        background: rgba(255, 255, 255, 0.13);
        border-color: rgba(255, 255, 255, 0.24);
    }

    .journey-step-index {
        width: 44px;
        height: 44px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.12);
        font-size: 15px;
        font-weight: 900;
        color: #fff;
    }

    .journey-step-title {
        font-size: 16px;
        font-weight: 800;
        color: #fff;
    }

    .journey-step-copy {
        margin-top: 4px;
        color: rgba(241, 245, 249, 0.72);
        font-size: 13px;
        line-height: 1.5;
    }

    .register-note-card {
        margin-top: 26px;
        padding: 18px 18px 20px;
        border-radius: 22px;
        background: rgba(15, 23, 42, 0.34);
        border: 1px solid rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(14px);
    }

    .register-note-label {
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.68);
    }

    .register-note-text {
        margin: 10px 0 0;
        color: rgba(241, 245, 249, 0.82);
        line-height: 1.7;
        font-size: 14px;
    }

    .register-card {
        background:
            radial-gradient(circle at top right, rgba(var(--color-secondary-rgb), 0.12), transparent 24%),
            linear-gradient(180deg, var(--color-surface) 0%, rgba(255, 255, 255, 0.96) 100%);
        padding: 0;
    }

    .register-progress {
        height: 8px;
        background: rgba(var(--color-secondary-rgb), 0.08);
    }

    .register-progress-bar {
        height: 100%;
        width: 33.333%;
        background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
        transition: width 0.28s ease;
    }

    .register-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        padding: 26px 28px 0;
    }

    .register-step-label {
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-primary);
        margin-bottom: 10px;
    }

    .register-card-title {
        margin: 0;
        font-size: clamp(28px, 3vw, 38px);
        font-weight: 900;
        line-height: 1.02;
        letter-spacing: -0.03em;
        color: var(--color-text);
    }

    .register-back-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 16px;
        border-radius: 999px;
        border: 1px solid var(--color-border);
        background: rgba(255, 255, 255, 0.74);
        text-decoration: none;
        font-weight: 700;
        color: var(--color-text);
        white-space: nowrap;
    }

    .register-back-link:hover {
        color: var(--color-text);
        border-color: rgba(var(--color-primary-rgb), 0.25);
    }

    .register-wizard {
        padding: 18px 28px 28px;
    }

    .register-summary {
        min-height: 18px;
        margin-bottom: 10px;
    }

    .register-stage {
        position: relative;
    }

    .register-step-panel {
        border-radius: 24px;
        border: 1px solid rgba(var(--color-secondary-rgb), 0.12);
        background: rgba(255, 255, 255, 0.84);
        padding: 24px;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
    }

    .register-wizard.is-enhanced .register-step-panel {
        display: none;
    }

    .register-wizard.is-enhanced .register-step-panel.is-active {
        display: block;
        animation: registerStepFade 0.3s ease;
    }

    @@keyframes registerStepFade {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .step-section-header {
        margin-bottom: 20px;
    }

    .step-kicker {
        color: var(--color-primary);
        margin-bottom: 8px;
    }

    .step-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        color: var(--color-text);
        letter-spacing: -0.03em;
    }

    .step-copy {
        margin: 10px 0 0;
        color: var(--color-text-muted);
        line-height: 1.65;
        max-width: 42rem;
    }

    .register-field-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .register-field {
        display: grid;
        gap: 8px;
    }

    .register-field-wide {
        grid-column: 1 / -1;
    }

    .register-field-label {
        font-size: 13px;
        font-weight: 800;
        color: var(--color-text-muted);
        letter-spacing: 0.02em;
    }

    .register-field .form-control,
    .register-field .form-select {
        min-height: 58px;
        border-radius: 18px;
        border-color: rgba(var(--color-secondary-rgb), 0.16);
        background: #fff;
        box-shadow: none;
    }

    .register-field .form-control:focus,
    .register-field .form-select:focus {
        border-color: rgba(var(--color-primary-rgb), 0.42);
        box-shadow: 0 0 0 0.28rem rgba(var(--color-secondary-rgb), 0.14);
    }

    .choice-grid {
        display: grid;
        gap: 12px;
    }

    .choice-grid-three {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .choice-input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .choice-card {
        min-height: 128px;
        padding: 18px 16px;
        border-radius: 20px;
        border: 1px solid rgba(var(--color-secondary-rgb), 0.18);
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.92));
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 12px;
        cursor: pointer;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .choice-card:hover {
