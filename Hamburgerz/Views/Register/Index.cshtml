    }

    .choice-input:checked + .choice-card {
        border-color: rgba(var(--color-primary-rgb), 0.44);
        background:
            radial-gradient(circle at top right, rgba(var(--color-secondary-rgb), 0.14), transparent 36%),
            linear-gradient(180deg, rgba(255, 255, 255, 1), rgba(var(--color-secondary-rgb), 0.06));
        box-shadow: 0 0 0 0.26rem rgba(var(--color-secondary-rgb), 0.12);
