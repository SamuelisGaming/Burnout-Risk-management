@model Hamburgerz.Models.LoginViewModel
@{
    ViewData["Title"] = "Prisijungimas";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="app-surface p-4 p-md-5">
                <h1 class="page-title h2 mb-4">Prisijungimas</h1>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-action="Index" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Elektroninis paštas</label>
                        <input asp-for="Email" class="form-control" placeholder="Elektroninis paštas" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">Slaptažodis</label>
                        <input asp-for="Password" class="form-control" placeholder="Slaptažodis" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-3">
                        <button type="submit" class="btn btn-secondary btn-lg">
                            Prisijungti
                        </button>

                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-lg">
                            Atgal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}