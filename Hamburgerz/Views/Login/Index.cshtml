@model LoginViewModel
@{
    ViewData["Title"] = "Prisijungimas";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="app-surface p-4 p-md-5">
                <h1 class="page-title h2 mb-4">Prisijungimas</h1>

                <form method="post">
                    <div class="mb-3">
                        <label for="loginmethod" class="form-label">Elektroninis paštas arba slapyvardis</label>
                        <input id="loginmethod" name="loginmethod" class="form-control" placeholder="El. paštas arba slapyvardis" required />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Slaptažodis</label>
                        <input id="password" type="password" name="password" class="form-control" placeholder="Slaptažodis" required />
                    </div>

                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a asp-controller="Data" asp-action="DataEntry" class="btn btn-primary btn-lg">
                            Prisijungti
                        </a>

                        <a asp-controller="Register" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            Registruotis
                        </a>

                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-lg">
                            Atgal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>