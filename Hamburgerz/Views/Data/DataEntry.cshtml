@model Hamburgerz.Models.MeasurementEntryViewModel
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["title"];
    var totalSteps = Math.Max(1, Model.TotalVisibleQuestionCount);
    var stepKeys = new List<string>
    {
        "sleep-hours",
        "work-hours",
        "exercise-hours",
        "screen-time",
        "meetings",
        "daily-energy",
        "stress-level",
        "focus",
        "disconnect"
    };

    stepKeys.AddRange(Model.Questions.Select(question => $"question-{question.Key}"));

    var stepRanks = stepKeys
        .Select((key, index) => new
        {
            Key = key,
            OriginalIndex = index,
            Order = StableStepOrder(Model.QuestionOrderSeed, key)
        })
        .OrderBy(step => step.Order)
        .ThenBy(step => step.OriginalIndex)
        .Select((step, rank) => new { step.Key, Rank = rank })
        .ToDictionary(step => step.Key, step => step.Rank);

    int StepIndex(string key) => stepRanks.TryGetValue(key, out var rank) ? rank : 0;
    string PanelClass(string key) => StepIndex(key) == 0 ? "mq-panel is-active" : "mq-panel";
}

@functions {
    private static uint StableStepOrder(string seed, string key)
    {
        unchecked
        {
            var value = $"{seed}::{key}";
            uint hash = 2166136261;
            foreach (var character in value)
            {
                hash ^= character;
                hash *= 16777619;
            }

            return hash;
        }
    }

    private IHtmlContent FaceIcon(string variant)
    {
        var features = variant switch
        {
            "great" => @"<path d=""M15.5 20.5c1.4-1.8 4-1.8 5.4 0"" stroke=""currentColor"" stroke-width=""2.7"" stroke-linecap=""round""/><path d=""M27.1 20.5c1.4-1.8 4-1.8 5.4 0"" stroke=""currentColor"" stroke-width=""2.7"" stroke-linecap=""round""/><path d=""M16.5 28.7c4.3 5 10.7 5 15 0"" stroke=""currentColor"" stroke-width=""2.9"" stroke-linecap=""round""/>",
            "happy" => @"<circle cx=""18"" cy=""20.3"" r=""2.2"" fill=""currentColor""/><circle cx=""30"" cy=""20.3"" r=""2.2"" fill=""currentColor""/><path d=""M17 29.4c4.1 4.1 9.9 4.1 14 0"" stroke=""currentColor"" stroke-width=""2.9"" stroke-linecap=""round""/>",
            "neutral" => @"<circle cx=""18"" cy=""20.5"" r=""2.1"" fill=""currentColor""/><circle cx=""30"" cy=""20.5"" r=""2.1"" fill=""currentColor""/><path d=""M17.5 30.5h13"" stroke=""currentColor"" stroke-width=""2.9"" stroke-linecap=""round""/>",
            "sad" => @"<circle cx=""18"" cy=""20.5"" r=""2.1"" fill=""currentColor""/><circle cx=""30"" cy=""20.5"" r=""2.1"" fill=""currentColor""/><path d=""M17 32.2c4.1-4 9.9-4 14 0"" stroke=""currentColor"" stroke-width=""2.9"" stroke-linecap=""round""/>",
            "rough" => @"<path d=""M16.1 19.4l4.5 1.5"" stroke=""currentColor"" stroke-width=""2.7"" stroke-linecap=""round""/><path d=""M31.9 19.4l-4.5 1.5"" stroke=""currentColor"" stroke-width=""2.7"" stroke-linecap=""round""/><circle cx=""18"" cy=""23.4"" r=""1.9"" fill=""currentColor""/><circle cx=""30"" cy=""23.4"" r=""1.9"" fill=""currentColor""/><path d=""M17 33.4c4.1-4.4 9.9-4.4 14 0"" stroke=""currentColor"" stroke-width=""2.9"" stroke-linecap=""round""/><path d=""M13.6 25.5c-2 2.7-2 5.1 0 7.1 2-2 2-4.4 0-7.1z"" fill=""currentColor"" opacity="".82""/><path d=""M34.4 25.5c2 2.7 2 5.1 0 7.1-2-2-2-4.4 0-7.1z"" fill=""currentColor"" opacity="".82""/>",
            _ => @"<circle cx=""18"" cy=""20.5"" r=""2.1"" fill=""currentColor""/><circle cx=""30"" cy=""20.5"" r=""2.1"" fill=""currentColor""/><path d=""M17.5 30.5h13"" stroke=""currentColor"" stroke-width=""2.9"" stroke-linecap=""round""/>"
        };

        return new HtmlString($@"<span class=""mq-face"" aria-hidden=""true""><svg class=""mq-smiley"" viewBox=""0 0 48 48"" fill=""none"" xmlns=""http://www.w3.org/2000/svg""><circle cx=""24"" cy=""24"" r=""18.2"" stroke=""currentColor"" stroke-width=""3""/>{features}</svg></span>");
    }

}

<style>
    .mq-shell {
        padding: 1.5rem 0 3.5rem;
    }

    .mq-form {
        position: relative;
        overflow: hidden;
        isolation: isolate;
        display: flex;
        flex-direction: column;
        width: min(100%, 920px);
        max-width: 920px;
        margin: 0 auto;
        padding: 2rem 2.25rem 2.25rem;
        border-radius: 24px;
        border: 1px solid rgba(var(--color-border-rgb), .78);
        background: linear-gradient(180deg, rgba(var(--color-surface-rgb), .95), rgba(255,255,255,.88));
        box-shadow: 0 24px 56px rgba(15,23,42,.11);
        backdrop-filter: blur(18px) saturate(145%);
        -webkit-backdrop-filter: blur(18px) saturate(145%);
    }

    .mq-form::before {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 5px;
        background: linear-gradient(90deg, var(--color-primary), var(--color-tertiary), var(--color-secondary));
        opacity: .9;
        pointer-events: none;
    }

    .mq-head {
        margin-bottom: 1.05rem;
    }

    .mq-indicator {
        color: var(--color-primary);
        font-size: .82rem;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .mq-head h2 {
        margin: .4rem 0 .35rem;
        font-size: clamp(1.8rem, 3.2vw, 2.35rem);
        line-height: 1.12;
        letter-spacing: 0;
    }

    .mq-head p {
        margin: 0;
        color: var(--color-text-muted);
        line-height: 1.55;
    }

    .mq-progress {
        height: 9px;
        border-radius: 999px;
        background: rgba(var(--color-border-rgb), .7);
        overflow: hidden;
        margin: 1.1rem 0 1.55rem;
        flex: 0 0 auto;
    }

    .mq-progress-fill {
        height: 100%;
        width: calc(100% / @totalSteps);
        background: linear-gradient(90deg, var(--color-primary), var(--color-tertiary), var(--color-secondary));
        transition: width .5s cubic-bezier(.18, .9, .25, 1.15);
    }

    .mq-limit-card {
        max-width: 920px;
        margin: 0 auto 1rem;
        padding: 1.1rem 1.25rem;
        border-radius: 18px;
        border: 1px solid rgba(var(--color-primary-rgb), .18);
        background: var(--color-surface);
        box-shadow: var(--shadow-sm);
        color: var(--color-text);
    }

    .mq-limit-title {
        margin: 0 0 .35rem;
        font-weight: 800;
        font-size: 1.05rem;
    }

    .mq-limit-copy {
        margin: 0;
        color: var(--color-text-muted);
        line-height: 1.55;
    }

    .mq-premium-button {
        margin-top: .9rem;
        border: 0;
        border-radius: 12px;
        padding: .8rem 1rem;
        background: linear-gradient(135deg, #fbbf24, #d97706);
        color: #251604;
        font-weight: 900;
    }

    .mq-summary {
        margin-bottom: 1rem;
        padding: .85rem 1rem;
        border-radius: 14px;
        background: rgba(220,53,69,.08);
        border: 1px solid rgba(220,53,69,.16);
    }

    .mq-panel {
        display: none;
        flex: 1 1 auto;
    }

    .mq-panel.is-active {
        display: block;
        animation: mqReveal .42s cubic-bezier(.18, 1.1, .32, 1);
    }

    .mq-panel.is-back {
        display: block;
        animation: mqRevealBack .36s cubic-bezier(.2, 1, .32, 1);
    }

    .mq-panel.is-exiting,
    .mq-panel.is-exiting-back {
        display: block;
        pointer-events: none;
    }

    .mq-panel.is-exiting {
        animation: mqLeave .18s ease-in forwards;
    }

    .mq-panel.is-exiting-back {
        animation: mqLeaveBack .18s ease-in forwards;
    }

    .mq-question-row {
        max-width: 760px;
        margin: .5rem auto 2rem;
        text-align: center;
    }

    .mq-question-copy {
        min-width: 0;
    }

    .mq-question {
        margin: 0 0 .65rem;
        font-size: clamp(1.75rem, 3.8vw, 2.7rem);
        line-height: 1.1;
        letter-spacing: 0;
    }

    .mq-subcopy {
        margin: 0;
        color: var(--color-text-muted);
        line-height: 1.6;
        font-size: .97rem;
    }

    .mq-card {
        margin-top: 0;
        padding: 1.5rem;
        border-radius: 18px;
        background: rgba(255,255,255,.68);
        border: 1px solid rgba(var(--color-border-rgb), .78);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.5), 0 16px 34px rgba(15,23,42,.06);
    }

    .mq-number-card {
        padding: clamp(1.35rem, 3vw, 2rem);
    }

    .mq-choice-card {
        padding: clamp(1.15rem, 2.4vw, 1.55rem);
    }

    .mq-scale-card {
        max-width: 820px;
        margin-left: auto;
        margin-right: auto;
    }

    .mq-label {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
    }

    .mq-input-wrap {
        position: relative;
    }

    .mq-input {
        min-height: 104px;
        padding-right: 5.8rem !important;
        border-radius: 16px !important;
        font-size: clamp(2.15rem, 5vw, 4rem) !important;
        font-weight: 900 !important;
        text-align: center;
        letter-spacing: 0;
    }

    .mq-suffix {
        position: absolute;
        top: 50%;
        right: 1.25rem;
        transform: translateY(-50%);
        padding: .35rem .7rem;
        border-radius: 999px;
        background: rgba(var(--color-primary-rgb), .08);
        color: var(--color-primary);
        font-size: .9rem;
        font-weight: 800;
        pointer-events: none;
    }

    .mq-chips {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        margin-top: 1.15rem;
    }

    .mq-chip {
        border: 1px solid rgba(var(--color-primary-rgb), .18);
        background: rgba(var(--color-primary-rgb), .06);
        color: var(--color-text);
        border-radius: 999px;
        padding: .72rem 1.05rem;
        font-size: .96rem;
        font-weight: 750;
        cursor: pointer;
        transition: transform .16s cubic-bezier(.18, 1.25, .32, 1), background .16s ease, color .16s ease, box-shadow .16s ease;
        user-select: none;
        -webkit-user-select: none;
    }

    .mq-chip:hover,
    .mq-chip:focus-visible,
    .mq-chip.is-active {
        transform: translateY(-3px);
        background: rgba(var(--color-primary-rgb), .13);
        color: var(--color-primary);
        box-shadow: 0 6px 16px rgba(var(--color-primary-rgb), .1);
        outline: none;
    }

    .mq-chip.is-chip-pending {
        animation: mqChipPop .3s cubic-bezier(.18, 1.45, .32, 1);
    }

    .mq-choice-grid {
        display: grid;
        gap: 1rem;
    }

    .mq-choice-grid-3 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mq-choice-grid-4 {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .mq-choice-grid-5 {
        grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .mq-choice-grid input[type="radio"] {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 0;
        height: 0;
    }

    .mq-choice {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 136px;
        gap: .72rem;
        padding: 1.1rem .8rem;
        border-radius: 16px;
        border: 2px solid rgba(var(--color-border-rgb), .9);
        background: rgba(255,255,255,.82);
        color: var(--color-text);
        text-align: center;
        font-size: 1.02rem;
        font-weight: 800;
        line-height: 1.18;
        cursor: pointer;
        transition: transform .2s cubic-bezier(.18, 1.25, .32, 1), box-shadow .18s ease, border-color .18s ease, background .18s ease, color .18s ease;
        user-select: none;
        -webkit-user-select: none;
    }

    .mq-choice:hover {
        transform: scale(1.025);
        box-shadow: 0 8px 24px rgba(15,23,42,.09);
        border-color: rgba(var(--color-primary-rgb), .34);
    }

    .mq-choice::after {
        content: "";
        position: absolute;
        inset: auto 18% -34% 18%;
        height: 60%;
        border-radius: 999px;
        background: rgba(var(--color-primary-rgb), .12);
        filter: blur(20px);
        opacity: 0;
        transition: opacity .18s ease, transform .18s ease;
        pointer-events: none;
    }

    .mq-choice-grid input[type="radio"]:checked + .mq-choice {
        transform: scale(1.03);
        background: linear-gradient(160deg, rgba(var(--color-primary-rgb), .08), rgba(var(--color-tertiary-rgb), .08));
        border-color: rgba(var(--color-primary-rgb), .58);
        color: var(--color-primary);
        box-shadow: 0 8px 24px rgba(var(--color-primary-rgb), .13);
    }

    .mq-choice-grid input[type="radio"]:checked + .mq-choice::after {
        opacity: 1;
        transform: translateY(-8px);
    }

    .mq-choice-grid input[type="radio"]:focus-visible + .mq-choice {
        outline: 3px solid rgba(var(--color-primary-rgb), .24);
        outline-offset: 3px;
    }

    .mq-face {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 58px;
        height: 58px;
        color: currentColor;
    }

    .mq-smiley {
        width: 100%;
        height: 100%;
        display: block;
    }

    .mq-smiley * {
        vector-effect: non-scaling-stroke;
    }

    .mq-choice-text {
        position: relative;
        z-index: 1;
        display: block;
        max-width: 100%;
        overflow-wrap: anywhere;
    }

    .mq-scale-choice {
        min-height: 96px;
        padding: 1.35rem 1rem;
        font-size: 1rem;
        font-weight: 700;
        border-width: 1px;
    }

    .mq-choice.is-choice-pending {
        animation: mqSelect .28s cubic-bezier(.18, 1.3, .32, 1);
    }

    .mq-error {
        display: block;
        margin-top: .55rem;
        font-size: .86rem;
    }

    .mq-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-top: 2rem;
    }

    .mq-panel.is-active .mq-question-row,
    .mq-panel.is-back .mq-question-row {
        animation: mqQuestionIn .5s cubic-bezier(.18, 1.2, .32, 1) both;
    }

    .mq-panel.is-active .mq-card,
    .mq-panel.is-back .mq-card {
        animation: mqCardIn .5s cubic-bezier(.18, 1.18, .32, 1) .05s both;
    }

    .mq-panel.is-active .mq-actions,
    .mq-panel.is-back .mq-actions {
        animation: mqActionsIn .38s ease .18s both;
    }

    .mq-panel.is-active .mq-choice,
    .mq-panel.is-back .mq-choice {
        animation: mqChoiceIn .44s cubic-bezier(.18, 1.35, .32, 1) both;
    }

    .mq-panel.is-active .mq-choice-grid input:nth-of-type(1) + .mq-choice,
    .mq-panel.is-back .mq-choice-grid input:nth-of-type(1) + .mq-choice { animation-delay: .05s; }
    .mq-panel.is-active .mq-choice-grid input:nth-of-type(2) + .mq-choice,
    .mq-panel.is-back .mq-choice-grid input:nth-of-type(2) + .mq-choice { animation-delay: .1s; }
    .mq-panel.is-active .mq-choice-grid input:nth-of-type(3) + .mq-choice,
    .mq-panel.is-back .mq-choice-grid input:nth-of-type(3) + .mq-choice { animation-delay: .15s; }
    .mq-panel.is-active .mq-choice-grid input:nth-of-type(4) + .mq-choice,
    .mq-panel.is-back .mq-choice-grid input:nth-of-type(4) + .mq-choice { animation-delay: .2s; }
    .mq-panel.is-active .mq-choice-grid input:nth-of-type(5) + .mq-choice,
    .mq-panel.is-back .mq-choice-grid input:nth-of-type(5) + .mq-choice { animation-delay: .25s; }

    .mq-panel.is-active .mq-chip,
    .mq-panel.is-back .mq-chip {
        animation: mqChipIn .36s cubic-bezier(.18, 1.25, .32, 1) both;
    }

    .mq-panel.is-active .mq-chip:nth-child(1),
    .mq-panel.is-back .mq-chip:nth-child(1) { animation-delay: .12s; }
    .mq-panel.is-active .mq-chip:nth-child(2),
    .mq-panel.is-back .mq-chip:nth-child(2) { animation-delay: .16s; }
    .mq-panel.is-active .mq-chip:nth-child(3),
    .mq-panel.is-back .mq-chip:nth-child(3) { animation-delay: .2s; }
    .mq-panel.is-active .mq-chip:nth-child(4),
    .mq-panel.is-back .mq-chip:nth-child(4) { animation-delay: .24s; }

    .mq-actions-end {
        justify-content: flex-end;
    }

    [data-next-template],
    [data-submit-template],
    .mq-panel button[type="submit"]:not(.mq-final-submit) {
        display: none !important;
    }

    .mq-submit-action {
        justify-content: center;
    }

    @@keyframes mqReveal {
        from {
            opacity: 0;
            transform: translateY(22px) scale(.97);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes mqRevealBack {
        from {
            opacity: 0;
            transform: translateY(-18px) scale(.97);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes mqLeave {
        from {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
        to {
            opacity: 0;
            transform: translateY(-16px) scale(.985);
        }
    }

    @@keyframes mqLeaveBack {
        from {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
        to {
            opacity: 0;
            transform: translateY(14px) scale(.985);
        }
    }

    @@keyframes mqQuestionIn {
        from {
            opacity: 0;
            transform: translateY(18px) scale(.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes mqCardIn {
        from {
            opacity: 0;
            transform: translateY(18px) scale(.97);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes mqActionsIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes mqChoiceIn {
        from {
            opacity: 0;
            transform: translateY(16px) scale(.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes mqChipIn {
        from {
            opacity: 0;
            transform: translateY(12px) scale(.92);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes mqChipPop {
        0% {
            transform: translateY(-3px) scale(1);
        }
        55% {
            transform: translateY(-5px) scale(1.08);
        }
        100% {
            transform: translateY(-3px) scale(1);
        }
    }

    @@keyframes mqSelect {
        0% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.05);
        }
        100% {
            transform: scale(1.03);
        }
    }

    [data-theme="dark"] .mq-form {
        background: linear-gradient(180deg, rgba(var(--color-surface-rgb), .96), rgba(var(--color-surface-2-rgb), .92));
        box-shadow: 0 24px 56px rgba(0,0,0,.28);
    }

    [data-theme="dark"] .mq-card,
    [data-theme="dark"] .mq-choice {
        background: rgba(var(--color-surface-rgb), .82);
    }

    @@media (max-width: 991.98px) {
        .mq-form {
            width: min(100%, 760px);
        }

        .mq-choice-grid-4,
        .mq-choice-grid-5 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .mq-shell {
            padding-top: .75rem;
        }

        .mq-form {
            padding: 1.1rem;
            border-radius: 20px;
            min-height: auto;
        }

        .mq-question-row {
            margin-bottom: 1rem;
        }

        .mq-question {
            font-size: clamp(1.55rem, 7.5vw, 2rem);
        }

        .mq-card {
            padding: 1rem;
            border-radius: 20px;
        }

        .mq-input {
            min-height: 82px;
            font-size: clamp(1.85rem, 12vw, 3rem) !important;
        }

        .mq-choice-grid-3,
        .mq-choice-grid-4,
        .mq-choice-grid-5 {
            grid-template-columns: 1fr;
        }

        .mq-choice {
            min-height: 72px;
            flex-direction: row;
            justify-content: flex-start;
            text-align: left;
            padding: .75rem .85rem;
            border-radius: 18px;
        }

        .mq-scale-choice {
            min-height: 72px;
        }

        .mq-face {
            width: 42px;
            height: 42px;
        }

        .mq-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .mq-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="container mq-shell">
    @if (!Model.CanCreateMeasurement)
    {
        <div class="mq-limit-card" role="alert">
            <h2 class="mq-limit-title">@Localizer["limitReachedTitle"]</h2>
            <p class="mq-limit-copy">
                @string.Format(Localizer["limitReachedCopy"].Value, Model.MeasurementLimit, Model.MeasurementCount)
                @Localizer["premiumNoLimit"]
            </p>
            <button type="button"
                    class="mq-premium-button"
                    data-bs-toggle="modal"
                    data-bs-target="#premiumModal">
                @Localizer["viewPremium"]
            </button>
        </div>
    }
    else if (Model.IsEditingTodayMeasurement)
    {
        <div class="mq-limit-card">
            <h2 class="mq-limit-title">@Localizer["editingTodayTitle"]</h2>
            <p class="mq-limit-copy">
                @Localizer["editingTodayCopy"]
