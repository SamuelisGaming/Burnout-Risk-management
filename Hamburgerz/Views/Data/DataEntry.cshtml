
@{
    ViewData["Title"] = "DataEntry";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Burnout Risk Tracker</h2>
        </div>
        <div class="card-body">
            <p class="text-muted">Enter your weekly averages to see your balance.</p>
            <hr />

            <form asp-action="SubmitData" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label font-weight-bold">Daily Sleep (Hours)</label>
                        <input type="number" class="form-control" name="DailySleep" placeholder="e.g. 7" step="0.5" required>
                        <small class="text-muted">Average hours per night.</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label font-weight-bold">Weekly Work (Hours)</label>
                        <input type="number" class="form-control" name="WeeklyWork" placeholder="e.g. 40" required>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label font-weight-bold">Social/Family Time (Weekly Hours)</label>
                        <input type="number" class="form-control" name="SocialTime" placeholder="e.g. 15" required>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label font-weight-bold">Weekly Commute (Hours)</label>
                        <input type="number" class="form-control" name="CommuteTime" placeholder="e.g. 5">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label font-weight-bold">Current Stress Level (1-10)</label>
                    <input type="range" class="form-range" min="1" max="10" name="StressLevel" id="stressRange">
                    <div class="d-flex justify-content-between">
                        <span>Low</span>
                        <span>High</span>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg">Analyze My Risk</button>
                    <a href="/" class="btn btn-outline-secondary">Back to Dashboard</a>
                </div>
            </form>
        </div>
    </div>
</div>

