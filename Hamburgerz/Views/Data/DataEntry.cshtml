@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.querySelector("[data-measurement-wizard]");
            if (!form) return;

            const collectPanels = function () {
                const panelNodes = Array.from(form.querySelectorAll("[data-step-panel]"));
                if (panelNodes.length < 2) return panelNodes;

                return panelNodes
                    .map(function (panel) {
                        return {
                            panel: panel,
                            index: Number.parseInt(panel.getAttribute("data-step-panel") || "0", 10) || 0
                        };
                    })
                    .sort(function (left, right) {
                        return left.index - right.index;
                    })
                    .map(function (item) { return item.panel; });
            };

            const panels = collectPanels();
            const progressFill = form.querySelector("[data-progress-fill]");
            const stepCaption = form.querySelector("[data-step-caption]");
            const nextTemplate = form.querySelector("[data-next-template]");
            const submitTemplate = form.querySelector("[data-submit-template]");
            const chipTargets = ["WorkHours", "MeetingsPerDay", "SleepHours", "ExerciseHours", "ScreenTime"];
            let currentStep = 0;
            let autoAdvanceTimer = 0;
            let transitionTimer = 0;
            let finalSubmitButton = null;

            const ensurePanelActions = function () {
                if (!nextTemplate) return;

                panels.forEach(function (panel) {
                    const actions = panel.querySelector(".mq-actions");
                    if (!actions || actions.querySelector("[data-step-next]")) return;

                    const nextButton = nextTemplate.cloneNode(true);
                    nextButton.hidden = false;
                    nextButton.removeAttribute("data-next-template");
                    nextButton.setAttribute("data-step-next", "");
                    actions.appendChild(nextButton);
                });

                form.querySelectorAll("[data-step-next]").forEach(function (button) {
                    button.classList.add("mq-next-action");
                });
            };

            ensurePanelActions();

            const updateChips = function (fieldId) {
                const input = document.getElementById(fieldId);
                if (!input) return;
                const value = (input.value || "").trim();
                form.querySelectorAll('[data-chip-target="' + fieldId + '"]').forEach(function (chip) {
                    chip.classList.toggle("is-active", chip.getAttribute("data-chip-value") === value);
                });
            };

            const validateStep = function (index, report) {
                const panel = panels[index];
                if (!panel) return true;
                const fields = Array.from(panel.querySelectorAll("input, select, textarea"));

                // Validate required radio groups explicitly — checkValidity() is inconsistent
                // across browsers for radio inputs when no option in the group is selected.
                const checkedGroups = new Set();
                const requiredGroups = new Set();
                for (const field of fields) {
                    if (!(field instanceof HTMLElement) || field.getAttribute("type") !== "radio") continue;
                    if (!field.name) continue;
                    if (field.hasAttribute("required")) requiredGroups.add(field.name);
                    if (field.checked) checkedGroups.add(field.name);
                }
                for (const groupName of requiredGroups) {
                    if (!checkedGroups.has(groupName)) {
                        if (report) {
                            const firstUnchecked = panel.querySelector('input[type="radio"][name="' + groupName + '"]');
                            if (firstUnchecked instanceof HTMLElement && typeof firstUnchecked.reportValidity === "function") {
                                firstUnchecked.reportValidity();
                            }
                        }
                        return false;
                    }
                }

                // Validate all other fields
                for (const field of fields) {
                    if (!(field instanceof HTMLElement)) continue;
                    if (field.getAttribute("type") === "radio") continue;
                    if (field.hasAttribute("disabled") || field.getAttribute("type") === "hidden") continue;
                    if (!field.name) continue;
                    if (typeof field.checkValidity === "function" && !field.checkValidity()) {
                        if (report && typeof field.reportValidity === "function") field.reportValidity();
                        return false;
                    }
                }

                return true;
            };

            const getServerErrorStep = function () {
                const invalidField = form.querySelector(".input-validation-error, [aria-invalid='true']");
                if (!invalidField) return -1;
                const panel = invalidField.closest("[data-step-panel]");
                if (!(panel instanceof HTMLElement)) return -1;
                return panels.indexOf(panel);
            };

            const updateProgress = function () {
                if (stepCaption) stepCaption.textContent = (currentStep + 1) + " / " + panels.length;
                if (progressFill) progressFill.style.width = (((currentStep + 1) / panels.length) * 100) + "%";
            };

            const focusStepInput = function (panel) {
                if (!window.matchMedia || !window.matchMedia("(min-width: 768px)").matches) return;
                const input = panel.querySelector('input:not([type="hidden"]):not([type="radio"]), textarea, select');
                if (input instanceof HTMLElement) {
                    window.setTimeout(function () { input.focus({ preventScroll: true }); }, 180);
                }
            };

            const syncFinalAction = function () {
                const activePanel = panels[currentStep];
                const isFinalStep = currentStep === panels.length - 1;

                form.querySelectorAll("[data-step-next]").forEach(function (button) {
                    button.hidden = false;
                });

                if (!submitTemplate) return;

                if (!finalSubmitButton) {
                    finalSubmitButton = submitTemplate.cloneNode(true);
                    finalSubmitButton.hidden = false;
                    finalSubmitButton.removeAttribute("data-submit-template");
                    finalSubmitButton.classList.add("mq-final-submit");
                }

                finalSubmitButton.hidden = !isFinalStep;

                if (!isFinalStep || !activePanel) return;

                const actions = activePanel.querySelector(".mq-actions");
                if (!actions) return;

                activePanel.querySelectorAll("[data-step-next]").forEach(function (button) {
                    button.hidden = true;
                });

                if (!actions.contains(finalSubmitButton)) {
                    actions.appendChild(finalSubmitButton);
                }
            };

            const renderStep = function (index, goingBack) {
                panels.forEach(function (panel, i) {
                    panel.classList.remove("is-active", "is-back", "is-exiting", "is-exiting-back");
                    if (i === index) {
                        panel.classList.add(goingBack ? "is-back" : "is-active");
                        focusStepInput(panel);
                    }
                });

                updateProgress();
                syncFinalAction();
                form.scrollIntoView({ behavior: "smooth", block: "start" });
            };

            const goToStep = function (index, dir) {
                window.clearTimeout(autoAdvanceTimer);
                window.clearTimeout(transitionTimer);

                const targetStep = Math.max(0, Math.min(index, panels.length - 1));
                const previousStep = currentStep;
                const goingBack = dir === "back" || (dir === undefined && targetStep < previousStep);

                if (targetStep === currentStep) {
                    renderStep(targetStep, goingBack);
                    return;
                }

                const previousPanel = panels[previousStep];
                currentStep = targetStep;
                updateProgress();

                if (previousPanel) {
                    previousPanel.classList.remove("is-active", "is-back", "is-exiting", "is-exiting-back");
                    previousPanel.classList.add(goingBack ? "is-exiting-back" : "is-exiting");
                }

                transitionTimer = window.setTimeout(function () {
                    renderStep(currentStep, goingBack);
                }, 150);
            };

            const pulseChoice = function (radio) {
                const panel = radio.closest("[data-step-panel]");
                if (!panel) return;

                panel.querySelectorAll(".mq-choice").forEach(function (choice) {
                    choice.classList.remove("is-choice-pending");
                });

                const label = radio.nextElementSibling;
                if (label instanceof HTMLElement && label.classList.contains("mq-choice")) {
                    label.classList.add("is-choice-pending");
                    window.setTimeout(function () {
                        label.classList.remove("is-choice-pending");
                    }, 280);
                }
            };

            const pulseChip = function (chip) {
                chip.classList.remove("is-chip-pending");
                void chip.offsetWidth;
                chip.classList.add("is-chip-pending");
                window.setTimeout(function () {
                    chip.classList.remove("is-chip-pending");
                }, 320);
            };

            const scheduleAutoAdvance = function (source, delay) {
                window.clearTimeout(autoAdvanceTimer);

                if (currentStep >= panels.length - 1) return;

                autoAdvanceTimer = window.setTimeout(function () {
                    const panel = panels[currentStep];
                    if (!panel || !panel.contains(source)) return;
                    if (validateStep(currentStep, false)) goToStep(currentStep + 1, "forward");
                }, delay);
            };

            form.querySelectorAll("[data-step-next]").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    if (validateStep(currentStep, true)) goToStep(currentStep + 1, "forward");
                });
            });

            form.querySelectorAll("[data-step-prev]").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    goToStep(currentStep - 1, "back");
                });
            });

            form.querySelectorAll('.mq-choice-grid input[type="radio"]').forEach(function (radio) {
                radio.addEventListener("change", function () {
                    pulseChoice(radio);
                    scheduleAutoAdvance(radio, 330);
                });
            });

            form.querySelectorAll("[data-chip-target]").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    const fieldId = btn.getAttribute("data-chip-target");
                    const value = btn.getAttribute("data-chip-value");
                    const input = fieldId ? document.getElementById(fieldId) : null;
                    if (!input) return;
                    input.value = value || "";
                    input.dispatchEvent(new Event("input", { bubbles: true }));
                    input.dispatchEvent(new Event("change", { bubbles: true }));
                    updateChips(fieldId);
                    pulseChip(btn);
                    scheduleAutoAdvance(btn, 360);
                });
            });

            chipTargets.forEach(function (fieldId) {
                const input = document.getElementById(fieldId);
                if (!input) return;
                input.addEventListener("input", function () { updateChips(fieldId); });
                input.addEventListener("change", function () { updateChips(fieldId); });
                updateChips(fieldId);
            });

            form.addEventListener("keydown", function (event) {
                if (event.key !== "Enter") return;
                const target = event.target;
                if (!(target instanceof HTMLElement) || target.tagName === "TEXTAREA") return;
                if (currentStep < panels.length - 1) {
                    event.preventDefault();
                    if (validateStep(currentStep, true)) goToStep(currentStep + 1, "forward");
                }
            });

            form.addEventListener("submit", function (event) {
                for (let i = 0; i < panels.length; i++) {
                    if (!validateStep(i, false)) {
                        event.preventDefault();
                        goToStep(i, "forward");
                        window.setTimeout(function () { validateStep(i, true); }, 0);
                        return;
                    }
                }
            });

            const serverErrorStep = getServerErrorStep();
            currentStep = Math.max(0, Math.min(serverErrorStep >= 0 ? serverErrorStep : 0, panels.length - 1));
            if (currentStep === 0) {
                updateProgress();
                syncFinalAction();
                if (panels[currentStep]) focusStepInput(panels[currentStep]);
            } else {
                renderStep(currentStep, false);
            }
        });
    </script>
}
