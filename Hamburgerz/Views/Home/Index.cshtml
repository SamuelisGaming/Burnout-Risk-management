@model Hamburgerz.Models.HomePageViewModel

@{
    ViewData["Title"] = "Pagrindinis";
}

<div class="home-page">
    @if (!Model.IsLoggedIn)
    {
        <section class="guest-hero panel-card animate-in">
            <div class="hero-kicker">Burnout risk management</div>
            <h1 class="guest-title">Stebėk perdegimo riziką ne iš nuojautos, o iš savo duomenų.</h1>
            <p class="guest-copy">
                Kuo nuosekliau pildomi matavimai, tuo aiškiau pradeda matytis tendencijos: miegas, darbo krūvis, stresas ir jų pokyčiai laike.
            </p>

            <div class="hero-actions">
                <a asp-controller="Login" asp-action="Index" class="btn btn-primary btn-lg">Prisijungti</a>
                <a asp-controller="Register" asp-action="Index" class="btn btn-outline-primary btn-lg">Registruotis</a>
            </div>
        </section>

        <div class="guest-grid animate-in delay-1">
            <article class="panel-card guest-card">
                <div class="card-kicker">Daily check-in</div>
                <h2>Trumpi matavimai</h2>
                <p>Greitas įrašas leidžia ne tik įvertinti šiandieną, bet ir susikurti normalią istoriją ateičiai.</p>
            </article>

            <article class="panel-card guest-card">
                <div class="card-kicker">History</div>
                <h2>Visa eiga vienoje vietoje</h2>
                <p>Aiškiai matysi, kada darei matavimus, ir galėsi greitai atsiversti konkretų įrašą.</p>
            </article>

            <article class="panel-card guest-card">
                <div class="card-kicker">Analysis</div>
                <h2>Tendencijos, ne tik skaičiai</h2>
                <p>Kai duomenų prisikaupia daugiau, analysis pradeda rodyti, kaip keičiasi tavo rutina ir rizikos signalai.</p>
            </article>
        </div>
    }
    else
    {
        <div class="hero-layout">
            <section class="hero-main panel-card animate-in">
                <div class="hero-kicker">Dienos apžvalga</div>
                <h1 class="hero-title">Labas, @Model.DisplayName</h1>
                <p class="hero-copy">
                    Paskutinio matavimo ir šiandienos statuso suvestinė.
                </p>

                <div class="hero-badges">
                    <span class="hero-badge">Matavimų iš viso: @Model.MeasurementCount</span>
                    <span class="hero-badge">Šią savaitę: @Model.MeasurementsThisWeek</span>
                    <span class="hero-badge">Šį mėnesį: @Model.MeasurementsThisMonth</span>
                </div>
            </section>

            <aside class="status-card panel-card @Model.StatusClass animate-in delay-1">
                <div class="status-pill">Šiandienos būsena</div>
                <h2>@Model.StatusTitle</h2>
                <p>@Model.StatusText</p>

                <div class="status-meta-list">
                    <div class="status-meta">
                        <span>Paskutinis check-in</span>
                        <strong>@Model.LastMeasurementDateTimeLabel</strong>
                    </div>

                    <div class="status-meta">
                        <span>Būsena</span>
                        <strong>@Model.LastMeasurementRelativeLabel</strong>
                    </div>
                </div>

                <a asp-controller="Data" asp-action="DataEntry" class="status-btn">
                    @(Model.HasMeasurementToday ? "Atnaujinti matavimą" : "Pasidaryti matavimą")
                </a>
            </aside>
        </div>
    }
</div>

<style>
    body {
        background:
            radial-gradient(circle at 78% 12%, rgba(var(--color-secondary-rgb), 0.14), transparent 18%),
            radial-gradient(circle at 86% 30%, rgba(var(--color-secondary-rgb), 0.09), transparent 22%),
            linear-gradient(180deg, #ffffff 0%, #fffef9 42%, #ffffff 100%);
        background-attachment: fixed;
    }

    .home-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 36px 0 44px;
    }

    .panel-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 24px;
        box-shadow: var(--shadow-md);
        overflow: hidden;
    }

    .animate-in {
        opacity: 0;
        transform: translateY(16px);
        animation: homeFadeUp 0.55s ease forwards;
    }

    .delay-1 {
        animation-delay: 0.06s;
    }

    .delay-2 {
        animation-delay: 0.12s;
    }

    .delay-3 {
        animation-delay: 0.18s;
    }

    .delay-4 {
        animation-delay: 0.24s;
    }

    .guest-hero,
    .hero-main {
        padding: 34px;
        background:
            radial-gradient(circle at top right, rgba(var(--color-secondary-rgb), 0.18), transparent 26%),
            radial-gradient(circle at bottom left, rgba(var(--color-primary-rgb), 0.14), transparent 24%),
            linear-gradient(135deg, var(--color-surface) 0%, var(--color-bg) 100%);
    }

    .hero-kicker,
    .card-kicker {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 800;
        color: var(--color-primary);
        margin-bottom: 10px;
    }

    .guest-title,
    .hero-title {
        margin: 0;
        font-size: clamp(34px, 5vw, 52px);
        font-weight: 900;
        line-height: 1.02;
        color: var(--color-text);
        max-width: 720px;
    }

    .guest-copy,
    .hero-copy {
        margin: 18px 0 0 0;
        max-width: 760px;
        font-size: 16px;
        line-height: 1.7;
        color: var(--color-text-muted);
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    .guest-grid {
        margin-top: 18px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    .guest-card {
        padding: 24px;
    }

    .guest-card h2 {
        margin: 0 0 12px 0;
        font-size: 22px;
        font-weight: 800;
    }

    .guest-card p {
        margin: 0;
        color: var(--color-text-muted);
        line-height: 1.7;
    }

    .hero-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) minmax(320px, 0.9fr);
        gap: 18px;
        align-items: stretch;
    }

    .hero-main,
    .status-card {
        min-height: 370px;
    }

    .hero-main {
        display: flex;
        flex-direction: column;
    }

    .hero-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: auto;
        padding-top: 28px;
    }

    .hero-badge {
        padding: 9px 14px;
        border-radius: 999px;
        border: 1px solid rgba(var(--color-primary-rgb), 0.14);
        background: rgba(var(--color-primary-rgb), 0.08);
        color: var(--color-text);
        font-size: 13px;
        font-weight: 700;
    }

    .status-card {
        padding: 28px;
        color: var(--color-text);
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .status-card h2 {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        line-height: 1.1;
    }

    .status-card p {
        margin: 0;
        color: var(--color-text-muted);
        line-height: 1.7;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .status-fresh {
        background:
            radial-gradient(circle at 108% -4%, rgba(34, 197, 94, 0.12), transparent 34%),
            radial-gradient(circle at 94% 16%, rgba(var(--color-secondary-rgb), 0.12), transparent 40%),
            linear-gradient(160deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.88) 100%);
    }

    .status-stale {
        background:
            radial-gradient(circle at 108% -4%, rgba(var(--color-secondary-rgb), 0.18), transparent 34%),
            radial-gradient(circle at 94% 16%, rgba(var(--color-secondary-rgb), 0.10), transparent 40%),
            linear-gradient(160deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.88) 100%);
    }

    .status-empty {
        background:
            radial-gradient(circle at 108% -4%, rgba(var(--color-secondary-rgb), 0.16), transparent 34%),
            radial-gradient(circle at bottom left, rgba(var(--color-primary-rgb), 0.10), transparent 28%),
            linear-gradient(160deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.88) 100%);
    }

    .status-meta-list {
        display: grid;
        gap: 12px;
        margin-top: 4px;
    }

    .status-meta {
        display: grid;
        gap: 4px;
        padding: 14px 16px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.78);
        border: 1px solid var(--color-border);
        backdrop-filter: blur(8px);
    }

    .status-meta span {
        font-size: 12px;
        color: var(--color-text-muted);
        font-weight: 700;
    }

    .status-meta strong {
        font-size: 16px;
        color: var(--color-text);
        font-weight: 800;
    }

    .status-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 18px;
        border-radius: 16px;
        background: var(--color-primary);
        color: var(--color-button-primary-text);
        text-decoration: none;
        font-weight: 800;
        margin-top: auto;
        transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }

    .status-btn:hover {
        background: var(--color-button-primary-hover);
        color: var(--color-button-primary-text);
        transform: translateY(-1px);
        box-shadow: var(--shadow-md);
    }

    @@keyframes homeFadeUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 1100px) {
        .guest-grid {
            grid-template-columns: 1fr 1fr;
        }

        .hero-layout {
            grid-template-columns: 1fr;
        }

        .hero-main,
        .status-card {
            min-height: 0;
        }
    }

    @@media (max-width: 768px) {
        .home-page {
            padding: 12px 0 36px;
        }

        .guest-hero,
        .hero-main,
        .status-card {
            padding: 20px;
        }

        .guest-title,
        .hero-title {
            font-size: 32px;
        }

        .guest-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
