                                 asp-append-version="true"
                                 alt="@LayoutLocalizer["logoAlt"].Value"
                                 class="app-brand-mark" />
                            <span class="app-brand-text">Hamburgerz</span>
                        </a>

                        <div class="dropdown ms-auto">
                            <button class="btn nav-lang-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="nav-lang-flag settings-language-flag @(isLt ? "settings-language-flag--lt" : "settings-language-flag--en")"></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end nav-lang-dropdown">
                                <li>
                                    <button type="button" class="dropdown-item nav-lang-item settings-language-option @(isLt ? "is-active" : "")" data-lang="lt-LT">
                                        <span class="settings-language-flag settings-language-flag--lt nav-lang-flag-sm"></span>
                                        <span>Lietuvių</span>
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item nav-lang-item settings-language-option @(!isLt ? "is-active" : "")" data-lang="en-US">
                                        <span class="settings-language-flag settings-language-flag--en nav-lang-flag-sm"></span>
                                        <span>English</span>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="w-100 d-flex align-items-center justify-content-between">

                            <div style="min-width: 180px;">
                                <a class="navbar-brand app-brand mb-0" asp-area="" asp-controller="Home" asp-action="Index">
                                    <img src="~/assets/hamburgerz_logo.png"
                                         asp-append-version="true"
                                         alt="@LayoutLocalizer["logoAlt"].Value"
                                         class="app-brand-mark" />
                                    <span class="app-brand-text">Hamburgerz</span>
                                </a>
                            </div>

                            <div class="d-flex justify-content-center flex-grow-1">
                                <ul class="navbar-nav d-flex flex-row gap-4">
                                    <li class="nav-item">
                                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">@LayoutLocalizer["home"]</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-area="" asp-controller="Profile" asp-action="History">@LayoutLocalizer["history"]</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-area="" asp-controller="Profile" asp-action="Analysis">@LayoutLocalizer["analysis"]</a>
                                    </li>
                                    @if (isAdmin)
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Dashboard">@LayoutLocalizer["admin"]</a>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="d-flex justify-content-end align-items-center" style="min-width: 180px;">
                                <div class="dropdown">
                                    <button class="btn profile-avatar-btn"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            aria-label="@LayoutLocalizer["profileMenu"].Value">
                                        <div class="profile-avatar" data-avatar-root>
                                            <img class="profile-avatar-image" data-avatar-image alt="@LayoutLocalizer["profilePhoto"].Value" hidden />
                                            <span class="profile-avatar-fallback" data-avatar-fallback>@userInitial</span>
                                        </div>
                                    </button>

                                     <ul class="dropdown-menu dropdown-menu-end profile-dropdown">
                                         <li>
                                             <a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index">
                                                 <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                                                 @LayoutLocalizer["profile"]
                                             </a>
                                         </li>
                                         <li>
                                             <button type="button"
                                                     class="dropdown-item"
                                                     data-settings-open
                                                     data-settings-modal-target="#settingsModal"
                                                     aria-controls="settingsModal">
                                                 <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                                                 @LayoutLocalizer["settings"]
                                             </button>
                                         </li>
                                         <li>
                                             <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#bugReportModal">
                                                 <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h8M8 10h8M8 14h4"/><path d="M4 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16l-4-2-4 2-4-2-4 2V4z"/></svg>
                                                 @LayoutLocalizer["reportBug"]
                                             </button>
                                         </li>
                                         <li><hr class="dropdown-divider" /></li>
                                         <li>
                                             <a class="dropdown-item text-danger" asp-area="" asp-controller="Login" asp-action="Logout">
                                                 <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                                 @LayoutLocalizer["logout"]
                                             </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                        </div>
                    }
                </div>
            </nav>
        </header>

        @if (TempData["ToastSuccess"] != null)
        {
            <div id="appToast" class="app-toast app-toast-success" role="status" aria-live="polite">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="app-toast-icon"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                <span>@TempData["ToastSuccess"]</span>
                <button type="button" class="app-toast-close" aria-label="Uždaryti">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m18 6-12 12M6 6l12 12"/></svg>
                </button>
            </div>
        }

        <div class="container app-main-shell">
            <main role="main" class="app-main-content pb-3">
                @RenderBody()
            </main>
        </div>
        

        <footer class="border-top footer">
            <div class="container">
                &copy; 2026 - Hamburgerz - <a asp-area="" asp-controller="Home" asp-action="About">@LayoutLocalizer["about"]</a>
                 - <a asp-area="" asp-controller="Home" asp-action="Privacy">@LayoutLocalizer["privacy"]</a>
            </div>
        </footer>

    </div>

    @if (isLoggedIn)
    {
        <div class="modal fade app-modal" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <div class="app-modal-kicker">@LayoutLocalizer["appearance"]</div>
                            <h2 class="modal-title fs-5" id="settingsModalLabel">@LayoutLocalizer["settings"]</h2>
                        </div>

                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@LayoutLocalizer["close"].Value"></button>
                    </div>

                    <div class="modal-body">
                        <div class="settings-card">
                            <div class="settings-toggle-row">
                                <div>
                                    <div class="settings-item-title">@LayoutLocalizer["darkMode"]</div>
                                    <p class="settings-item-copy">
                                        @LayoutLocalizer["darkModeCopy"]
                                    </p>
                                </div>

                                <div class="form-check form-switch app-switch">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="themeModeSwitch"
                                           data-theme-toggle
                                           aria-label="@LayoutLocalizer["darkModeToggle"].Value"
                                           aria-describedby="themeModeHint" />
                                </div>
                            </div>

                            <div class="settings-meta">
                                <span class="settings-theme-badge" data-theme-value>@LayoutLocalizer["themeLight"]</span>
                                <span id="themeModeHint">@LayoutLocalizer["themeSaved"]</span>
                            </div>
                        </div>

                        <div class="settings-card settings-card-spaced">
                            <div class="settings-item-title">@LayoutLocalizer["languages"]</div>
                            <p class="settings-item-copy">
                                @LayoutLocalizer["languagesCopy"]
                            </p>

                            @* <div class="settings-language-strip" aria-label="Galimos kalbos">
                                <button type="button" class="settings-language-option is-active" aria-pressed="true">
                                    <span class="settings-language-flag settings-language-flag--lt" aria-hidden="true"></span>
                                    <span class="settings-language-label">Lietuvių</span>
                                </button>

                                <button type="button" class="settings-language-option" aria-pressed="false">
                                    <span class="settings-language-flag settings-language-flag--en" aria-hidden="true"></span>
                                    <span class="settings-language-label">English</span>
                                </button>

                                <button type="button" class="settings-language-option" aria-pressed="false">
                                    <span class="settings-language-flag settings-language-flag--es" aria-hidden="true"></span>
                                    <span class="settings-language-label">Español</span>
                                </button>

                                <button type="button" class="settings-language-option" aria-pressed="false">
                                    <span class="settings-language-flag settings-language-flag--de" aria-hidden="true"></span>
                                    <span class="settings-language-label">Deutsch</span>
                                </button>
                            </div> *@

                            <div class="settings-language-strip" aria-label="@LayoutLocalizer["availableLanguages"].Value">
                                <button type="button" class="settings-language-option" data-lang="lt-LT">
                                    <span class="settings-language-flag settings-language-flag--lt"></span>
                                    <span class="settings-language-label">Lietuvių</span>
                                </button>

                                <button type="button" class="settings-language-option" data-lang="en-US">
                                    <span class="settings-language-flag settings-language-flag--en"></span>
                                    <span class="settings-language-label">English</span>
                                </button>
                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (isLoggedIn)
    {
        <div class="modal fade app-modal" id="bugReportModal" tabindex="-1" aria-labelledby="bugReportModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <div class="app-modal-kicker">@LayoutLocalizer["reportBugKicker"]</div>
                            <h2 class="modal-title fs-5" id="bugReportModalLabel">@LayoutLocalizer["reportBug"]</h2>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@LayoutLocalizer["close"].Value"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@LayoutLocalizer["reportTopic"]</label>
                            <div class="bug-topic-grid" id="bugTopicGrid">
                                <button type="button" class="bug-topic-btn" data-topic="ui">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                                    @LayoutLocalizer["reportTopicUI"]
                                </button>
                                <button type="button" class="bug-topic-btn" data-topic="data">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/></svg>
                                    @LayoutLocalizer["reportTopicData"]
                                </button>
                                <button type="button" class="bug-topic-btn" data-topic="analysis">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                                    @LayoutLocalizer["reportTopicAnalysis"]
                                </button>
                                <button type="button" class="bug-topic-btn" data-topic="account">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                                    @LayoutLocalizer["reportTopicAccount"]
                                </button>
                                <button type="button" class="bug-topic-btn" data-topic="performance">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                                    @LayoutLocalizer["reportTopicPerformance"]
                                </button>
                                <button type="button" class="bug-topic-btn" data-topic="other">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                                    @LayoutLocalizer["reportTopicOther"]
                                </button>
                            </div>
                        </div>
                        <div class="mb-1">
                            <label for="bugReportText" class="form-label fw-semibold">@LayoutLocalizer["reportDescription"]</label>
                            <textarea id="bugReportText" class="form-control bug-report-textarea" rows="4" placeholder="@LayoutLocalizer["reportPlaceholder"].Value"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bug-report-footer">
                        <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">@LayoutLocalizer["cancel"]</button>
                        <button type="button" class="btn btn-primary" id="bugReportSend">@LayoutLocalizer["reportSend"]</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (isLoggedIn && !hasPremiumFeatures)
    {
        <div class="modal fade app-modal" id="premiumModal" tabindex="-1" aria-labelledby="premiumModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <div class="premium-modal-kicker">@LayoutLocalizer["premium"]</div>
                            <h2 class="modal-title fs-5" id="premiumModalLabel">@LayoutLocalizer["premiumTitle"]</h2>
                        </div>

                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@LayoutLocalizer["close"].Value"></button>
                    </div>

                    <div class="modal-body">
                        <p class="settings-item-copy">
                            @LayoutLocalizer["premiumCopy"]
                        </p>

                        <ul class="premium-benefits">
                            <li>@LayoutLocalizer["premiumBenefitMeasurements"]</li>
                            <li>@LayoutLocalizer["premiumBenefitAi"]</li>
                            <li>@LayoutLocalizer["premiumBenefitHistory"]</li>
                        </ul>

                        <form asp-controller="Profile" asp-action="UpgradeToPremium" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                            <button type="submit" class="premium-purchase-btn">@LayoutLocalizer["premiumBuy"]</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var toast = document.getElementById("appToast");
            if (!toast) return;

            function dismiss() {
                toast.classList.add("is-hiding");
                toast.addEventListener("animationend", function () { toast.remove(); }, { once: true });
            }

            setTimeout(dismiss, 4000);
            toast.querySelector(".app-toast-close").addEventListener("click", dismiss);
        })();
    </script>
    <script>
        (function () {
            var grid = document.getElementById('bugTopicGrid');
            var sendBtn = document.getElementById('bugReportSend');
            if (!grid || !sendBtn) return;

            grid.addEventListener('click', function (e) {
                var btn = e.target.closest('.bug-topic-btn');
                if (!btn) return;
                grid.querySelectorAll('.bug-topic-btn').forEach(function (b) { b.classList.remove('is-selected'); });
                btn.classList.add('is-selected');
            });

            sendBtn.addEventListener('click', function () {
                var selectedBtn = grid ? grid.querySelector('.bug-topic-btn.is-selected') : null;
                var topic = selectedBtn ? (selectedBtn.textContent || '').trim() : 'Other';
                var description = (document.getElementById('bugReportText').value || '').trim();

                var deviceInfo = [
                    'Browser: ' + navigator.userAgent,
                    'Language: ' + navigator.language,
                    'Screen: ' + screen.width + 'x' + screen.height,
                    'Viewport: ' + window.innerWidth + 'x' + window.innerHeight,
                    'URL: ' + window.location.href,
                    'Time: ' + new Date().toISOString()
                ].join('\n');

                var modal = bootstrap.Modal.getInstance(document.getElementById('bugReportModal'));
                if (modal) modal.hide();

                document.getElementById('bugReportText').value = '';
                if (grid) grid.querySelectorAll('.bug-topic-btn').forEach(function (b) { b.classList.remove('is-selected'); });

                var token = document.querySelector('meta[name="csrf-token"]') || document.querySelector('input[name="__RequestVerificationToken"]');
                var tokenValue = token ? (token.getAttribute('content') || token.value) : '';

                var form = new FormData();
                form.append('topic', topic);
                form.append('description', description);
                form.append('deviceInfo', deviceInfo);
                form.append('__RequestVerificationToken', tokenValue);

                fetch('/BugReport/Submit', { method: 'POST', body: form }).catch(function () {});

                var old = document.getElementById('bugSentToast');
                if (old) old.remove();

                var toast = document.createElement('div');
                toast.id = 'bugSentToast';
                toast.className = 'app-toast app-toast-success';
                toast.setAttribute('role', 'status');
                toast.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="app-toast-icon"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>'
                    + '<span>@LayoutLocalizer["reportSentToast"].Value</span>'
                    + '<button type="button" class="app-toast-close" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m18 6-12 12M6 6l12 12"/></svg></button>';
                document.body.appendChild(toast);

                function dismiss() {
                    toast.classList.add('is-hiding');
                    toast.addEventListener('animationend', function () { toast.remove(); }, { once: true });
                }
                setTimeout(dismiss, 4000);
                toast.querySelector('.app-toast-close').addEventListener('click', dismiss);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
