@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer LayoutLocalizer
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hamburgerz</title>
    <link rel="icon" type="image/png" href="~/assets/hamburgerz_logo_badge.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/assets/hamburgerz_logo_badge.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/assets/hamburgerz_logo_badge.png" asp-append-version="true" />
    <script>
        (function () {
            var storageKey = "hamburgerz-theme";
            var theme = "light";

            try {
                var storedTheme = window.localStorage.getItem(storageKey);
                if (storedTheme === "dark" || storedTheme === "light") {
                    theme = storedTheme;
                } else if (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    theme = "dark";
                }
            } catch (error) {
                theme = "light";
            }

            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-bs-theme", theme);
            document.documentElement.style.colorScheme = theme;
        })();
    </script>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Hamburgerz.styles.css" asp-append-version="true" />

    <style>
        .profile-avatar-btn {
            padding: 0;
            border: 0;
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .profile-avatar-btn:focus {
            box-shadow: none;
        }

        .profile-avatar {
            position: relative;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: var(--color-primary);
            color: var(--color-button-primary-text);
            font-weight: 700;
            font-size: 1rem;
            border: 1px solid var(--color-border);
            box-shadow: var(--shadow-sm);
            transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        }

        .profile-avatar-image {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .profile-avatar-fallback {
            position: relative;
            z-index: 1;
        }

        .profile-avatar-btn:hover .profile-avatar,
        .profile-avatar-btn:focus .profile-avatar {
            background: var(--color-link-hover);
            box-shadow: var(--shadow-md);
            transform: translateY(-1px);
        }

        .profile-dropdown {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-md);
            min-width: 180px;
            padding: 0.4rem;
        }

        .profile-dropdown .dropdown-item {
            color: var(--color-text);
            border-radius: var(--radius-sm);
            padding: 0.6rem 0.85rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .profile-dropdown .dropdown-item svg {
            flex-shrink: 0;
            opacity: 0.6;
        }

        .profile-dropdown .dropdown-item:hover svg,
        .profile-dropdown .dropdown-item:focus svg {
            opacity: 1;
        }

        .profile-dropdown .dropdown-item.text-danger svg {
            opacity: 0.7;
        }

        .profile-dropdown .dropdown-item:hover,
        .profile-dropdown .dropdown-item:focus {
            background: var(--color-surface-2);
            color: var(--color-primary);
        }

        .profile-dropdown .dropdown-divider {
            border-color: var(--color-border);
        }

        .profile-dropdown .dropdown-item.text-danger {
            color: var(--color-danger) !important;
        }

        .profile-dropdown .dropdown-item.text-danger:hover,
        .profile-dropdown .dropdown-item.text-danger:focus {
            background: var(--color-surface-2);
            color: var(--color-danger) !important;
        }

        .bug-topic-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-top: 8px;
        }

        .bug-topic-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            padding: 12px 8px;
            border: 1.5px solid var(--color-border);
            border-radius: 12px;
            background: var(--color-surface);
            color: var(--color-text-muted);
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            transition: border-color 0.15s, color 0.15s, background 0.15s;
            text-align: center;
            line-height: 1.3;
        }

        .bug-topic-btn:hover {
            border-color: var(--color-primary);
            color: var(--color-primary);
            background: var(--color-surface-raised);
        }

        .bug-topic-btn.is-selected {
            border-color: var(--color-primary);
            background: rgba(var(--color-primary-rgb, 14,165,233), 0.1);
            color: var(--color-primary);
        }

        .bug-report-textarea {
            background: var(--color-surface);
            border: 1.5px solid var(--color-border);
            color: var(--color-text);
            border-radius: 10px;
            resize: vertical;
            min-height: 90px;
        }

        .bug-report-textarea:focus {
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px rgba(14,165,233,0.12);
        }

        .bug-report-footer {
            border-top: 1px solid var(--color-border);
            gap: 8px;
        }

        .premium-modal-kicker {
            width: max-content;
            padding: 0.35rem 0.7rem;
            border-radius: 999px;
            background: rgba(245, 158, 11, 0.14);
            border: 1px solid rgba(245, 158, 11, 0.28);
            color: #b45309;
            font-size: 0.72rem;
            font-weight: 850;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .premium-benefits {
            display: grid;
            gap: 0.75rem;
            margin: 1rem 0;
            padding: 0;
            list-style: none;
        }

        .premium-benefits li {
            display: flex;
            gap: 0.7rem;
            align-items: flex-start;
            padding: 0.85rem;
            border-radius: 14px;
            border: 1px solid var(--color-border);
            background: var(--color-bg);
            color: var(--color-text);
            font-weight: 700;
            line-height: 1.45;
        }

        .premium-benefits li::before {
            content: "";
            width: 0.72rem;
            height: 0.72rem;
            margin-top: 0.25rem;
            border-radius: 50%;
            flex: 0 0 auto;
            background: linear-gradient(135deg, #fbbf24, #d97706);
            box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.14);
        }

        .premium-purchase-btn {
            width: 100%;
            border: 0;
            border-radius: 14px;
            padding: 0.9rem 1rem;
            background: linear-gradient(135deg, #fbbf24, #d97706);
            color: #251604;
            font-weight: 900;
            box-shadow: 0 14px 28px rgba(217, 119, 6, 0.22);
        }

        .app-toast {
            position: fixed;
            top: 24px;
            left: 50%;
            transform: translateX(-50%) translateY(-12px);
            z-index: 9999;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 18px 14px 16px;
            border-radius: 16px;
            border: 1px solid transparent;
            box-shadow: 0 8px 32px rgba(0,0,0,0.14);
            font-size: 14px;
            font-weight: 700;
            max-width: 420px;
            width: max-content;
            opacity: 0;
            animation: toastIn 0.35s ease forwards;
        }

        .app-toast-success {
            background: var(--color-surface, #fff);
            border-color: rgba(34, 197, 94, 0.3);
            color: var(--color-text, #0f172a);
        }

        .app-toast-icon {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
            color: #16a34a;
        }

        .app-toast-close {
            margin-left: 6px;
            width: 24px;
            height: 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 0;
            background: transparent;
            color: var(--color-text-muted, #64748b);
            border-radius: 6px;
            cursor: pointer;
            flex-shrink: 0;
        }

        .app-toast-close svg { width: 14px; height: 14px; }
        .app-toast-close:hover { background: rgba(0,0,0,0.06); }

        .app-toast.is-hiding {
            animation: toastOut 0.3s ease forwards;
        }

        @@keyframes toastIn {
            to { opacity: 1; transform: translateX(-50%) translateY(0); }
        }

        @@keyframes toastOut {
            to { opacity: 0; transform: translateX(-50%) translateY(-10px); }
        }
    </style>
</head>
@{
    var userId = Context.Session.GetInt32("UserId");
    var username = Context.Session.GetString("Username");
    var userType = Context.Session.GetString("UserType")?.Trim().ToLowerInvariant();
    var isAdmin = userType == "admin";
    var hasPremiumFeatures = userType == "premium" || userType == "admin";
    var isLoggedIn = userId != null;
    var currentReturnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";

    var userInitial = !string.IsNullOrWhiteSpace(username)
        ? username.Substring(0, 1).ToUpper()
        : "?";

    var avatarUrl = isLoggedIn ? Url.Action("Avatar", "Profile") ?? string.Empty : string.Empty;
}
<body class="app-body"
      data-avatar-url="@avatarUrl"
      data-theme-label-light="@LayoutLocalizer["themeLight"].Value"
      data-theme-label-dark="@LayoutLocalizer["themeDark"].Value"
      data-job-role-empty="@LayoutLocalizer["jobRoleEmpty"].Value"
      data-avatar-read-error="@LayoutLocalizer["avatarReadError"].Value"
      data-avatar-process-error="@LayoutLocalizer["avatarProcessError"].Value"
      data-avatar-canvas-error="@LayoutLocalizer["avatarCanvasError"].Value"
      data-avatar-data-error="@LayoutLocalizer["avatarDataError"].Value"
      data-avatar-invalid-file="@LayoutLocalizer["avatarInvalidFile"].Value"
      data-avatar-upload-url-error="@LayoutLocalizer["avatarUploadUrlError"].Value"
      data-avatar-upload-error="@LayoutLocalizer["avatarUploadError"].Value">
    <div class="app-background" aria-hidden="true">
        <div class="app-background__mesh"></div>
        <div class="app-background__orb app-background__orb--primary"></div>
        <div class="app-background__orb app-background__orb--secondary"></div>
        <div class="app-background__orb app-background__orb--tertiary"></div>
        <div class="app-background__frost"></div>
        <div class="app-background__grain"></div>
    </div>

    <div class="app-chrome">
        <header>
            <nav class="navbar navbar-expand-lg border-bottom box-shadow mb-3 app-navbar">
                <div class="container-fluid">

                    @{
                        var currentLang = CultureInfo.CurrentUICulture.Name;
                        var isLt = currentLang == "lt-LT";
                    }

                    @if (!isLoggedIn)
                    {
