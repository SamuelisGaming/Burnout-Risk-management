<!DOCTYPE html>
<html lang="lt" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hamburgerz</title>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Hamburgerz.styles.css" asp-append-version="true" />

    <style>
        .profile-avatar-btn {
            padding: 0;
            border: 0;
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .profile-avatar-btn:focus {
            box-shadow: none;
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--color-primary);
            color: var(--color-button-primary-text);
            font-weight: 700;
            font-size: 1rem;
            border: 1px solid var(--color-border);
            box-shadow: var(--shadow-sm);
            transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        }

        .profile-avatar-btn:hover .profile-avatar,
        .profile-avatar-btn:focus .profile-avatar {
            background: var(--color-link-hover);
            box-shadow: var(--shadow-md);
            transform: translateY(-1px);
        }

        .profile-dropdown {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-md);
            min-width: 180px;
            padding: 0.4rem;
        }

        .profile-dropdown .dropdown-item {
            color: var(--color-text);
            border-radius: var(--radius-sm);
            padding: 0.6rem 0.85rem;
        }

        .profile-dropdown .dropdown-item:hover,
        .profile-dropdown .dropdown-item:focus {
            background: var(--color-surface-2);
            color: var(--color-primary);
        }

        .profile-dropdown .dropdown-divider {
            border-color: var(--color-border);
        }

        .profile-dropdown .dropdown-item.text-danger {
            color: #dc3545 !important;
        }

        .profile-dropdown .dropdown-item.text-danger:hover,
        .profile-dropdown .dropdown-item.text-danger:focus {
            background: var(--color-surface-2);
            color: #dc3545 !important;
        }
    </style>
</head>
<body>
    @{
        var userId = Context.Session.GetInt32("UserId");
        var username = Context.Session.GetString("Username");
        var isLoggedIn = userId != null;

        var userInitial = !string.IsNullOrWhiteSpace(username)
            ? username.Substring(0, 1).ToUpper()
            : "?";
    }

    <header>
        <nav class="navbar navbar-expand-lg border-bottom box-shadow mb-3 app-navbar">
            <div class="container-fluid">

                @if (!isLoggedIn)
                {
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Hamburgerz</a>
                }
                else
                {
                    <div class="w-100 d-flex align-items-center justify-content-between">

                        <div style="min-width: 180px;">
                            <a class="navbar-brand mb-0" asp-area="" asp-controller="Home" asp-action="Index">Hamburgerz</a>
                        </div>

                        <div class="d-flex justify-content-center flex-grow-1">
                            <ul class="navbar-nav d-flex flex-row gap-4">
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Profile" asp-action="History">History</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Risk" asp-action="Index">Rizikos langas</a>
                                </li>
                            </ul>
                        </div>

                        <div class="d-flex justify-content-end" style="min-width: 180px;">
                            <div class="dropdown">
                                <button class="btn profile-avatar-btn"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="Profilio meniu">
                                    <div class="profile-avatar">
                                        @userInitial
                                    </div>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end profile-dropdown">
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="History">
                                            Profilis
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-area="" asp-controller="Login" asp-action="Logout">
                                            Atsijungti
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>

                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container">
            &copy; 2026 - Hamburgerz - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>