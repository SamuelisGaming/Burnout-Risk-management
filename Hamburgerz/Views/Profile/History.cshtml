@model List<Hamburgerz.Models.RiskMeasurement>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = @Localizer["title1"];
    var currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    var totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    var totalCount = ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : (Model?.Count ?? 0);
    var historyController = (ViewBag.HistoryController as string) ?? "Profile";
    var resultAction = (ViewBag.ResultAction as string) ?? "Result";
    var historyAction = (ViewBag.HistoryAction as string) ?? "History";
    var historyUserId = ViewBag.HistoryUserId;
    var readOnlyHistory = ViewBag.ReadOnlyHistory is bool readOnly && readOnly;
    var hasPremiumFeatures = ViewBag.HasPremiumFeatures is bool premium && premium;
    var measurementLimit = ViewBag.MeasurementLimit != null ? (int)ViewBag.MeasurementLimit : 7;
    var showFreeLimit = !readOnlyHistory && !hasPremiumFeatures;
    var remainingMeasurements = Math.Max(0, measurementLimit - totalCount);
    var limitPercent = measurementLimit > 0
        ? Math.Min(100, (int)Math.Round(totalCount * 100.0 / measurementLimit))
        : 0;
    string LocalizedRisk(Hamburgerz.Models.RiskMeasurement item) => item.RiskText switch
    {
        "High" => Localizer["riskHigh"].Value,
        "Medium" => Localizer["riskMedium"].Value,
        "Low" => Localizer["riskLow"].Value,
        _ => item.RiskText
    };
}

<div class="history-wrapper">
    <div class="history-header">
        <div>
            <h1 class="history-title">@Localizer["title1"]</h1>
            <p class="history-subtitle">@Localizer["title1descr"]</p>
        </div>

        @if (totalCount > 0)
        {
            <div class="history-count">@totalCount @Localizer["meas"]</div>
        }
    </div>

    @if (showFreeLimit)
    {
        <button type="button"
                class="history-limit-card"
                data-bs-toggle="modal"
                data-bs-target="#premiumModal">
            <div class="history-limit-main">
                <div>
                    <div class="history-limit-kicker">@Localizer["freePlan"]</div>
                    <h2>@Localizer["measurementLimit"] @totalCount/@measurementLimit</h2>
                    <p>
                        @(remainingMeasurements > 0
                            ? string.Format(Localizer["remainingLimit"].Value, remainingMeasurements)
                            : Localizer["limitReachedPremium"].Value)
                    </p>
                </div>
                <span class="history-limit-upgrade">@Localizer["premium"]</span>
            </div>
            <span class="history-limit-track" aria-hidden="true">
                <span class="history-limit-fill" style="width:@($"{limitPercent}%")"></span>
            </span>
        </button>
    }

    @if (TempData["MeasurementSuccess"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success history-alert" role="alert">
            @successMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <div class="empty-state-visual">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                    <rect x="6" y="10" width="36" height="30" rx="7" stroke="currentColor" stroke-width="2.5"/>
                    <path d="M16 10V7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    <path d="M32 10V7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    <path d="M6 20h36" stroke="currentColor" stroke-width="2.5"/>
                    <circle cx="24" cy="32" r="5" stroke="currentColor" stroke-width="2.5"/>
                    <path d="M24 29.5v2.5l1.5 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <h3 class="empty-state-title">@Localizer["measno"]</h3>
            <p class="empty-state-copy">@Localizer["measnodescr"]</p>
            @if (!readOnlyHistory)
            {
                <a asp-controller="Data" asp-action="DataEntry" class="history-btn">@Localizer["addfirst"]</a>
            }
        </div>
    }
    else
    {
        <div class="history-list">
            @foreach (var item in Model)
            {
                var metaParts = new List<string> { item.TimeStamp.ToString("HH:mm") };
                var jobRole = item.JobRole?.Trim();
                var workEnvironment = item.WorkEnvironment?.Trim();

                if (!string.IsNullOrWhiteSpace(jobRole) && jobRole != "." && jobRole != ",")
                {
                    metaParts.Add(jobRole);
                }

                if (!string.IsNullOrWhiteSpace(workEnvironment) && workEnvironment != "." && workEnvironment != ",")
                {
                    metaParts.Add(workEnvironment);
                }

                <a asp-controller="@historyController"
                   asp-action="@resultAction"
                   asp-route-id="@item.ID"
                   asp-route-userId="@historyUserId"
                   class="history-card-link">
                    <article class="history-card">
                            <div class="history-card-top">
                                <div class="history-main-info">
                                    <div class="history-date-main">@item.TimeStamp.ToString("yyyy-MM-dd")</div>
                                    <div class="history-meta">@string.Join(", ", metaParts)</div>
                                </div>

                                <div class="history-risk @item.RiskClass">
                                    @LocalizedRisk(item) @Localizer["risk"]
                                </div>
                        </div>

                        <div class="history-footer">
                            <div class="history-chip">@Localizer["stress"]: @item.StressLevel</div>
                            <div class="history-chip">@Localizer["sleep"]: @item.SleepHours.ToString("0.0")h</div>
                            <div class="history-chip">@Localizer["work"]: @item.WorkHours.ToString("0.0")h</div>
                        </div>
                    </article>
                </a>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav class="history-pagination" aria-label="History pages">
                <div class="history-page-summary">@Localizer["page"] @currentPage @Localizer["of"] @totalPages</div>

                <div class="history-page-controls">
                    @if (currentPage > 1)
                    {
                        <a asp-controller="@historyController"
                           asp-action="@historyAction"
                           asp-route-userId="@historyUserId"
                           asp-route-page="@(currentPage - 1)"
                           class="history-page-btn">
                            @Localizer["prev"]
                        </a>
                    }
                    else
                    {
                        <span class="history-page-btn is-disabled">@Localizer["prev"]</span>
                    }

                    @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                    {
                        if (pageNumber == currentPage)
                        {
                            <span class="history-page-number is-current">@pageNumber</span>
                        }
                        else
                        {
                            <a asp-controller="@historyController"
                               asp-action="@historyAction"
                               asp-route-userId="@historyUserId"
                               asp-route-page="@pageNumber"
                               class="history-page-number">
                                @pageNumber
                            </a>
                        }
                    }

                    @if (currentPage < totalPages)
                    {
                        <a asp-controller="@historyController"
                           asp-action="@historyAction"
                           asp-route-userId="@historyUserId"
                           asp-route-page="@(currentPage + 1)"
                           class="history-page-btn">
                            @Localizer["next"]
                        </a>
                    }
                    else
                    {
                        <span class="history-page-btn is-disabled">@Localizer["next"]</span>
                    }
                </div>
            </nav>
        }
    }
</div>

<style>
    .history-wrapper {
        max-width: 980px;
        margin: 0 auto;
        padding: 32px 20px 48px;
    }

    .history-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 18px;
        margin-bottom: 24px;
    }

    .history-title {
        margin: 0 0 8px 0;
        font-size: 34px;
        font-weight: 800;
        color: var(--color-text);
    }

    .history-subtitle {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 15px;
    }

    .history-count {
        flex-shrink: 0;
        padding: 9px 14px;
        border-radius: 999px;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        color: var(--color-text-muted);
        font-size: 13px;
        font-weight: 700;
    }

    .history-limit-card {
        width: 100%;
        display: grid;
        gap: 12px;
        margin: -8px 0 18px;
        padding: 16px 18px;
        border: 1px solid rgba(245, 158, 11, 0.36);
        border-radius: 18px;
        background:
            radial-gradient(circle at top right, rgba(251, 191, 36, 0.22), transparent 34%),
            linear-gradient(135deg, var(--color-surface), var(--color-bg));
        color: var(--color-text);
        text-align: left;
        box-shadow: 0 16px 32px rgba(217, 119, 6, 0.12);
        cursor: pointer;
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

    .history-limit-card:hover {
        transform: translateY(-1px);
        border-color: rgba(245, 158, 11, 0.58);
        box-shadow: 0 20px 38px rgba(217, 119, 6, 0.18);
    }

    .history-limit-main {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
    }

    .history-limit-kicker {
        color: #b45309;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .history-limit-card h2 {
        margin: 0 0 5px;
        color: var(--color-text);
        font-size: 20px;
        font-weight: 900;
    }

    .history-limit-card p {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 13px;
        line-height: 1.5;
    }

    .history-limit-upgrade {
        flex-shrink: 0;
        border-radius: 999px;
        padding: 8px 12px;
        background: linear-gradient(135deg, #fbbf24, #d97706);
        color: #251604;
        font-size: 12px;
        font-weight: 900;
        box-shadow: 0 10px 22px rgba(217, 119, 6, 0.22);
    }

    .history-limit-track {
        display: block;
        height: 9px;
        border-radius: 999px;
        overflow: hidden;
        background: rgba(var(--color-border-rgb), 0.62);
    }

    .history-limit-fill {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #fbbf24, #d97706);
    }

    .history-list {
        display: grid;
        gap: 14px;
    }

    .history-alert {
        border-radius: 14px;
        margin-bottom: 18px;
    }

    .history-card-link {
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .history-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 20px;
        padding: 15px 18px;
        box-shadow: var(--shadow-sm);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        display: grid;
        gap: 10px;
    }

    .history-card:hover {
        transform: translateY(-1px);
        box-shadow: var(--shadow-md);
        border-color: rgba(var(--color-primary-rgb), 0.32);
    }

    .history-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 14px;
    }

    .history-main-info {
        min-width: 0;
    }

    .history-date-main {
        font-size: 18px;
        font-weight: 800;
        color: var(--color-text);
        line-height: 1.2;
    }

    .history-meta {
        color: var(--color-text-muted);
        font-size: 13px;
        line-height: 1.3;
        margin-top: 4px;
    }

    .history-risk {
        min-width: 84px;
        text-align: center;
        padding: 7px 11px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
    }

    .history-footer {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .history-chip {
        background: var(--color-surface-2);
        color: var(--color-text);
        border: 1px solid var(--color-border);
        border-radius: 999px;
        padding: 6px 11px;
        font-size: 12px;
        font-weight: 700;
    }

    .risk-high {
        background: #fee2e2;
        color: #b91c1c;
    }

    .risk-medium {
        background: #fef3c7;
        color: #b45309;
    }

    .risk-low {
        background: rgba(34, 197, 94, 0.14);
        border: 1px solid rgba(34, 197, 94, 0.22);
        color: #15803d;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 64px 24px;
        border-radius: 24px;
        border: 1.5px dashed var(--color-border);
        background: var(--color-surface);
        gap: 0;
    }

    .empty-state-visual {
        width: 80px;
        height: 80px;
        border-radius: 24px;
        background: rgba(var(--color-primary-rgb), .08);
        color: var(--color-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 22px;
    }

    .empty-state-title {
        margin: 0 0 8px;
        font-size: 20px;
        font-weight: 800;
        color: var(--color-text);
    }

    .empty-state-copy {
        margin: 0 0 24px;
        color: var(--color-text-muted);
        font-size: 14px;
        max-width: 320px;
        line-height: 1.6;
    }

    .history-btn {
        display: inline-block;
        margin-top: 10px;
        padding: 12px 18px;
        background: var(--color-primary);
        color: var(--color-button-primary-text);
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
    }

    .history-btn:hover {
        color: var(--color-button-primary-text);
        background: var(--color-button-primary-hover);
    }

    .history-pagination {
        display: grid;
        gap: 12px;
        justify-items: center;
        margin-top: 22px;
    }

    .history-page-summary {
        color: var(--color-text-muted);
        font-size: 13px;
        font-weight: 700;
    }

    .history-page-controls {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
    }

    .history-page-btn,
    .history-page-number {
        min-width: 42px;
        padding: 9px 14px;
        border-radius: 999px;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        color: var(--color-text);
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        text-align: center;
        transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }

    a.history-page-btn:hover,
    a.history-page-number:hover {
        transform: translateY(-1px);
        border-color: rgba(var(--color-primary-rgb), 0.32);
        box-shadow: var(--shadow-sm);
    }

    .history-page-number.is-current {
        background: var(--color-primary);
        border-color: var(--color-primary);
        color: var(--color-button-primary-text);
    }

    .is-disabled {
        opacity: 0.45;
        pointer-events: none;
    }

    @@media (max-width: 768px) {
        .history-wrapper {
            padding: 20px 14px 40px;
        }

        .history-title {
            font-size: 28px;
        }

        .history-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .history-limit-main {
            flex-direction: column;
        }

        .history-card-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .history-pagination {
            justify-items: stretch;
        }

        .history-page-controls {
            justify-content: flex-start;
        }
    }
</style>
