@model Hamburgerz.Models.RiskMeasurement
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = @Localizer["title1"];
    TempData.Remove("MeasurementSuccess");
    var errorMessage = TempData["MeasurementError"] as string;
    var hasAiAccess = ViewBag.HasAiAccess is bool aiAccess && aiAccess;
    var canDeleteMeasurement = ViewBag.CanDeleteMeasurement is bool canDelete && canDelete;
    var isReadOnlyMeasurement = ViewBag.ReadOnlyMeasurement is bool readOnly && readOnly;
    var backController = (ViewBag.BackController as string) ?? "Profile";
    var backAction = (ViewBag.BackAction as string) ?? "History";
    var backUserId = ViewBag.BackUserId;
    var aiSuggestionUrl = (ViewBag.AiSuggestionUrl as string) ?? Url.Action("GetAiSuggestion", "Profile", new { id = Model.ID }) ?? string.Empty;

    var notSetText = Localizer["notset"].Value ?? "-";
    string DisplayText(string? value) => string.IsNullOrWhiteSpace(value) ? notSetText : value!;
    string DisplayGender(string? value) => value switch
    {
        "male" or "Vyras" or "Man" => Localizer["gender_male"].Value,
        "female" or "Moteris" or "Woman" => Localizer["gender_female"].Value,
        "other" or "Kita" or "Other" => Localizer["gender_other"].Value,
        _ => DisplayText(value)
    };
    string DisplayNumber(int? value) => value?.ToString() ?? notSetText;
    string DisplayDate(DateTime? value) => value?.ToString("yyyy-MM-dd") ?? notSetText;
}
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<style>

    .result-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 32px 20px 48px;
    }

    .result-shell {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 24px;
        box-shadow: var(--shadow-md);
        overflow: hidden;
    }

    .result-hero {
        padding: 28px 28px 22px;
        border-bottom: 1px solid var(--color-border);
        background:
            radial-gradient(circle at top right, rgba(var(--color-primary-rgb), 0.12), transparent 28%),
            linear-gradient(135deg, var(--color-surface) 0%, var(--color-bg) 100%);
    }

    .result-alerts {
        display: grid;
        gap: 10px;
        margin-bottom: 16px;
    }

    .result-alert {
        margin: 0;
        border-radius: 14px;
    }

    .result-hero-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 6px;
    }

    .result-subtitle {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 15px;
        max-width: 720px;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        padding-bottom: 0;
        flex-shrink: 0;
    }

    .hero-icon-form {
        margin: 0;
    }

    .hero-icon-btn {
        padding: 4px 0;
        border: 0;
        background: transparent;
        color: var(--color-text-muted);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        transition: transform 0.15s ease, color 0.15s ease, opacity 0.15s ease;
    }

    .hero-icon-btn:hover {
        transform: translateX(1px);
        color: var(--color-text);
        opacity: 1;
    }

    .hero-icon-btn svg {
        width: 17px;
        height: 17px;
    }

    .date-edit-form {
        margin: 0;
    }

    .result-date-form {
        display: grid;
        gap: 8px;
    }

    .date-title-input {
        width: min(100%, 260px);
        padding: 0;
        border: 0;
        background: transparent;
        box-shadow: none;
        font-size: 28px;
        font-weight: 800;
        color: var(--color-text);
        line-height: 1.1;
        letter-spacing: -0.02em;
        font-family: inherit;
        outline: none;
    }

    .date-title-input:focus {
        color: var(--color-primary);
    }

    .date-title-input::-webkit-date-and-time-value {
        text-align: left;
    }

    .date-title-input::-webkit-datetime-edit,
    .date-title-input::-webkit-datetime-edit-fields-wrapper,
    .date-title-input::-webkit-datetime-edit-text,
    .date-title-input::-webkit-datetime-edit-month-field,
    .date-title-input::-webkit-datetime-edit-day-field,
    .date-title-input::-webkit-datetime-edit-year-field {
        padding: 0;
        color: inherit;
    }

    .date-title-input::-webkit-calendar-picker-indicator {
        cursor: pointer;
        margin-left: 10px;
        opacity: 0.82;
    }

    .result-body {
        padding: 24px 28px 28px;
    }

    .result-main-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .result-panel {
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 20px;
        padding: 20px;
        box-shadow: var(--shadow-sm);
    }

    .panel-kicker {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-primary);
        font-weight: 800;
        margin-bottom: 8px;
    }

    .panel-title {
        margin: 0 0 14px 0;
        color: var(--color-text);
        font-size: 24px;
        font-weight: 800;
    }

    .score-block {
        display: grid;
        grid-template-columns: 170px 1fr;
        gap: 18px;
        align-items: center;
    }

    .score-circle-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .score-circle {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background:
            conic-gradient(var(--color-primary) 0deg, var(--color-primary) calc(var(--score) * 3.6deg), var(--color-surface-2) calc(var(--score) * 3.6deg), var(--color-surface-2) 360deg);
        padding: 12px;
    }

    .score-circle-inner {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .score-number {
        font-size: 34px;
        font-weight: 900;
        color: var(--color-text);
        line-height: 1;
    }

    .score-caption {
        margin-top: 4px;
        font-size: 12px;
        color: var(--color-text-muted);
        font-weight: 700;
    }

    .summary-box {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        padding: 14px 16px;
        color: var(--color-text);
        line-height: 1.6;
        min-height: 96px;
    }

    .mini-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .mini-stat {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        padding: 14px;
    }

    .mini-stat-label {
        font-size: 12px;
        color: var(--color-text-muted);
        margin-bottom: 4px;
    }

    .mini-stat-value {
        font-size: 20px;
        font-weight: 800;
        color: var(--color-text);
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .detail-list {
        display: grid;
        gap: 10px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 14px;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
    }

    .detail-label {
        font-size: 13px;
        color: var(--color-text-muted);
        font-weight: 700;
    }

    .detail-value {
        font-size: 14px;
        color: var(--color-text);
        font-weight: 800;
        text-align: right;
    }

    .placeholder-panel {
        min-height: 180px;
        border: 2px dashed var(--color-border);
        border-radius: 16px;
        background: var(--color-surface);
        padding: 15px;
    }

    .ai-insight-card {
        min-height: 220px;
        border: 1px solid var(--color-border);
        border-radius: 18px;
        background:
            radial-gradient(circle at top right, rgba(var(--color-primary-rgb), 0.08), transparent 34%),
            linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
        padding: 18px;
        box-shadow: inset 0 1px 0 rgba(var(--color-bg-rgb), 0.72);
    }

    .ai-loading-card {
        min-height: 184px;
        display: flex;
        align-items: center;
        gap: 16px;
        color: var(--color-text);
    }

    .ai-spinner {
        width: 2rem;
        height: 2rem;
        flex-shrink: 0;
        color: var(--color-primary);
    }

    .ai-loading-title {
        font-size: 17px;
        font-weight: 800;
        color: var(--color-text);
        margin-bottom: 4px;
    }

    .ai-loading-copy {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 14px;
        line-height: 1.6;
    }

    .ai-markdown-body {
        font-size: 16.5px;
        line-height: 1.76;
        color: var(--color-text);
    }

    .ai-markdown-body p,
    .ai-markdown-body ul,
    .ai-markdown-body ol {
        margin: 0 0 14px;
    }

    .ai-markdown-body p:last-child,
    .ai-markdown-body ul:last-child,
    .ai-markdown-body ol:last-child {
        margin-bottom: 0;
    }

    .ai-markdown-body ul,
    .ai-markdown-body ol {
        padding-left: 1.25rem;
    }

    .ai-markdown-body li + li {
        margin-top: 6px;
    }

    .ai-markdown-body strong {
        color: var(--color-text);
        font-weight: 850;
    }

    .ai-error-text {
        display: flex;
        min-height: 184px;
        align-items: center;
        color: var(--color-text-muted);
        font-size: 15px;
        line-height: 1.6;
    }

    .back-row {
        margin-bottom: 18px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: var(--color-link);
        font-weight: 700;
    }

    .back-link:hover {
        color: var(--color-link-hover);
    }

    @@media (max-width: 992px) {
        .result-main-grid {
            grid-template-columns: 1fr;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .result-page {
            padding: 20px 12px 36px;
        }

        .result-hero,
        .result-body {
            padding-left: 16px;
            padding-right: 16px;
        }

        .result-hero-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-actions {
            padding-bottom: 0;
        }

        .result-date-form,
        .date-title-input {
            width: 100%;
        }

        .score-block {
            grid-template-columns: 1fr;
        }

        .mini-stats {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="result-page">
    <div class="back-row">
        <a asp-controller="@backController" asp-action="@backAction" asp-route-userId="@backUserId" class="back-link">
            &larr; @Localizer["backhist"]
        </a>
    </div>

    <div class="result-shell">
        <div class="result-hero">
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="result-alerts">
                    <div class="alert alert-danger result-alert" role="alert">
                        @errorMessage
                    </div>
                </div>
            }

            <div class="result-hero-top">
                @if (isReadOnlyMeasurement)
                {
                    <div class="date-edit-form result-date-form">
                        <div class="date-title-input">@Model.TimeStamp.ToString("yyyy-MM-dd")</div>
                        <p class="result-subtitle">@Localizer["datedescr"]</p>
                    </div>
                }
                else
                {
                    <form asp-controller="Profile"
                          asp-action="UpdateTimestamp"
                          method="post"
                          class="date-edit-form result-date-form">
                        <input type="hidden" name="id" value="@Model.ID" />
                        <input type="hidden" name="originalTime" value="@Model.TimeStamp.ToString("HH:mm:ss")" />
                        <input id="timeStamp"
                               name="timeStamp"
                               type="date"
                               class="date-title-input"
                               aria-label=@Localizer["measdate"]
                               value="@Model.TimeStamp.ToString("yyyy-MM-dd")"
                               onchange="this.form.submit()" />
                        <p class="result-subtitle">@Localizer["datedescr"]</p>
                    </form>
                }

                @if (!isReadOnlyMeasurement && canDeleteMeasurement)
                {
                <div class="hero-actions">
                    <form asp-controller="Profile"
                          asp-action="DeleteMeasurement"
                        method="post"
                        class="hero-icon-form"
                        onsubmit="return confirm(@Localizer["delconfirm"].ToString());">
                        <input type="hidden" name="id" value="@Model.ID" />
                        <button type="submit" class="hero-icon-btn" title="Delete measurement" aria-label=@Localizer["delmeas"]>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 6h18" />
                                <path d="M8 6V4h8v2" />
                                <path d="M19 6l-1 14H6L5 6" />
                                <path d="M10 11v6" />
                                <path d="M14 11v6" />
                            </svg>
                            <span>@Localizer["del"]</span>
                        </button>
                    </form>
                </div>
                }
            </div>
        </div>

        <div class="result-body">
            <div class="result-main-grid">
                <section class="result-panel">
                    <div class="panel-kicker">@Localizer["res"]</div>
                    <h2 class="panel-title">@Localizer["mainass"]</h2>

                    <div class="score-block">
                        <div class="score-circle-wrap">
                            <div class="score-circle" style="--score:@Model.BurnoutPercent;">
                                <div class="score-circle-inner">
                                    <div class="score-number">@Model.BurnoutPercent%</div>
                                    <div class="score-caption">@Localizer["burn"]</div>
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="summary-box">
                                @Model.QuickSummary
                            </div>
                        </div>
                    </div>
                </section>

                <section class="result-panel">
                    <div class="panel-kicker">@Localizer["title2"]</div>
                    <h2 class="panel-title">@Localizer["title2descr"]</h2>

                    <div class="mini-stats">
                        <div class="mini-stat">
                            <div class="mini-stat-label">@Localizer["stress"]</div>
                            <div class="mini-stat-value">@Model.StressLevel</div>
                        </div>

                        <div class="mini-stat">
                            <div class="mini-stat-label">@Localizer["prod"]</div>
                            <div class="mini-stat-value">@Model.ProductivityScore</div>
                        </div>

                        <div class="mini-stat">
                            <div class="mini-stat-label">@Localizer["sleep"]</div>
                            <div class="mini-stat-value">@Model.SleepHours.ToString("0.0")h</div>
                        </div>

                        <div class="mini-stat">
                            <div class="mini-stat-label">@Localizer["work"]</div>
                            <div class="mini-stat-value">@Model.WorkHours.ToString("0.0")h</div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="details-grid">
                <section class="result-panel">
                    <div class="panel-kicker">@Localizer["title3"]</div>
                    <h2 class="panel-title">@Localizer["title3descr"]</h2>

                    <div class="detail-list">
                        <div class="detail-row">
                            <span class="detail-label">@Localizer["birth"]</span>
                            <span class="detail-value">@DisplayDate(Model.BirthDate)</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">@Localizer["gender"]</span>
                            <span class="detail-value">@DisplayGender(Model.Gender)</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">@Localizer["position"]</span>
                            <span class="detail-value">@DisplayText(Model.JobRole)</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">@Localizer["experience"]</span>
                            <span class="detail-value">@DisplayNumber(Model.ExperienceYears)</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">@Localizer["size"]</span>
                            <span class="detail-value">@DisplayText(Model.CompanySize)</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">@Localizer["workenv"]</span>
                            <span class="detail-value">@DisplayText(Model.WorkEnvironment)</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">@Localizer["meetsday"]</span>
                            <span class="detail-value">@Model.MeetingsPerDay</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">@Localizer["intspeed"]</span>
                            <span class="detail-value">@Model.InternetSpeed</span>
                        </div>
                    </div>
                </section>

                <section class="result-panel">
                    <div class="panel-kicker">@Localizer["title4"]</div>
                    <h2 class="panel-title">@Localizer["title4descr"]</h2>

                    <div class="detail-list">
                        <div class="detail-row">
                            <span class="detail-label">@Localizer["sleeph"]</span>
                            <span class="detail-value">@Model.SleepHours.ToString("0.0")h</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">@Localizer["exh"]</span>
                            <span class="detail-value">@Model.ExerciseHours.ToString("0.0")h</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">@Localizer["screenh"]</span>
                            <span class="detail-value">@Model.ScreenTime.ToString("0.0")h</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">@Localizer["workh"]</span>
                            <span class="detail-value">@Model.WorkHours.ToString("0.0")h</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">@Localizer["stresslev"]</span>
                            <span class="detail-value">@Model.StressLevel</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">@Localizer["burnrisk"]</span>
                            <span class="detail-value">@Model.BurnoutPercent%</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label"@Localizer["prodscor"]></span>
                            <span class="detail-value">@Model.ProductivityScore</span>
                        </div>
                    </div>
                </section>

                <section class="result-panel">
                    <div class="panel-kicker">@Localizer["title5"]</div>
                    <h2 class="panel-title">@Localizer["title5descr"]</h2>

                    <div id="ai-container" class="ai-insight-card">
                        @if (!hasAiAccess)
                        {
                            <div class="ai-error-text">
                                @Localizer["premiumAiRequired"]
                            </div>
                        }
                        else
                        {
                        @if (string.IsNullOrEmpty(Model.AISummary))
                        {
                            <div id="ai-loading" class="ai-loading-card">
                                <div class="spinner-border ai-spinner" role="status" aria-label=@Localizer["aiload"]></div>
                                <div>
                                    <div class="ai-loading-title">@Localizer["aigen"]</div>
                                    <p class="ai-loading-copy">@Localizer["aigendescr"]</p>
                                </div>
                            </div>
                            <div id="ai-text" class="markdown-body ai-markdown-body" style="display:none;"></div>
                        }
                        else
                        {
                            <div id="ai-text"
                                 class="markdown-body ai-markdown-body"
                                 data-markdown="@Model.AISummary">
                            </div>
                        }
                        }
                    </div>
                </section>

                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const textElement = document.getElementById('ai-text');
                        const loadingElement = document.getElementById('ai-loading');

                        if (!textElement) {
                            return;
                        }

                        function escapeHtml(value) {
                            return value
                                ? value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                                : '';
                        }

                        function renderInsight(value) {
                            if (window.marked) {
                                return marked.parse(value || '');
                            }

                            return '<p>' + escapeHtml(value || '').replace(/\n{2,}/g, '</p><p>').replace(/\n/g, '<br>') + '</p>';
                        }

                        function showInsight(value) {
                            textElement.innerHTML = renderInsight(value);
                            textElement.style.display = 'block';
                            if (loadingElement) {
                                loadingElement.style.display = 'none';
                            }
                        }

                        function showError() {
                            textElement.classList.add('ai-error-text');
                            textElement.innerText = "@Localizer["aidown"]";
                            textElement.style.display = 'flex';
                            if (loadingElement) {
                                loadingElement.style.display = 'none';
                            }
                        }

                        const existingMarkdown = textElement?.dataset.markdown;

                        if (existingMarkdown) {
                            showInsight(existingMarkdown);
                        } else if (loadingElement) {
                            fetch(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(aiSuggestionUrl)))
                                .then(response => response.json())
                                .then(data => {
                                    showInsight(data.suggestion);
                                })
                                .catch(showError);
                        }
                    });
                </script>

                <section class="result-panel">
                    <div class="panel-kicker">@Localizer["possigns"]</div>
                    <h2 class="panel-title">@Localizer["possigns"]</h2>
                    <div class="placeholder-panel"></div>
                </section>
            </div>
        </div>
    </div>
</div>
