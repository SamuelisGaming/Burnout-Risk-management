@model Hamburgerz.Models.RiskMeasurement

@{
    ViewData["Title"] = "Measurement result";
    TempData.Remove("MeasurementSuccess");
    var errorMessage = TempData["MeasurementError"] as string;

    string DisplayText(string? value) => string.IsNullOrWhiteSpace(value) ? "Not set" : value;
    string DisplayNumber(int? value) => value?.ToString() ?? "Not set";
    string DisplayDate(DateTime? value) => value?.ToString("yyyy-MM-dd") ?? "Not set";
}

<style>
    .result-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 32px 20px 48px;
    }

    .result-shell {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 24px;
        box-shadow: var(--shadow-md);
        overflow: hidden;
    }

    .result-hero {
        padding: 28px 28px 22px;
        border-bottom: 1px solid var(--color-border);
        background:
            radial-gradient(circle at top right, rgba(var(--color-primary-rgb), 0.12), transparent 28%),
            linear-gradient(135deg, var(--color-surface) 0%, var(--color-bg) 100%);
    }

    .result-alerts {
        display: grid;
        gap: 10px;
        margin-bottom: 16px;
    }

    .result-alert {
        margin: 0;
        border-radius: 14px;
    }

    .result-hero-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 6px;
    }

    .result-subtitle {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 15px;
        max-width: 720px;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        padding-bottom: 0;
        flex-shrink: 0;
    }

    .hero-icon-form {
        margin: 0;
    }

    .hero-icon-btn {
        padding: 4px 0;
        border: 0;
        background: transparent;
        color: var(--color-text-muted);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        transition: transform 0.15s ease, color 0.15s ease, opacity 0.15s ease;
    }

    .hero-icon-btn:hover {
        transform: translateX(1px);
        color: var(--color-text);
        opacity: 1;
    }

    .hero-icon-btn svg {
        width: 17px;
        height: 17px;
    }

    .date-edit-form {
        margin: 0;
    }

    .result-date-form {
        display: grid;
        gap: 8px;
    }

    .date-title-input {
        width: min(100%, 260px);
        padding: 0;
        border: 0;
        background: transparent;
        box-shadow: none;
        font-size: 28px;
        font-weight: 800;
        color: var(--color-text);
        line-height: 1.1;
        letter-spacing: -0.02em;
        font-family: inherit;
        outline: none;
    }

    .date-title-input:focus {
        color: var(--color-primary);
    }

    .date-title-input::-webkit-date-and-time-value {
        text-align: left;
    }

    .date-title-input::-webkit-datetime-edit,
    .date-title-input::-webkit-datetime-edit-fields-wrapper,
    .date-title-input::-webkit-datetime-edit-text,
    .date-title-input::-webkit-datetime-edit-month-field,
    .date-title-input::-webkit-datetime-edit-day-field,
    .date-title-input::-webkit-datetime-edit-year-field {
        padding: 0;
        color: inherit;
    }

    .date-title-input::-webkit-calendar-picker-indicator {
        cursor: pointer;
        margin-left: 10px;
        opacity: 0.82;
    }

    .result-body {
        padding: 24px 28px 28px;
    }

    .result-main-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .result-panel {
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 20px;
        padding: 20px;
        box-shadow: var(--shadow-sm);
    }

    .panel-kicker {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-primary);
        font-weight: 800;
        margin-bottom: 8px;
    }

    .panel-title {
        margin: 0 0 14px 0;
        color: var(--color-text);
        font-size: 24px;
        font-weight: 800;
    }

    .score-block {
        display: grid;
        grid-template-columns: 170px 1fr;
        gap: 18px;
        align-items: center;
    }

    .score-circle-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .score-circle {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background:
            conic-gradient(var(--color-primary) 0deg, var(--color-primary) calc(var(--score) * 3.6deg), var(--color-surface-2) calc(var(--score) * 3.6deg), var(--color-surface-2) 360deg);
        padding: 12px;
    }

    .score-circle-inner {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .score-number {
        font-size: 34px;
        font-weight: 900;
        color: var(--color-text);
        line-height: 1;
    }

    .score-caption {
        margin-top: 4px;
        font-size: 12px;
        color: var(--color-text-muted);
        font-weight: 700;
    }

    .summary-box {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        padding: 14px 16px;
        color: var(--color-text);
        line-height: 1.6;
        min-height: 96px;
    }

    .mini-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .mini-stat {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        padding: 14px;
    }

    .mini-stat-label {
        font-size: 12px;
        color: var(--color-text-muted);
        margin-bottom: 4px;
    }

    .mini-stat-value {
        font-size: 20px;
        font-weight: 800;
        color: var(--color-text);
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .detail-list {
        display: grid;
        gap: 10px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 14px;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
    }

    .detail-label {
        font-size: 13px;
        color: var(--color-text-muted);
        font-weight: 700;
    }

    .detail-value {
        font-size: 14px;
        color: var(--color-text);
        font-weight: 800;
        text-align: right;
    }

    .placeholder-panel {
        min-height: 180px;
        border: 2px dashed var(--color-border);
        border-radius: 16px;
        background: var(--color-surface);
    }

    .back-row {
        margin-bottom: 18px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: var(--color-link);
        font-weight: 700;
    }

    .back-link:hover {
        color: var(--color-link-hover);
    }

    @@media (max-width: 992px) {
        .result-main-grid {
            grid-template-columns: 1fr;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .result-page {
            padding: 20px 12px 36px;
        }

        .result-hero,
        .result-body {
            padding-left: 16px;
            padding-right: 16px;
        }

        .result-hero-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-actions {
            padding-bottom: 0;
        }

        .result-date-form,
        .date-title-input {
            width: 100%;
        }

        .score-block {
            grid-template-columns: 1fr;
        }

        .mini-stats {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="result-page">
    <div class="back-row">
        <a asp-controller="Profile" asp-action="History" class="back-link">
            &larr; Back to history
        </a>
    </div>

    <div class="result-shell">
        <div class="result-hero">
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="result-alerts">
                    <div class="alert alert-danger result-alert" role="alert">
                        @errorMessage
                    </div>
                </div>
            }

            <div class="result-hero-top">
                <form asp-controller="Profile"
                      asp-action="UpdateTimestamp"
                      method="post"
                      class="date-edit-form result-date-form">
                    <input type="hidden" name="id" value="@Model.ID" />
                    <input type="hidden" name="originalTime" value="@Model.TimeStamp.ToString("HH:mm:ss")" />
                    <input id="timeStamp"
                           name="timeStamp"
                           type="date"
                           class="date-title-input"
                           aria-label="Measurement date"
                           value="@Model.TimeStamp.ToString("yyyy-MM-dd")"
                           onchange="this.form.submit()" />
                    <p class="result-subtitle">Type the date or pick it from the calendar.</p>
                </form>

                <div class="hero-actions">
                    <form asp-controller="Profile"
                          asp-action="DeleteMeasurement"
                        method="post"
                        class="hero-icon-form"
                        onsubmit="return confirm('Delete this measurement?');">
                        <input type="hidden" name="id" value="@Model.ID" />
                        <button type="submit" class="hero-icon-btn" title="Delete measurement" aria-label="Delete measurement">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 6h18" />
                                <path d="M8 6V4h8v2" />
                                <path d="M19 6l-1 14H6L5 6" />
                                <path d="M10 11v6" />
                                <path d="M14 11v6" />
                            </svg>
                            <span>Delete</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="result-body">
            <div class="result-main-grid">
                <section class="result-panel">
                    <div class="panel-kicker">Result</div>
                    <h2 class="panel-title">Main assessment</h2>

                    <div class="score-block">
                        <div class="score-circle-wrap">
                            <div class="score-circle" style="--score:@Model.BurnoutPercent;">
                                <div class="score-circle-inner">
                                    <div class="score-number">@Model.BurnoutPercent%</div>
                                    <div class="score-caption">Burnout score</div>
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="summary-box">
                                @Model.QuickSummary
                            </div>
                        </div>
                    </div>
                </section>

                <section class="result-panel">
                    <div class="panel-kicker">Highlights</div>
                    <h2 class="panel-title">Key metrics</h2>

                    <div class="mini-stats">
                        <div class="mini-stat">
                            <div class="mini-stat-label">Stress</div>
                            <div class="mini-stat-value">@Model.StressLevel</div>
                        </div>

                        <div class="mini-stat">
                            <div class="mini-stat-label">Productivity</div>
                            <div class="mini-stat-value">@Model.ProductivityScore</div>
                        </div>

                        <div class="mini-stat">
                            <div class="mini-stat-label">Sleep</div>
                            <div class="mini-stat-value">@Model.SleepHours.ToString("0.0")h</div>
                        </div>

                        <div class="mini-stat">
                            <div class="mini-stat-label">Work</div>
                            <div class="mini-stat-value">@Model.WorkHours.ToString("0.0")h</div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="details-grid">
                <section class="result-panel">
                    <div class="panel-kicker">Details</div>
                    <h2 class="panel-title">Measurement data</h2>

                    <div class="detail-list">
                        <div class="detail-row">
                            <span class="detail-label">Birth date</span>
                            <span class="detail-value">@DisplayDate(Model.BirthDate)</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">Gender</span>
                            <span class="detail-value">@DisplayText(Model.Gender)</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">Job role</span>
                            <span class="detail-value">@DisplayText(Model.JobRole)</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">Experience years</span>
                            <span class="detail-value">@DisplayNumber(Model.ExperienceYears)</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">Company size</span>
                            <span class="detail-value">@DisplayText(Model.CompanySize)</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">Work environment</span>
                            <span class="detail-value">@DisplayText(Model.WorkEnvironment)</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">Meetings per day</span>
                            <span class="detail-value">@Model.MeetingsPerDay</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">Internet speed</span>
                            <span class="detail-value">@Model.InternetSpeed</span>
                        </div>
                    </div>
                </section>

                <section class="result-panel">
                    <div class="panel-kicker">Health and habits</div>
                    <h2 class="panel-title">Lifestyle indicators</h2>

                    <div class="detail-list">
                        <div class="detail-row">
                            <span class="detail-label">Sleep hours</span>
                            <span class="detail-value">@Model.SleepHours.ToString("0.0")h</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">Exercise hours</span>
                            <span class="detail-value">@Model.ExerciseHours.ToString("0.0")h</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">Screen time</span>
                            <span class="detail-value">@Model.ScreenTime.ToString("0.0")h</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">Work hours</span>
                            <span class="detail-value">@Model.WorkHours.ToString("0.0")h</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">Stress level</span>
                            <span class="detail-value">@Model.StressLevel</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">Burnout risk</span>
                            <span class="detail-value">@Model.BurnoutPercent%</span>
                        </div>

                        <div class="detail-row">
                            <span class="detail-label">Productivity score</span>
                            <span class="detail-value">@Model.ProductivityScore</span>
                        </div>
                    </div>
                </section>

                <section class="result-panel">
                    <div class="panel-kicker">Recommendations</div>
                    <h2 class="panel-title">Recommendations</h2>
                    <div class="placeholder-panel"></div>
                </section>

                <section class="result-panel">
                    <div class="panel-kicker">Possible signs</div>
                    <h2 class="panel-title">Possible signs</h2>
                    <div class="placeholder-panel"></div>
                </section>
            </div>
        </div>
    </div>
</div>
