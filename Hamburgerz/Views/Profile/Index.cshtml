@model Hamburgerz.Models.ProfilePageViewModel

@{
    ViewData["Title"] = "Profile";
    var successMessage = TempData["ProfileSuccess"] as string;
    var smallCompany = "Maža";
    var mediumCompany = "Vidutinė";
    var largeCompany = "Didelė";
    var remoteEnvironment = "Nuotolinis";
    var officeEnvironment = "Ofisinis";
    var hybridEnvironment = "Hibridinis";
    var minBirthDate = DateTime.Today.AddYears(-100).ToString("yyyy-MM-dd");
    var maxBirthDate = DateTime.Today.AddYears(-14).ToString("yyyy-MM-dd");
}

<div class="profile-page">
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success profile-alert" role="alert">
            @successMessage
        </div>
    }

    <section class="profile-hero">
        <div class="profile-hero-main">
            <div class="profile-avatar-editor-wrap">
                <button type="button"
                        class="profile-avatar-editor"
                        data-avatar-upload-trigger
                        data-avatar-upload-url="@Url.Action("UploadAvatar", "Profile")"
                        aria-label="Keisti profilio nuotrauką">
                    <div class="profile-avatar profile-avatar-large profile-avatar-editable" data-avatar-root>
                        <img class="profile-avatar-image" data-avatar-image alt="Profilio nuotrauka" hidden />
                        <span class="profile-avatar-fallback" data-avatar-fallback>@Model.AvatarInitial</span>
                        <span class="profile-avatar-overlay" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 20h9" />
                                <path d="M16.5 3.5a2.1 2.1 0 1 1 3 3L7 19l-4 1 1-4Z" />
                            </svg>
                            <span class="profile-avatar-overlay-text">Keisti</span>
                        </span>
                    </div>
                </button>
                <input type="file"
                       class="visually-hidden"
                       data-avatar-upload-input
                       accept="image/png,image/jpeg,image/webp,image/gif,image/bmp,image/*" />
                <div class="visually-hidden">
                    @Html.AntiForgeryToken()
                </div>
            </div>

            <div class="profile-hero-copy">
                <div class="profile-kicker">Profile</div>
                <h1 class="profile-name">@Model.Username</h1>
                <p class="profile-email">@Model.Email</p>
            </div>
        </div>
    </section>

    <div class="profile-grid">
        <section class="profile-panel">
            <div class="panel-kicker">Account</div>
            <h2 class="panel-title">Basic info</h2>

            <div class="profile-info-list">
                <div class="profile-info-row">
                    <span class="profile-info-label">Username</span>
                    <span class="profile-info-value">@Model.Username</span>
                </div>

                <div class="profile-info-row">
                    <span class="profile-info-label">Email</span>
                    <span class="profile-info-value">@Model.Email</span>
                </div>

                <div class="profile-info-row">
                    <span class="profile-info-label">Gender</span>
                    <span class="profile-info-value">@(string.IsNullOrWhiteSpace(Model.Gender) ? "Nenustatyta" : Model.Gender)</span>
                </div>

                <div class="profile-info-row">
                    <span class="profile-info-label">Measurements</span>
                    <span class="profile-info-value">@Model.MeasurementCount</span>
                </div>

                <div class="profile-info-row">
                    <span class="profile-info-label">Last measurement</span>
                    <span class="profile-info-value">@(Model.LastMeasurementDate?.ToString("yyyy-MM-dd HH:mm") ?? "Dar nėra")</span>
                </div>
            </div>
        </section>

        <section class="profile-panel">
            <div class="panel-kicker">Profile defaults</div>
            <h2 class="panel-title">Static details</h2>

            <form asp-controller="Profile" asp-action="Index" method="post" class="profile-defaults-grid">
                <label class="profile-field">
                    <span class="profile-field-label">Birth date</span>
                    <input asp-for="BirthDate" class="form-control" type="date" min="@minBirthDate" max="@maxBirthDate" />
                    <span asp-validation-for="BirthDate" class="text-danger small"></span>
                </label>

                <label class="profile-field">
                    <span class="profile-field-label">Country</span>
                    <select asp-for="CountryID" asp-items="Model.Countries" class="form-select">
                        <option value="">Choose...</option>
                    </select>
                    <span asp-validation-for="CountryID" class="text-danger small"></span>
                </label>

                <label class="profile-field profile-field-wide">
                    <span class="profile-field-label">Job role</span>
                    <div class="job-role-field"
                         data-job-role-field
                         data-job-role-endpoint="@Url.Content("~/api/job-roles")">
                        <input asp-for="JobRole"
                               class="form-control"
                               placeholder="Try dev, qa, project manager..."
                               maxlength="80"
                               autocomplete="off"
                               spellcheck="false"
                               aria-autocomplete="list"
                               data-job-role-input />
                        <div class="job-role-suggestions" data-job-role-suggestions hidden></div>
                    </div>
                    <span asp-validation-for="JobRole" class="text-danger small"></span>
                </label>

                <label class="profile-field">
                    <span class="profile-field-label">Experience years</span>
                    <input asp-for="ExperienceYears" class="form-control" type="number" placeholder="3" />
                    <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                </label>

                <label class="profile-field">
                    <span class="profile-field-label">Company size</span>
                    <select asp-for="CompanySize" class="form-select">
                        <option value="">Choose...</option>
                        <option value="@smallCompany">@smallCompany (1-50)</option>
                        <option value="@mediumCompany">@mediumCompany (51-250)</option>
                        <option value="@largeCompany">@largeCompany (250+)</option>
                    </select>
                    <span asp-validation-for="CompanySize" class="text-danger small"></span>
                </label>

                <label class="profile-field profile-field-wide">
                    <span class="profile-field-label">Work environment</span>
                    <select asp-for="WorkEnvironment" class="form-select">
                        <option value="">Choose...</option>
                        <option value="@remoteEnvironment">@remoteEnvironment</option>
                        <option value="@officeEnvironment">@officeEnvironment</option>
                        <option value="@hybridEnvironment">@hybridEnvironment</option>
                    </select>
                    <span asp-validation-for="WorkEnvironment" class="text-danger small"></span>
                </label>

                <div class="profile-form-actions">
                    <button type="submit" class="btn btn-primary">Išsaugoti profilį</button>
                    <p class="profile-form-note">Šie duomenys bus naudojami kaip šaltinis naujiems matavimams.</p>
                </div>
            </form>
        </section>
    </div>
</div>

<style>
    .profile-page {
        max-width: 1080px;
        margin: 0 auto;
        padding: 24px 0 48px;
    }

    .profile-alert {
        border-radius: 16px;
        margin-bottom: 18px;
    }

    .profile-hero {
        margin-bottom: 20px;
    }

    .profile-hero-main,
    .profile-panel {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 24px;
        box-shadow: var(--shadow-md);
    }

    .profile-hero-main {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 24px 26px;
        background:
            radial-gradient(circle at top left, rgba(var(--color-primary-rgb), 0.18), transparent 30%),
            linear-gradient(135deg, var(--color-surface) 0%, var(--color-bg) 100%);
    }

    .profile-avatar-large {
        width: 92px;
        height: 92px;
        font-size: 2.2rem;
        flex-shrink: 0;
    }

    .profile-avatar-editor-wrap {
        flex-shrink: 0;
    }

    .profile-avatar-editor {
        padding: 0;
        border: 0;
        background: transparent;
        border-radius: 50%;
        cursor: pointer;
    }

    .profile-avatar-editor:focus {
        outline: none;
    }

    .profile-avatar-editor:focus-visible {
        box-shadow: 0 0 0 0.24rem rgba(var(--color-secondary-rgb), 0.22);
    }

    .profile-avatar-editable {
        cursor: pointer;
    }

    .profile-avatar-editable .profile-avatar-image {
        transition: filter 0.2s ease, transform 0.2s ease;
    }

    .profile-avatar-overlay {
        position: absolute;
        inset: 0;
        display: grid;
        place-content: center;
        gap: 6px;
        padding: 12px;
        text-align: center;
        border-radius: inherit;
        color: #fff;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.04), rgba(15, 23, 42, 0.18));
        opacity: 0;
        transform: scale(0.94);
        transition: opacity 0.18s ease, transform 0.18s ease;
    }

    .profile-avatar-overlay svg {
        width: 18px;
        height: 18px;
        margin: 0 auto;
        filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.28));
    }

    .profile-avatar-overlay-text {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-shadow: 0 1px 6px rgba(0, 0, 0, 0.32);
    }

    .profile-avatar-editor:hover .profile-avatar-overlay,
    .profile-avatar-editor:focus-visible .profile-avatar-overlay,
    .profile-avatar-editor.is-loading .profile-avatar-overlay {
        opacity: 1;
        transform: scale(1);
    }

    .profile-avatar-editor:hover .profile-avatar-image,
    .profile-avatar-editor:focus-visible .profile-avatar-image,
    .profile-avatar-editor.is-loading .profile-avatar-image {
        filter: blur(6px);
        transform: scale(1.08);
    }

    .profile-hero-copy {
        min-width: 0;
    }

    .profile-kicker,
    .panel-kicker {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-primary);
        font-weight: 800;
        margin-bottom: 8px;
    }

    .profile-name,
    .panel-title {
        margin: 0;
        color: var(--color-text);
        font-weight: 800;
    }

    .profile-name {
        font-size: 34px;
        line-height: 1.05;
    }

    .profile-email {
        margin: 8px 0 0;
        color: var(--color-text-muted);
        font-size: 16px;
        font-weight: 600;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: minmax(260px, 0.85fr) minmax(0, 1.15fr);
        gap: 18px;
    }

    .profile-panel {
        padding: 22px 24px;
    }

    .panel-title {
        font-size: 26px;
        margin-bottom: 14px;
    }

    .profile-info-list {
        display: grid;
        gap: 12px;
    }

    .profile-info-row {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: center;
        padding: 14px 16px;
        border-radius: 16px;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
    }

    .profile-info-label,
    .profile-field-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--color-text-muted);
    }

    .profile-info-value {
        color: var(--color-text);
        font-weight: 700;
        text-align: right;
    }

    .profile-defaults-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-top: 18px;
    }

    .profile-field {
        display: grid;
        gap: 8px;
    }

    .profile-field-wide {
        grid-column: span 2;
    }

    .profile-form-actions {
        grid-column: 1 / -1;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        margin-top: 4px;
    }

    .profile-form-note {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 13px;
    }

    @@media (max-width: 992px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .profile-page {
            padding-top: 12px;
        }

        .profile-hero-main {
            flex-direction: column;
            align-items: flex-start;
        }

        .profile-name {
            font-size: 28px;
        }

        .profile-defaults-grid {
            grid-template-columns: 1fr;
        }

        .profile-field-wide,
        .profile-form-actions {
            grid-column: auto;
        }

        .profile-info-row {
            flex-direction: column;
            align-items: flex-start;
        }

        .profile-info-value {
            text-align: left;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
