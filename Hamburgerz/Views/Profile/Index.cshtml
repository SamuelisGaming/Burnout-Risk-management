@model Hamburgerz.Models.ProfilePageViewModel

@{
    ViewData["Title"] = "Profile";
    var smallCompany = "Ma\u017Ea";
    var mediumCompany = "Vidutin\u0117";
    var largeCompany = "Didel\u0117";
}

<div class="profile-page">
    <section class="profile-hero">
        <div class="profile-hero-main">
            <div class="profile-avatar profile-avatar-large">
                @Model.AvatarInitial
            </div>

            <div class="profile-hero-copy">
                <div class="profile-kicker">Profile</div>
                <h1 class="profile-name">@Model.Username</h1>
                <p class="profile-email">@Model.Email</p>
            </div>
        </div>
    </section>

    <div class="profile-grid">
        <section class="profile-panel">
            <div class="panel-kicker">Account</div>
            <h2 class="panel-title">Basic info</h2>

            <div class="profile-info-list">
                <div class="profile-info-row">
                    <span class="profile-info-label">Username</span>
                    <span class="profile-info-value">@Model.Username</span>
                </div>

                <div class="profile-info-row">
                    <span class="profile-info-label">Email</span>
                    <span class="profile-info-value">@Model.Email</span>
                </div>

                <div class="profile-info-row">
                    <span class="profile-info-label">Gender</span>
                    <span class="profile-info-value">@(string.IsNullOrWhiteSpace(Model.Gender) ? "Not set yet" : Model.Gender)</span>
                </div>
            </div>
        </section>

        <section class="profile-panel">
            <div class="panel-kicker">Measurement defaults</div>
            <h2 class="panel-title">Static details</h2>

            <form class="profile-defaults-grid" onsubmit="return false;">
                <label class="profile-field">
                    <span class="profile-field-label">Age</span>
                    <input class="form-control" type="number" value="@(Model.Age?.ToString() ?? string.Empty)" placeholder="24" />
                </label>

                <label class="profile-field">
                    <span class="profile-field-label">Country</span>
                    <input class="form-control" type="text" value="@Model.Country" placeholder="Lithuania" />
                </label>

                <label class="profile-field profile-field-wide">
                    <span class="profile-field-label">Job role</span>
                    <input class="form-control" type="text" value="@Model.JobRole" placeholder="Frontend developer" />
                </label>

                <label class="profile-field">
                    <span class="profile-field-label">Experience years</span>
                    <input class="form-control" type="number" value="@(Model.ExperienceYears?.ToString() ?? string.Empty)" placeholder="3" />
                </label>

                <label class="profile-field">
                    <span class="profile-field-label">Company size</span>
                    <select class="form-select">
                        <option value="">Choose...</option>
                        <option value="@smallCompany" selected="@(Model.CompanySize == smallCompany ? "selected" : null)">@smallCompany (1-50)</option>
                        <option value="@mediumCompany" selected="@(Model.CompanySize == mediumCompany ? "selected" : null)">@mediumCompany (51-250)</option>
                        <option value="@largeCompany" selected="@(Model.CompanySize == largeCompany ? "selected" : null)">@largeCompany (250+)</option>
                    </select>
                </label>

                <label class="profile-field">
                    <span class="profile-field-label">Work environment</span>
                    <select class="form-select">
                        <option value="">Choose...</option>
                        <option value="Remote" selected="@(Model.WorkEnvironment == "Remote" ? "selected" : null)">Remote</option>
                        <option value="Office" selected="@(Model.WorkEnvironment == "Office" ? "selected" : null)">Office</option>
                        <option value="Hybrid" selected="@(Model.WorkEnvironment == "Hybrid" ? "selected" : null)">Hybrid</option>
                    </select>
                </label>

                <label class="profile-field">
                    <span class="profile-field-label">Internet speed</span>
                    <input class="form-control" type="number" value="@(Model.InternetSpeed?.ToString() ?? string.Empty)" placeholder="300" />
                </label>
            </form>
        </section>
    </div>
</div>

<style>
    .profile-page {
        max-width: 1080px;
        margin: 0 auto;
        padding: 24px 0 48px;
    }

    .profile-hero {
        margin-bottom: 20px;
    }

    .profile-hero-main,
    .profile-panel {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 24px;
        box-shadow: var(--shadow-md);
    }

    .profile-hero-main {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 24px 26px;
        background:
            radial-gradient(circle at top left, rgba(var(--color-primary-rgb), 0.18), transparent 30%),
            linear-gradient(135deg, var(--color-surface) 0%, var(--color-bg) 100%);
    }

    .profile-avatar-large {
        width: 92px;
        height: 92px;
        font-size: 2.2rem;
        flex-shrink: 0;
    }

    .profile-hero-copy {
        min-width: 0;
    }

    .profile-kicker,
    .panel-kicker {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-primary);
        font-weight: 800;
        margin-bottom: 8px;
    }

    .profile-name,
    .panel-title {
        margin: 0;
        color: var(--color-text);
        font-weight: 800;
    }

    .profile-name {
        font-size: 34px;
        line-height: 1.05;
    }

    .profile-email {
        margin: 8px 0 0;
        color: var(--color-text-muted);
        font-size: 16px;
        font-weight: 600;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: minmax(260px, 0.85fr) minmax(0, 1.15fr);
        gap: 18px;
    }

    .profile-panel {
        padding: 22px 24px;
    }

    .panel-title {
        font-size: 26px;
        margin-bottom: 14px;
    }

    .profile-info-list {
        display: grid;
        gap: 12px;
    }

    .profile-info-row {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: center;
        padding: 14px 16px;
        border-radius: 16px;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
    }

    .profile-info-label,
    .profile-field-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--color-text-muted);
    }

    .profile-info-value {
        color: var(--color-text);
        font-weight: 700;
        text-align: right;
    }

    .profile-defaults-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-top: 18px;
    }

    .profile-field {
        display: grid;
        gap: 8px;
    }

    .profile-field-wide {
        grid-column: span 2;
    }

    @@media (max-width: 992px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .profile-page {
            padding-top: 12px;
        }

        .profile-hero-main {
            flex-direction: column;
            align-items: flex-start;
        }

        .profile-name {
            font-size: 28px;
        }

        .profile-defaults-grid {
            grid-template-columns: 1fr;
        }

        .profile-field-wide {
            grid-column: auto;
        }

        .profile-info-row {
            flex-direction: column;
            align-items: flex-start;
        }

        .profile-info-value {
            text-align: left;
        }
    }
</style>
