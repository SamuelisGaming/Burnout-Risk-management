@model List<Hamburgerz.Models.RiskMeasurement>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = @Localizer["title1"];
    var hasAiAccess = ViewBag.HasAiAccess is bool aiAccess && aiAccess;
    var analysisController = (ViewBag.AnalysisController as string) ?? "Profile";
    var analysisAction = (ViewBag.AnalysisAction as string) ?? "Analysis";
    var analysisUserId = ViewBag.AnalysisUserId;
    var analysisEndpoint = (ViewBag.AnalysisEndpoint as string) ?? Url.Action("GetAnalysis", "Profile");

    var measurements = (Model ?? new List<Hamburgerz.Models.RiskMeasurement>())
        .OrderBy(x => x.TimeStamp)
        .ToList();

    var selectedPeriod = (Context.Request.Query["period"].ToString() ?? "").Trim().ToLowerInvariant();
    if (string.IsNullOrWhiteSpace(selectedPeriod))
    {
        selectedPeriod = "30d";
    }

    var now = DateTime.Now;

    DateTime? periodStart;
    switch (selectedPeriod)
    {
        case "7d":
            periodStart = now.AddDays(-7);
            break;
        case "30d":
            periodStart = now.AddDays(-30);
            break;
        case "3m":
            periodStart = now.AddMonths(-3);
            break;
        case "6m":
            periodStart = now.AddMonths(-6);
            break;
        case "1y":
            periodStart = now.AddYears(-1);
            break;
        case "all":
            periodStart = null;
            break;
        default:
            selectedPeriod = "30d";
            periodStart = now.AddDays(-30);
            break;
    }

    string periodLabel;
    switch (selectedPeriod)
    {
        case "7d":
            periodLabel = @Localizer["last7d"].Value;
            break;
        case "30d":
            periodLabel = @Localizer["last30d"].Value;
            break;
        case "3m":
            periodLabel = @Localizer["last3m"].Value;
            break;
        case "6m":
            periodLabel = @Localizer["last6m"].Value;
            break;
        case "1y":
            periodLabel = @Localizer["lasty"].Value;
            break;
        case "all":
            periodLabel = @Localizer["all"].Value;
            break;
        default:
            periodLabel = @Localizer["last30d"].Value;
            break;
    }

    DateTime? previousPeriodStart;
    switch (selectedPeriod)
    {
        case "7d":
            previousPeriodStart = now.AddDays(-14);
            break;
        case "30d":
            previousPeriodStart = now.AddDays(-60);
            break;
        case "3m":
            previousPeriodStart = now.AddMonths(-6);
            break;
        case "6m":
            previousPeriodStart = now.AddYears(-1);
            break;
        case "1y":
            previousPeriodStart = now.AddYears(-2);
            break;
        case "all":
            previousPeriodStart = null;
            break;
        default:
            previousPeriodStart = now.AddDays(-60);
            break;
    }

    var filteredMeasurements = periodStart.HasValue
        ? measurements.Where(x => x.TimeStamp >= periodStart.Value).ToList()
        : measurements.ToList();

    var previousMeasurements = periodStart.HasValue && previousPeriodStart.HasValue
        ? measurements.Where(x => x.TimeStamp >= previousPeriodStart.Value && x.TimeStamp < periodStart.Value).ToList()
        : new List<Hamburgerz.Models.RiskMeasurement>();

    var totalCount = measurements.Count;
    var filteredCount = filteredMeasurements.Count;
    var latest = measurements.LastOrDefault();

    Func<string?, string> normalizeStress = value =>
    {
        var normalized = (value ?? string.Empty).Trim().ToLowerInvariant();
        // @Localizer["high"] @Localizer["medium"] @Localizer["low"] @Localizer["unknown"]
        // tingiu tikrint kas tik rodoma o kas actually svarbūs kintamieji tai pakeiskit kur reikia
        if (normalized.Contains("auk") || normalized.Contains("high"))
        {
            return "high";
        }

        if (normalized.Contains("vid") || normalized.Contains("med"))
        {
            return "medium";
        }

        if (normalized.Contains("žem") || normalized.Contains("zem") || normalized.Contains("low"))
        {
            return "low";
        }

        return "unknown";
    };

    Func<Hamburgerz.Models.RiskMeasurement, bool> isStressed = item =>
    {
        var level = normalizeStress(item.StressLevel);
        return level == "medium" || level == "high";
    };

    var avgSleep = filteredCount > 0 ? filteredMeasurements.Average(x => x.SleepHours) : 0;
    var avgWork = filteredCount > 0 ? filteredMeasurements.Average(x => x.WorkHours) : 0;
    var avgProductivity = filteredCount > 0 ? filteredMeasurements.Average(x => x.ProductivityScore) : 0;
    var avgRisk = filteredCount > 0 ? filteredMeasurements.Average(x => x.BurnoutPercent) : 0;

    var stressedCount = filteredMeasurements.Count(isStressed);
    var highStressCount = filteredMeasurements.Count(x => normalizeStress(x.StressLevel) == "high");
    var mediumStressCount = filteredMeasurements.Count(x => normalizeStress(x.StressLevel) == "medium");
    var lowStressCount = filteredMeasurements.Count(x => normalizeStress(x.StressLevel) == "low");

    var stressedShare = filteredMeasurements.Any()
        ? (int)Math.Round(stressedCount * 100.0 / filteredMeasurements.Count)
        : 0;

    var highStressShare = filteredMeasurements.Any()
        ? (int)Math.Round(highStressCount * 100.0 / filteredMeasurements.Count)
        : 0;

    var mediumStressShare = filteredMeasurements.Any()
        ? (int)Math.Round(mediumStressCount * 100.0 / filteredMeasurements.Count)
        : 0;

    var lowStressShare = filteredMeasurements.Any()
        ? (int)Math.Round(lowStressCount * 100.0 / filteredMeasurements.Count)
        : 0;

    var shortSleepShare = filteredMeasurements.Any()
        ? (int)Math.Round(filteredMeasurements.Count(x => x.SleepHours < 6) * 100.0 / filteredMeasurements.Count)
        : 0;

    var overtimeShare = filteredMeasurements.Any()
        ? (int)Math.Round(filteredMeasurements.Count(x => x.WorkHours >= 9) * 100.0 / filteredMeasurements.Count)
        : 0;

    double? sleepDelta = filteredMeasurements.Any() && previousMeasurements.Any()
        ? filteredMeasurements.Average(x => x.SleepHours) - previousMeasurements.Average(x => x.SleepHours)
        : null;

    double? workDelta = filteredMeasurements.Any() && previousMeasurements.Any()
        ? filteredMeasurements.Average(x => x.WorkHours) - previousMeasurements.Average(x => x.WorkHours)
        : null;

    double? productivityDelta = filteredMeasurements.Any() && previousMeasurements.Any()
        ? filteredMeasurements.Average(x => x.ProductivityScore) - previousMeasurements.Average(x => x.ProductivityScore)
        : null;

    var recentTrend = filteredMeasurements
        .Skip(Math.Max(0, filteredCount - 7))
        .ToList();

    var maxRecentMetric = recentTrend.Any()
        ? Math.Max(10d, recentTrend.Max(x => Math.Max((double)x.SleepHours, (double)x.WorkHours)))
        : 10d;

    var monthlyTrend = filteredMeasurements
        .GroupBy(x => new DateTime(x.TimeStamp.Year, x.TimeStamp.Month, 1))
        .OrderBy(x => x.Key)
        .Select(group => new
        {
            Month = group.Key,
            Label = group.Key.ToString("MMM"),
            AvgSleep = group.Average(x => x.SleepHours),
            AvgWork = group.Average(x => x.WorkHours),
            Count = group.Count()
        })
        .ToList();

    var allLowRisk = filteredMeasurements.Any() && filteredMeasurements.All(x => x.RiskText == "Low");
    var windowAvgSleep = filteredMeasurements.Any() ? filteredMeasurements.Average(x => x.SleepHours) : 0;
    var windowAvgWork = filteredMeasurements.Any() ? filteredMeasurements.Average(x => x.WorkHours) : 0;

    var overviewText = filteredCount < 3
        ? @Localizer["last30d"].Value
        : allLowRisk
            ? @Localizer["alllowrisk"].Value
            //: $"{periodLabel} shows {stressedShare}% stressed entries, with an average of {windowAvgSleep:0.0}h sleep and {window
            // AvgWork:0.0}h workdays.";
            : $"{periodLabel} {@Localizer["over1"].Value} {stressedShare} {@Localizer["over2"].Value} {windowAvgSleep:0.0} {@Localizer["over3"].Value} {windowAvgWork:0.0} {@Localizer["over4"].Value}";

    // Burnout risk distribution
    var lowBurnoutCount = filteredMeasurements.Count(x => x.BurnoutPercent < 40);
    var medBurnoutCount = filteredMeasurements.Count(x => x.BurnoutPercent >= 40 && x.BurnoutPercent < 70);
    var highBurnoutCount = filteredMeasurements.Count(x => x.BurnoutPercent >= 70);
    var lowBurnoutShare = filteredCount > 0 ? (int)Math.Round(lowBurnoutCount * 100.0 / filteredCount) : 0;
    var medBurnoutShare = filteredCount > 0 ? (int)Math.Round(medBurnoutCount * 100.0 / filteredCount) : 0;
    var highBurnoutShare = filteredCount > 0 ? (int)Math.Round(highBurnoutCount * 100.0 / filteredCount) : 0;

    // Wellbeing averages (MoodScore 1-4, FocusScore 1-3, DisconnectScore 1-3)
    // These are daily questions asked on every measurement, so older records may be null (pre-feature).
    // Show as long as ≥1 sample exists — single-measurement averages are fine for daily fields.
    var moodSamples      = filteredMeasurements.Where(x => x.MoodScore.HasValue).ToList();
    var focusSamples     = filteredMeasurements.Where(x => x.FocusScore.HasValue).ToList();
    var discSamples      = filteredMeasurements.Where(x => x.DisconnectScore.HasValue).ToList();
    var hasMoodData       = moodSamples.Count >= 1;
    var hasFocusData      = focusSamples.Count >= 1;
    var hasDisconnectData = discSamples.Count >= 1;
    var avgMood       = hasMoodData       ? moodSamples.Average(x => (double)x.MoodScore!.Value)        : 0.0;
    var avgFocus      = hasFocusData      ? focusSamples.Average(x => (double)x.FocusScore!.Value)      : 0.0;
    var avgDisconnect = hasDisconnectData ? discSamples.Average(x => (double)x.DisconnectScore!.Value)   : 0.0;
    // Map to 0-100% for progress bar: score 1 = 0%, max = 100%
    var moodPct       = hasMoodData       ? (int)Math.Round((avgMood - 1) / 3.0 * 100)  : 0;
    var focusPct      = hasFocusData      ? (int)Math.Round((avgFocus - 1) / 2.0 * 100) : 0;
    var disconnectPct = hasDisconnectData ? (int)Math.Round((avgDisconnect - 1) / 2.0 * 100) : 0;

    // Digital load
    var avgScreenTime = filteredCount > 0 ? filteredMeasurements.Average(x => (double)x.ScreenTime) : 0.0;
    var avgMeetings = filteredCount > 0 ? filteredMeasurements.Average(x => (double)x.MeetingsPerDay) : 0.0;
    var avgExercise = filteredCount > 0 ? filteredMeasurements.Average(x => (double)x.ExerciseHours) : 0.0;
    var highScreenShare = filteredCount > 0 ? (int)Math.Round(filteredMeasurements.Count(x => x.ScreenTime >= 8) * 100.0 / filteredCount) : 0;
    var noExerciseShare = filteredCount > 0 ? (int)Math.Round(filteredMeasurements.Count(x => x.ExerciseHours <= 0) * 100.0 / filteredCount) : 0;

    // Burnout trend (last 10 measurements in period)
    var burnoutTrend = filteredMeasurements.Skip(Math.Max(0, filteredCount - 10)).ToList();
    // Normalize bars to tallest bar = 100% (like the sleep/work chart)
    var maxBurnoutTrendPct = burnoutTrend.Any() ? Math.Max(10, burnoutTrend.Max(x => x.BurnoutPercent)) : 10;
}

<div class="analysis-page">
    <div class="analysis-hero">
        <div>
            <h1 class="analysis-title">@Localizer["title1"]</h1>            
            <p class="analysis-subtitle">@Localizer["title1desc"]</p>
        </div>

        @if (latest != null)
        {
            <div class="hero-pills">
                <div class="hero-pill">@totalCount @Localizer["meas"].Value</div>
                <div class="hero-pill">@Localizer["latest"] @latest.TimeStamp.ToString("yyyy-MM-dd")</div>

                <form method="get" asp-controller="@analysisController" asp-action="@analysisAction" class="period-selector-form">
                    @if (analysisUserId != null)
                    {
                        <input type="hidden" name="userId" value="@analysisUserId" />
                    }
                    <label for="periodSelect" class="sr-only">@Localizer["selrange"]</label>
                    <div class="period-select-wrap">
                        <select id="periodSelect" name="period" class="period-select" onchange="this.form.submit()">
                            <option value="7d" selected="@(selectedPeriod == "7d")">@Localizer["last7d"]</option>
                            <option value="30d" selected="@(selectedPeriod == "30d")">@Localizer["last30d"]</option>
                            <option value="3m" selected="@(selectedPeriod == "3m")">@Localizer["last3m"]</option>
                            <option value="6m" selected="@(selectedPeriod == "6m")">@Localizer["last6m"]</option>
                            <option value="1y" selected="@(selectedPeriod == "1y")">@Localizer["lasty"]</option>
                            <option value="all" selected="@(selectedPeriod == "all")">@Localizer["all"]</option>
                        </select>
                    </div>
                </form>
            </div>
        }
    </div>

    @if (!measurements.Any())
    {
        <div class="empty-state-card">
            <div class="empty-state-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="28" height="28"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </div>
            <h3 class="empty-state-title">@Localizer["measno"]</h3>
            <p class="empty-state-desc">@Localizer["measnodesc"]</p>
            <a asp-controller="Data" asp-action="DataEntry" class="primary-btn">@Localizer["measfirst"]</a>
        </div>
    }
    else
    {
        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-label">@Localizer["measrange"]</div>
                <div class="summary-value">@filteredCount</div>
                <div class="summary-note">@periodLabel</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">@Localizer["avgsleep"]</div>
                <div class="summary-value">@avgSleep.ToString("0.0")h</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">@Localizer["avgwork"]</div>
                <div class="summary-value">@avgWork.ToString("0.0")h</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">@Localizer["stressshare"]</div>
                <div class="summary-value">@stressedShare%</div>
                <div class="summary-note">@periodLabel</div>
            </div>
        </div>

        <div class="insight-banner">
            <div>
                <div class="section-kicker">@Localizer["over"]</div>
                <h2 class="section-title">@Localizer["overdesc"]</h2>
                <p class="section-copy">@overviewText</p>
            </div>

            <div class="insight-badges">
                <div class="insight-badge">
                    <span>@Localizer["avgprod"]</span>
                    <strong>@avgProductivity.ToString("0")</strong>
                </div>

                <div class="insight-badge">
                    <span>@Localizer["avgburn"]</span>
                    <strong>@Math.Round(avgRisk, 0)%</strong>
                </div>
            </div>
        </div>

        @if (filteredCount == 0)
        {
            <div class="period-empty-banner">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" width="18" height="18"><circle cx="10" cy="10" r="8"/><path d="M10 6v4.5"/><circle cx="10" cy="14" r=".75" fill="currentColor" stroke="none"/></svg>
                @Localizer["notenoughperiod"]
            </div>
        }

        <div class="analysis-grid">
            <section class="panel panel-wide">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">@Localizer["trend"]</div>
                        <h3 class="panel-title">@Localizer["sleepvswork"]</h3>
                    </div>
                    <div class="panel-note">@Localizer["last"] @recentTrend.Count @Localizer["savedmeas"]</div>
                </div>

                <div class="legend">
                    <span class="legend-item"><span class="legend-dot sleep"></span>@Localizer["sleep"]</span>
                    <span class="legend-item"><span class="legend-dot work"></span>@Localizer["work"]</span>
                </div>

                <div class="trend-chart">
                    @foreach (var point in recentTrend)
                    {
                        var sleepHeight = point.SleepHours <= 0
                        ? 0
                        : Math.Max(10, (int)Math.Round(point.SleepHours / maxRecentMetric * 100));

                        var workHeight = point.WorkHours <= 0
                        ? 0
                        : Math.Max(10, (int)Math.Round(point.WorkHours / maxRecentMetric * 100));

                        <div class="trend-group">
                            <div class="trend-bars">
                                <div class="trend-bar sleep-bar" style="height:@($"{sleepHeight}%")"></div>
                                <div class="trend-bar work-bar" style="height:@($"{workHeight}%")"></div>
                            </div>
                            <div class="trend-values">@point.SleepHours.ToString("0.0")h / @point.WorkHours.ToString("0.0")h</div>
                            <div class="trend-label">@point.TimeStamp.ToString("MM-dd")</div>
                        </div>
                    }
                </div>
            </section>

            <section class="panel">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">@Localizer["stress"]</div>
                        <h3 class="panel-title">@Localizer["stressmix"]</h3>
                    </div>
                    <div class="panel-note">@periodLabel</div>
                </div>

                @if (filteredCount == 0)
                {
                    <p class="panel-empty-note">@Localizer["notenoughperiod"]</p>
                }
                else
                {
                <div class="mix-list">
                    <div class="mix-row">
                        <div class="mix-meta">
                            <span>@Localizer["stresslow"]</span>
                            <strong>@lowStressShare%</strong>
                        </div>
                        <div class="mix-track">
                            <div class="mix-fill low" style="width:@($"{lowStressShare}%")"></div>
                        </div>
                    </div>

                    <div class="mix-row">
                        <div class="mix-meta">
                            <span>@Localizer["stressmed"]</span>
                            <strong>@mediumStressShare%</strong>
                        </div>
                        <div class="mix-track">
                            <div class="mix-fill medium" style="width:@($"{mediumStressShare}%")"></div>
                        </div>
                    </div>

                    <div class="mix-row">
                        <div class="mix-meta">
                            <span>@Localizer["stresshigh"]</span>
                            <strong>@highStressShare%</strong>
                        </div>
                        <div class="mix-track">
                            <div class="mix-fill high" style="width:@($"{highStressShare}%")"></div>
                        </div>
                    </div>
                </div>
                }
            </section>

            @* Row 2 : Habit Signals (4) | Burnout Trend (8)  — narrow LEFT, wide RIGHT *@
            <section class="panel">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">@Localizer["habits"]</div>
                        <h3 class="panel-title">@Localizer["signals"]</h3>
                    </div>
                    <div class="panel-note">@periodLabel</div>
                </div>

                <div class="signal-list">
                    <div class="signal-card">
                        <div class="signal-label">@Localizer["signal1"]</div>
                        <div class="signal-value">@shortSleepShare%</div>
                    </div>

                    <div class="signal-card">
                        <div class="signal-label">@Localizer["signal2"]</div>
                        <div class="signal-value">@overtimeShare%</div>
                    </div>

                    <div class="signal-card">
                        <div class="signal-label">@Localizer["signal3"]</div>
                        <div class="signal-value">
                            @(sleepDelta.HasValue ? $"{sleepDelta.Value:+0.0;-0.0;0.0}h" : @Localizer["notenough"].Value)
                        </div>
                    </div>

                    <div class="signal-card">
                        <div class="signal-label">@Localizer["signal4"]</div>
                        <div class="signal-value">
                            @(workDelta.HasValue ? $"{workDelta.Value:+0.0;-0.0;0.0}h" : @Localizer["notenough"].Value)
                        </div>
                    </div>

                    <div class="signal-card">
                        <div class="signal-label">@Localizer["signal5"]</div>
                        <div class="signal-value">
                            @(productivityDelta.HasValue ? $"{productivityDelta.Value:+0;-0;0}" : @Localizer["notenough"].Value)
                        </div>
                    </div>
                </div>
            </section>

            <section class="panel panel-wide">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">@Localizer["burnoutDistKicker"]</div>
                        <h3 class="panel-title">@Localizer["burnoutTrendTitle"]</h3>
                    </div>
                    <div class="panel-note">@Localizer["last"] @burnoutTrend.Count @Localizer["savedmeas"]</div>
                </div>

                @if (burnoutTrend.Any())
                {
                    <div class="burnout-zone-legend">
                        <span class="bzone-dot bzone-low"></span><span>@Localizer["riskLow"] (&lt;40%)</span>
                        <span class="bzone-dot bzone-medium"></span><span>@Localizer["riskMedium"] (40–69%)</span>
                        <span class="bzone-dot bzone-high"></span><span>@Localizer["riskHigh"] (70%+)</span>
                    </div>
                    <div class="burnout-trend-chart">
                        @foreach (var point in burnoutTrend)
                        {
                            var bh = point.BurnoutPercent;
                            var barCls = bh >= 70 ? "bbar-high" : bh >= 40 ? "bbar-medium" : "bbar-low";
                            var barH  = Math.Max(4, (int)Math.Round((double)bh / maxBurnoutTrendPct * 100));
                            <div class="burnout-trend-group">
                                <div class="burnout-trend-bar-wrap">
                                    <div class="burnout-trend-bar @barCls" style="height:@($"{barH}%")"></div>
                                </div>
                                <div class="burnout-trend-pct @(bh >= 70 ? "bpct-high" : bh >= 40 ? "bpct-medium" : "bpct-low")">@bh%</div>
                                <div class="trend-label">@point.TimeStamp.ToString("MM-dd")</div>
                            </div>
                        }
                    </div>
                }
            </section>

            @* Row 3 : AI insights (8) | Burnout Distribution (4)  — wide LEFT, narrow RIGHT *@
            @if (hasAiAccess)
            {
            <section class="panel panel-wide" id="aiInsightsPanel">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">@Localizer["ai"]</div>
                        <h3 class="panel-title">@Localizer["period"]</h3>
                    </div>
                    <div class="panel-note ai-loading-state" id="aiInsightsLoading">
                        <span class="ai-loading-dot" aria-hidden="true"></span>
                        <span>@Localizer["analysing"]</span>
                    </div>
                </div>
                <div id="aiInsightsResult" class="ai-insights-result" style="display:none;"></div>
            </section>
            }
            else
            {
            <section class="panel panel-wide premium-locked-panel">
                <div class="premium-blur-preview" aria-hidden="true">
                    <div class="panel-header">
                        <div>
                            <div class="section-kicker">@Localizer["ai"]</div>
                            <h3 class="panel-title">@Localizer["period"]</h3>
                        </div>
                        <div class="panel-note">@Localizer["premium"]</div>
                    </div>

                    <div class="ai-insight-layout">
                        <p class="ai-insight-text">
                            @Localizer["lockedPreview1"]
                            @Localizer["lockedPreview2"]
                        </p>
                        <div class="ai-action-row">
                            <span class="ai-action-label">@Localizer["trythis"].Value</span>
                            <span class="ai-action-text">@Localizer["lockedAction"]</span>
                        </div>
                    </div>
                </div>

                <button type="button"
                        class="premium-lock-overlay"
                        data-bs-toggle="modal"
                        data-bs-target="#premiumModal"
                        aria-label="@Localizer["openPremium"].Value">
                    <span class="premium-lock-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="5" y="10" width="14" height="10" rx="2.5" stroke="currentColor" stroke-width="2" />
                            <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            <path d="M12 14v2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </span>
                    <span class="premium-lock-title">@Localizer["premiumRequired"]</span>
                    <span class="premium-lock-copy">@Localizer["premiumLockCopy"]</span>
                </button>
            </section>
            }

            <section class="panel">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">@Localizer["burnoutDistKicker"]</div>
                        <h3 class="panel-title">@Localizer["burnoutDistTitle"]</h3>
                    </div>
                    <div class="panel-note">@periodLabel</div>
                </div>

                @if (filteredCount == 0)
                {
                    <p class="panel-empty-note">@Localizer["notenoughperiod"]</p>
                }
                else
                {
                <div class="mix-list">
