                        <div class="mix-meta">
                            <span>@Localizer["riskHigh"]</span>
                            <strong>@highBurnoutShare%</strong>
                        </div>
                        <div class="mix-track">
                            <div class="mix-fill high" style="width:@($"{highBurnoutShare}%")"></div>
                        </div>
                    </div>
                </div>
                }
            </section>

            @* Row 4 : Wellbeing (6) | Digital Load (6)  — equal halves *@
            <section class="panel panel-half">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">@Localizer["wellbeingKicker"]</div>
                        <h3 class="panel-title">@Localizer["wellbeingTitle"]</h3>
                    </div>
                    <div class="panel-note">@periodLabel</div>
                </div>

                <div class="wb-list">
                    <div class="wb-row">
                        <div class="wb-meta">
                            <span>@Localizer["wbMood"]</span>
                            <strong>@(hasMoodData ? $"{avgMood:0.0} / 4" : @Localizer["notenough"].Value)</strong>
                        </div>
                        @if (hasMoodData)
                        {
                            <div class="mix-track"><div class="mix-fill @(moodPct >= 67 ? "low" : moodPct >= 34 ? "medium" : "high")" style="width:@($"{moodPct}%")"></div></div>
                        }
                    </div>

                    <div class="wb-row">
                        <div class="wb-meta">
                            <span>@Localizer["wbFocus"]</span>
                            <strong>@(hasFocusData ? $"{avgFocus:0.0} / 3" : @Localizer["notenough"].Value)</strong>
                        </div>
                        @if (hasFocusData)
                        {
                            <div class="mix-track"><div class="mix-fill @(focusPct >= 67 ? "low" : focusPct >= 34 ? "medium" : "high")" style="width:@($"{focusPct}%")"></div></div>
                        }
                    </div>

                    <div class="wb-row">
                        <div class="wb-meta">
                            <span>@Localizer["wbDisconnect"]</span>
                            <strong>@(hasDisconnectData ? $"{avgDisconnect:0.0} / 3" : @Localizer["notenough"].Value)</strong>
                        </div>
                        @if (hasDisconnectData)
                        {
                            <div class="mix-track"><div class="mix-fill @(disconnectPct >= 67 ? "low" : disconnectPct >= 34 ? "medium" : "high")" style="width:@($"{disconnectPct}%")"></div></div>
                        }
                    </div>
                </div>
            </section>

            <section class="panel panel-half">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">@Localizer["digitalKicker"]</div>
                        <h3 class="panel-title">@Localizer["digitalTitle"]</h3>
                    </div>
                    <div class="panel-note">@periodLabel</div>
                </div>

                <div class="signal-list signal-list-digital">
                    <div class="signal-card">
                        <div class="signal-label">@Localizer["avgScreen"]</div>
                        <div class="signal-value">@avgScreenTime.ToString("0.0")h</div>
                    </div>

                    <div class="signal-card">
                        <div class="signal-label">@Localizer["avgMeetings"]</div>
                        <div class="signal-value">@avgMeetings.ToString("0.0")</div>
                    </div>

                    <div class="signal-card">
                        <div class="signal-label">@Localizer["avgExercise"]</div>
                        <div class="signal-value">@avgExercise.ToString("0.0")h</div>
                    </div>

                    <div class="signal-card">
                        <div class="signal-label">@Localizer["highScreenDays"]</div>
                        <div class="signal-value">@highScreenShare%</div>
                    </div>

                    <div class="signal-card">
                        <div class="signal-label">@Localizer["noExerciseDays"]</div>
                        <div class="signal-value">@noExerciseShare%</div>
                    </div>
                </div>
            </section>

            <section class="panel panel-full">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">@Localizer["timeline"]</div>
                        <h3 class="panel-title">@Localizer["timelinedescr1"]</h3>
                    </div>
                    <div class="panel-note">@Localizer["timelinedescr2"]</div>
                </div>

                <div class="legend">
                    <span class="legend-item"><span class="legend-dot sleep"></span>@Localizer["sleep"]</span>
                    <span class="legend-item"><span class="legend-dot work"></span>@Localizer["work"]</span>
                    <span class="legend-item"><span class="legend-dot leisure"></span>@Localizer["leisure"]</span>
                </div>

                <div class="month-list">
                    @foreach (var month in monthlyTrend)
                    {
                        var rawOther = Math.Max(0, 24 - month.AvgSleep - month.AvgWork);
                        var totalHours = month.AvgSleep + month.AvgWork + rawOther;
                        var sleepPct = totalHours > 0 ? (int)Math.Round(month.AvgSleep / totalHours * 100) : 0;
                        var workPct = totalHours > 0 ? (int)Math.Round(month.AvgWork / totalHours * 100) : 0;
                        var otherPct = Math.Max(0, 100 - sleepPct - workPct);

                        <div class="month-row">
                            <div class="month-label-block">
                                <div class="month-label">@month.Month.ToString("MMM yyyy")</div>
                                <div class="month-count">@month.Count @Localizer["meas"]</div>
                            </div>

                            <div class="month-allocation">
                                <div class="allocation-bar">
                                    <div class="allocation-fill sleep-fill" style="width:@($"{sleepPct}%")"></div>
                                    <div class="allocation-fill work-fill" style="width:@($"{workPct}%")"></div>
                                    <div class="allocation-fill leisure-fill" style="width:@($"{otherPct}%")"></div>
                                </div>

                                <div class="month-share-row">
                                    <div class="month-share-item">
                                        <span class="month-share-dot sleep-fill"></span>
                                        <span>@Localizer["sleep"]</span>
                                        <strong>@sleepPct%</strong>
                                    </div>

                                    <div class="month-share-item">
                                        <span class="month-share-dot work-fill"></span>
                                        <span>@Localizer["work"]</span>
                                        <strong>@workPct%</strong>
                                    </div>

                                    <div class="month-share-item">
                                        <span class="month-share-dot leisure-fill"></span>
                                        <span>@Localizer["leisure"]</span>
                                        <strong>@otherPct%</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>
    }
</div>

