@section Scripts {
    <script>
        (function () {
            var loading = document.getElementById("aiInsightsLoading");
            var result = document.getElementById("aiInsightsResult");
            if (!loading || !result) return;

            var periodSelect = document.getElementById("periodSelect");

            function esc(s) {
                return s ? s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') : '';
            }

            function currentPeriod() {
                return periodSelect ? periodSelect.value : "30d";
            }

            function showPeriod(periods, period) {
                var p = periods && periods[period];
                loading.style.display = "none";
                result.style.display = "block";
                if (!p || (!p.insight && !p.action)) {
                    //result.innerHTML = "<em class='ai-empty-state'>Not enough data for this period.</em>";
                    result.innerHTML = "<em class='ai-empty-state'><@Localizer["notenoughperiod"].Value></em>";
                } else {
                    result.innerHTML =
                        '<div class="ai-insight-layout">' +
                            (p.insight ? '<p class="ai-insight-text">' + esc(p.insight) + '</p>' : '<span></span>') +
                            (p.action  ? '<div class="ai-action-row"><span class="ai-action-label">@Localizer["trythis"].Value</span><span class="ai-action-text">' + esc(p.action) + '</span></div>' : '') +
                        '</div>';
                }
            }

            function poll() {
                fetch(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(analysisEndpoint)))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.status === "ready") {
                            showPeriod(data.periods, currentPeriod());
                        } else if (data.status === "generating") {
                            setTimeout(poll, 3000);
                        } else if (data.status === "empty") {
                            loading.style.display = "none";
                        } else {
                            console.error("AI analysis error:", data.message);
                            console.error("@Localizer["analerror"].Value", data.message);
                            loading.style.display = "none";
                            result.style.display = "block";
                            //result.innerHTML = "<em class='ai-empty-state'>Insights temporarily unavailable.</em>";
                            result.innerHTML = "<em class='ai-empty-state'>@Localizer["analno"].Value</em>";
                        }
                    })
                    .catch(function (err) {
                        console.error("AI poll error:", err);
                        loading.style.display = "none";
                        result.style.display = "block";
                        //result.innerHTML = "<em class='ai-empty-state'>Insights temporarily unavailable.</em>";
                        result.innerHTML = "<em class='ai-empty-state'>@Localizer["analno"].Value</em>";
                    });
            }
            poll();
        })();
    </script>
}
