@model List<Hamburgerz.Models.RiskMeasurement>

@{
    ViewData["Title"] = "Analysis";

    var measurements = (Model ?? new List<Hamburgerz.Models.RiskMeasurement>())
        .OrderBy(x => x.TimeStamp)
        .ToList();

    var selectedPeriod = (Context.Request.Query["period"].ToString() ?? "").Trim().ToLowerInvariant();
    if (string.IsNullOrWhiteSpace(selectedPeriod))
    {
        selectedPeriod = "30d";
    }

    var now = DateTime.Now;

    DateTime? periodStart;
    switch (selectedPeriod)
    {
        case "7d":
            periodStart = now.AddDays(-7);
            break;
        case "30d":
            periodStart = now.AddDays(-30);
            break;
        case "3m":
            periodStart = now.AddMonths(-3);
            break;
        case "6m":
            periodStart = now.AddMonths(-6);
            break;
        case "1y":
            periodStart = now.AddYears(-1);
            break;
        case "all":
            periodStart = null;
            break;
        default:
            selectedPeriod = "30d";
            periodStart = now.AddDays(-30);
            break;
    }

    string periodLabel;
    switch (selectedPeriod)
    {
        case "7d":
            periodLabel = "Last 7 days";
            break;
        case "30d":
            periodLabel = "Last 30 days";
            break;
        case "3m":
            periodLabel = "Last 3 months";
            break;
        case "6m":
            periodLabel = "Last 6 months";
            break;
        case "1y":
            periodLabel = "Last year";
            break;
        case "all":
            periodLabel = "All time";
            break;
        default:
            periodLabel = "Last 30 days";
            break;
    }

    DateTime? previousPeriodStart;
    switch (selectedPeriod)
    {
        case "7d":
            previousPeriodStart = now.AddDays(-14);
            break;
        case "30d":
            previousPeriodStart = now.AddDays(-60);
            break;
        case "3m":
            previousPeriodStart = now.AddMonths(-6);
            break;
        case "6m":
            previousPeriodStart = now.AddYears(-1);
            break;
        case "1y":
            previousPeriodStart = now.AddYears(-2);
            break;
        case "all":
            previousPeriodStart = null;
            break;
        default:
            previousPeriodStart = now.AddDays(-60);
            break;
    }

    var filteredMeasurements = periodStart.HasValue
        ? measurements.Where(x => x.TimeStamp >= periodStart.Value).ToList()
        : measurements.ToList();

    var previousMeasurements = periodStart.HasValue && previousPeriodStart.HasValue
        ? measurements.Where(x => x.TimeStamp >= previousPeriodStart.Value && x.TimeStamp < periodStart.Value).ToList()
        : new List<Hamburgerz.Models.RiskMeasurement>();

    var totalCount = measurements.Count;
    var filteredCount = filteredMeasurements.Count;
    var latest = measurements.LastOrDefault();

    Func<string?, string> normalizeStress = value =>
    {
        var normalized = (value ?? string.Empty).Trim().ToLowerInvariant();

        if (normalized.Contains("auk") || normalized.Contains("high"))
        {
            return "high";
        }

        if (normalized.Contains("vid") || normalized.Contains("med"))
        {
            return "medium";
        }

        if (normalized.Contains("žem") || normalized.Contains("zem") || normalized.Contains("low"))
        {
            return "low";
        }

        return "unknown";
    };

    Func<Hamburgerz.Models.RiskMeasurement, bool> isStressed = item =>
    {
        var level = normalizeStress(item.StressLevel);
        return level == "medium" || level == "high";
    };

    var avgSleep = filteredCount > 0 ? filteredMeasurements.Average(x => x.SleepHours) : 0;
    var avgWork = filteredCount > 0 ? filteredMeasurements.Average(x => x.WorkHours) : 0;
    var avgProductivity = filteredCount > 0 ? filteredMeasurements.Average(x => x.ProductivityScore) : 0;
    var avgRisk = filteredCount > 0 ? filteredMeasurements.Average(x => x.BurnoutPercent) : 0;

    var stressedCount = filteredMeasurements.Count(isStressed);
    var highStressCount = filteredMeasurements.Count(x => normalizeStress(x.StressLevel) == "high");
    var mediumStressCount = filteredMeasurements.Count(x => normalizeStress(x.StressLevel) == "medium");
    var lowStressCount = filteredMeasurements.Count(x => normalizeStress(x.StressLevel) == "low");

    var stressedShare = filteredMeasurements.Any()
        ? (int)Math.Round(stressedCount * 100.0 / filteredMeasurements.Count)
        : 0;

    var highStressShare = filteredMeasurements.Any()
        ? (int)Math.Round(highStressCount * 100.0 / filteredMeasurements.Count)
        : 0;

    var mediumStressShare = filteredMeasurements.Any()
        ? (int)Math.Round(mediumStressCount * 100.0 / filteredMeasurements.Count)
        : 0;

    var lowStressShare = filteredMeasurements.Any()
        ? (int)Math.Round(lowStressCount * 100.0 / filteredMeasurements.Count)
        : 0;

    var shortSleepShare = filteredMeasurements.Any()
        ? (int)Math.Round(filteredMeasurements.Count(x => x.SleepHours < 6) * 100.0 / filteredMeasurements.Count)
        : 0;

    var overtimeShare = filteredMeasurements.Any()
        ? (int)Math.Round(filteredMeasurements.Count(x => x.WorkHours >= 9) * 100.0 / filteredMeasurements.Count)
        : 0;

    double? sleepDelta = filteredMeasurements.Any() && previousMeasurements.Any()
        ? filteredMeasurements.Average(x => x.SleepHours) - previousMeasurements.Average(x => x.SleepHours)
        : null;

    double? workDelta = filteredMeasurements.Any() && previousMeasurements.Any()
        ? filteredMeasurements.Average(x => x.WorkHours) - previousMeasurements.Average(x => x.WorkHours)
        : null;

    double? productivityDelta = filteredMeasurements.Any() && previousMeasurements.Any()
        ? filteredMeasurements.Average(x => x.ProductivityScore) - previousMeasurements.Average(x => x.ProductivityScore)
        : null;

    var recentTrend = filteredMeasurements
        .Skip(Math.Max(0, filteredCount - 7))
        .ToList();

    var maxRecentMetric = recentTrend.Any()
        ? Math.Max(10d, recentTrend.Max(x => Math.Max((double)x.SleepHours, (double)x.WorkHours)))
        : 10d;

    var monthlyTrend = filteredMeasurements
        .GroupBy(x => new DateTime(x.TimeStamp.Year, x.TimeStamp.Month, 1))
        .OrderBy(x => x.Key)
        .Select(group => new
        {
            Month = group.Key,
            Label = group.Key.ToString("MMM"),
            AvgSleep = group.Average(x => x.SleepHours),
            AvgWork = group.Average(x => x.WorkHours),
            Count = group.Count()
        })
        .ToList();

    var allLowRisk = filteredMeasurements.Any() && filteredMeasurements.All(x => x.RiskText == "Low");
    var windowAvgSleep = filteredMeasurements.Any() ? filteredMeasurements.Average(x => x.SleepHours) : 0;
    var windowAvgWork = filteredMeasurements.Any() ? filteredMeasurements.Average(x => x.WorkHours) : 0;

    var overviewText = filteredCount < 3
        ? "There is only a small amount of data so far, but this page is already ready for longer-term patterns."
        : allLowRisk
            ? "Risk is currently low across the selected period, so the more useful signal here is how sleep, work hours, and stress shift over time."
            : $"{periodLabel} shows {stressedShare}% stressed entries, with an average of {windowAvgSleep:0.0}h sleep and {windowAvgWork:0.0}h workdays.";
}

<div class="analysis-page">
    <div class="analysis-hero">
        <div>
            <h1 class="analysis-title">Analysis</h1>
            <p class="analysis-subtitle">Overview of your habits, stress patterns, and how they change over time.</p>
        </div>

        @if (latest != null)
        {
            <div class="hero-pills">
                <div class="hero-pill">@totalCount measurements</div>
                <div class="hero-pill">Latest: @latest.TimeStamp.ToString("yyyy-MM-dd")</div>

                <form method="get" asp-controller="Profile" asp-action="Analysis" class="period-selector-form">
                    <label for="periodSelect" class="sr-only">Select time range</label>
                    <div class="period-select-wrap">
                        <select id="periodSelect" name="period" class="period-select" onchange="this.form.submit()">
                            <option value="7d" selected="@(selectedPeriod == "7d")">Last 7 days</option>
                            <option value="30d" selected="@(selectedPeriod == "30d")">Last 30 days</option>
                            <option value="3m" selected="@(selectedPeriod == "3m")">Last 3 months</option>
                            <option value="6m" selected="@(selectedPeriod == "6m")">Last 6 months</option>
                            <option value="1y" selected="@(selectedPeriod == "1y")">Last year</option>
                            <option value="all" selected="@(selectedPeriod == "all")">All time</option>
                        </select>
                    </div>
                </form>
            </div>
        }
    </div>

    @if (!measurements.Any())
    {
        <div class="empty-state-card">
            <div class="empty-state-icon">+</div>
            <div>
                <h3>No measurements yet</h3>
                <p>You do not have any saved measurements. Add your first one to unlock long-term analysis.</p>
                <a asp-controller="Data" asp-action="DataEntry" class="primary-btn">Add first measurement</a>
            </div>
        </div>
    }
    else
    {
        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-label">Measurements in range</div>
                <div class="summary-value">@filteredCount</div>
                <div class="summary-note">@periodLabel</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Average sleep</div>
                <div class="summary-value">@avgSleep.ToString("0.0")h</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Average workday</div>
                <div class="summary-value">@avgWork.ToString("0.0")h</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Stressed share</div>
                <div class="summary-value">@stressedShare%</div>
                <div class="summary-note">@periodLabel</div>
            </div>
        </div>

        <div class="insight-banner">
            <div>
                <div class="section-kicker">Overview</div>
                <h2 class="section-title">What stands out in your data</h2>
                <p class="section-copy">@overviewText</p>
            </div>

            <div class="insight-badges">
                <div class="insight-badge">
                    <span>Avg productivity</span>
                    <strong>@avgProductivity.ToString("0")</strong>
                </div>

                <div class="insight-badge">
                    <span>Avg burnout score</span>
                    <strong>@Math.Round(avgRisk, 0)%</strong>
                </div>
            </div>
        </div>

        <div class="analysis-grid">
            <section class="panel panel-wide">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">Trend</div>
                        <h3 class="panel-title">Recent sleep vs work hours</h3>
                    </div>
                    <div class="panel-note">Last @recentTrend.Count saved measurements</div>
                </div>

                <div class="legend">
                    <span class="legend-item"><span class="legend-dot sleep"></span>Sleep</span>
                    <span class="legend-item"><span class="legend-dot work"></span>Work</span>
                </div>

                <div class="trend-chart">
                    @foreach (var point in recentTrend)
                    {
                        var sleepHeight = point.SleepHours <= 0
                            ? 0
                            : Math.Max(10, (int)Math.Round(point.SleepHours / maxRecentMetric * 100));

                        var workHeight = point.WorkHours <= 0
                            ? 0
                            : Math.Max(10, (int)Math.Round(point.WorkHours / maxRecentMetric * 100));

                        <div class="trend-group">
                            <div class="trend-bars">
                                <div class="trend-bar sleep-bar" style="height:@($"{sleepHeight}%")"></div>
                                <div class="trend-bar work-bar" style="height:@($"{workHeight}%")"></div>
                            </div>
                            <div class="trend-values">@point.SleepHours.ToString("0.0")h / @point.WorkHours.ToString("0.0")h</div>
                            <div class="trend-label">@point.TimeStamp.ToString("MM-dd")</div>
                        </div>
                    }
                </div>
            </section>

            <section class="panel">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">Stress</div>
                        <h3 class="panel-title">Stress mix</h3>
                    </div>
                    <div class="panel-note">@periodLabel</div>
                </div>

                <div class="mix-list">
                    <div class="mix-row">
                        <div class="mix-meta">
                            <span>Low stress</span>
                            <strong>@lowStressShare%</strong>
                        </div>
                        <div class="mix-track">
                            <div class="mix-fill low" style="width:@($"{lowStressShare}%")"></div>
                        </div>
                    </div>

                    <div class="mix-row">
                        <div class="mix-meta">
                            <span>Medium stress</span>
                            <strong>@mediumStressShare%</strong>
                        </div>
                        <div class="mix-track">
                            <div class="mix-fill medium" style="width:@($"{mediumStressShare}%")"></div>
                        </div>
                    </div>

                    <div class="mix-row">
                        <div class="mix-meta">
                            <span>High stress</span>
                            <strong>@highStressShare%</strong>
                        </div>
                        <div class="mix-track">
                            <div class="mix-fill high" style="width:@($"{highStressShare}%")"></div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="panel">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">Habits</div>
                        <h3 class="panel-title">Signals to watch</h3>
                    </div>
                    <div class="panel-note">@periodLabel</div>
                </div>

                <div class="signal-list">
                    <div class="signal-card">
                        <div class="signal-label">Under 6h sleep</div>
                        <div class="signal-value">@shortSleepShare%</div>
                    </div>

                    <div class="signal-card">
                        <div class="signal-label">9h+ workdays</div>
                        <div class="signal-value">@overtimeShare%</div>
                    </div>

                    <div class="signal-card">
                        <div class="signal-label">Sleep change</div>
                        <div class="signal-value">
                            @(sleepDelta.HasValue ? $"{sleepDelta.Value:+0.0;-0.0;0.0}h" : "Not enough data")
                        </div>
                    </div>

                    <div class="signal-card">
                        <div class="signal-label">Work change</div>
                        <div class="signal-value">
                            @(workDelta.HasValue ? $"{workDelta.Value:+0.0;-0.0;0.0}h" : "Not enough data")
                        </div>
                    </div>

                    <div class="signal-card">
                        <div class="signal-label">Productivity change</div>
                        <div class="signal-value">
                            @(productivityDelta.HasValue ? $"{productivityDelta.Value:+0;-0;0}" : "Not enough data")
                        </div>
                    </div>
                </div>
            </section>

            <section class="panel panel-wide" id="aiInsightsPanel">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">AI · Gemini</div>
                        <h3 class="panel-title">Period insights</h3>
                    </div>
                    <div class="panel-note ai-loading-state" id="aiInsightsLoading">
                        <span class="ai-loading-dot" aria-hidden="true"></span>
                        <span>Analyzing...</span>
                    </div>
                </div>
                <div id="aiInsightsResult" class="ai-insights-result" style="display:none;"></div>
            </section>

            <section class="panel panel-full">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">Timeline</div>
                        <h3 class="panel-title">Monthly time allocation overview</h3>
                    </div>
                    <div class="panel-note">Grouped by month in the selected period</div>
                </div>

                <div class="legend">
                    <span class="legend-item"><span class="legend-dot sleep"></span>Sleep</span>
                    <span class="legend-item"><span class="legend-dot work"></span>Work</span>
                    <span class="legend-item"><span class="legend-dot leisure"></span>Leisure</span>
                </div>

                <div class="month-list">
                    @foreach (var month in monthlyTrend)
                    {
                        var rawOther = Math.Max(0, 24 - month.AvgSleep - month.AvgWork);
                        var totalHours = month.AvgSleep + month.AvgWork + rawOther;
                        var sleepPct = totalHours > 0 ? (int)Math.Round(month.AvgSleep / totalHours * 100) : 0;
                        var workPct = totalHours > 0 ? (int)Math.Round(month.AvgWork / totalHours * 100) : 0;
                        var otherPct = Math.Max(0, 100 - sleepPct - workPct);

                        <div class="month-row">
                            <div class="month-label-block">
                                <div class="month-label">@month.Month.ToString("MMM yyyy")</div>
                                <div class="month-count">@month.Count measurements</div>
                            </div>

                            <div class="month-allocation">
                                <div class="allocation-bar">
                                    <div class="allocation-fill sleep-fill" style="width:@($"{sleepPct}%")"></div>
                                    <div class="allocation-fill work-fill" style="width:@($"{workPct}%")"></div>
                                    <div class="allocation-fill leisure-fill" style="width:@($"{otherPct}%")"></div>
                                </div>

                                <div class="month-share-row">
                                    <div class="month-share-item">
                                        <span class="month-share-dot sleep-fill"></span>
                                        <span>Sleep</span>
                                        <strong>@sleepPct%</strong>
                                    </div>

                                    <div class="month-share-item">
                                        <span class="month-share-dot work-fill"></span>
                                        <span>Work</span>
                                        <strong>@workPct%</strong>
                                    </div>

                                    <div class="month-share-item">
                                        <span class="month-share-dot leisure-fill"></span>
                                        <span>Leisure</span>
                                        <strong>@otherPct%</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>
    }
</div>

<style>
    .analysis-page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 32px 20px 48px;
    }

    .analysis-hero {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        margin-bottom: 28px;
    }

    .analysis-title {
        margin: 0 0 8px 0;
        font-size: 34px;
        font-weight: 800;
        color: var(--color-text);
    }

    .analysis-subtitle {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 15px;
        max-width: 680px;
    }

    .hero-pills {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
    }

    .hero-pill,
    .period-select {
        height: 38px;
        padding: 8px 12px;
        border-radius: 999px;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        font-size: 12px;
        font-weight: 700;
        color: var(--color-text-muted);
        white-space: nowrap;
        box-shadow: var(--shadow-sm);
    }

    .period-selector-form {
        margin: 0;
    }

    .period-select-wrap {
        position: relative;
    }

    .period-select-wrap::before,
    .period-select-wrap::after {
        content: "";
        position: absolute;
        right: 14px;
        pointer-events: none;
        opacity: 0.9;
    }

    .period-select-wrap::before {
        top: 11px;
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
        border-bottom: 6px solid var(--color-text-muted);
    }

    .period-select-wrap::after {
        top: 20px;
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
        border-top: 6px solid var(--color-text-muted);
    }

    .period-select {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        padding-right: 42px;
        cursor: pointer;
        min-width: 152px;
        color: var(--color-text);
        background-image: none;
    }

    .period-select:focus {
        outline: none;
        border-color: var(--color-primary);
        box-shadow: 0 0 0 0.2rem var(--focus-ring);
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 18px;
    }

    .summary-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 18px;
        padding: 18px;
        box-shadow: var(--shadow-sm);
    }

    .summary-label {
        font-size: 13px;
        color: var(--color-text-muted);
        margin-bottom: 8px;
    }

    .summary-value {
        font-size: 28px;
        font-weight: 800;
        color: var(--color-text);
    }

    .summary-note {
        margin-top: 6px;
        font-size: 12px;
        color: var(--color-text-muted);
    }

    .insight-banner {
        display: flex;
        justify-content: space-between;
        align-items: stretch;
        gap: 18px;
        padding: 22px;
        margin-bottom: 20px;
        border-radius: 24px;
        border: 1px solid var(--color-border);
        background:
            radial-gradient(circle at top right, rgba(var(--color-primary-rgb), 0.10), transparent 28%),
            linear-gradient(135deg, var(--color-surface) 0%, var(--color-bg) 100%);
        box-shadow: var(--shadow-md);
    }

    .section-kicker {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-primary);
        font-weight: 800;
        margin-bottom: 8px;
    }

    .section-title,
    .panel-title {
        margin: 0;
        color: var(--color-text);
        font-weight: 800;
    }

    .section-copy {
        margin: 10px 0 0 0;
        color: var(--color-text-muted);
        max-width: 720px;
        line-height: 1.6;
    }

    .insight-badges {
        display: grid;
        grid-template-columns: repeat(2, minmax(140px, 1fr));
        gap: 12px;
        min-width: 300px;
    }

    .insight-badge {
        padding: 16px;
        border-radius: 18px;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 8px;
    }

    .insight-badge span {
        font-size: 12px;
        color: var(--color-text-muted);
    }

    .insight-badge strong {
        font-size: 28px;
        color: var(--color-text);
        font-weight: 800;
    }

    .analysis-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 18px;
    }

    .panel {
        grid-column: span 4;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 22px;
        padding: 20px;
        box-shadow: var(--shadow-sm);
    }

    .panel-wide {
        grid-column: span 8;
    }

    .panel-full {
        grid-column: 1 / -1;
    }

    #aiInsightsPanel {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    #aiInsightsPanel .panel-header {
        margin-bottom: 12px;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 16px;
    }

    .panel-note {
        font-size: 12px;
        color: var(--color-text-muted);
        white-space: nowrap;
    }

    .legend {
        display: flex;
        gap: 14px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: var(--color-text-muted);
        font-weight: 700;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .legend-dot.sleep,
    .sleep-bar,
    .sleep-fill {
        background: var(--color-tertiary);
    }

    .legend-dot.work,
    .work-bar,
    .work-fill {
        background: var(--color-secondary);
    }

    .legend-dot.leisure,
    .leisure-fill {
        background: var(--color-primary);
    }

    .risk-fill {
        background: #22c55e;
    }

    .trend-chart {
        height: 260px;
        display: grid;
