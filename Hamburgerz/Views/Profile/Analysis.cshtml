                            <div class="mix-fill low" style="width:@($"{lowBurnoutShare}%")"></div>
                        </div>
                    </div>

                    <div class="mix-row">
                        <div class="mix-meta">
                            <span>@Localizer["riskMedium"]</span>
                            <strong>@medBurnoutShare%</strong>
                        </div>
                        <div class="mix-track">
                            <div class="mix-fill medium" style="width:@($"{medBurnoutShare}%")"></div>
                        </div>
                    </div>

